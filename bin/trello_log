#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "trello_client"
require_relative "estimate_points_lib"

options = { tests: [], screenshots: [] }
parser = OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: bin/trello_log "<title>" ["<summary>"] [options]
        --frontend TEXT       Frontend changes, rendered under a "## Frontend" heading
        --backend TEXT        Backend changes, rendered under a "## Backend" heading
        --test NAME:STATUS    Test suite result, repeatable (e.g. --test "rails test:pass")
        --screenshot PATH     Attach a screenshot/mockup file to the card, repeatable
        --points N            Fibonacci story points (#{TrelloClient::FIB_LABEL_COLORS.keys.join(', ')}), shown as a card label.
                               Omit this to have bin/estimate_points size the card automatically
                               (deterministic pre-filter, or a 3x self-consistency Claude score
                               with the axis breakdown posted as a comment on the card).
        --base-ref REF         Git ref the auto-estimator diffs against (default: HEAD~1 — the
                               previous commit; pass this explicitly if a push bundles more than
                               one commit, e.g. --base-ref origin/Main).
        --no-estimate          Skip automatic point estimation entirely (no label, no comment).
  BANNER
  opts.on("--frontend TEXT") { |v| options[:frontend] = v }
  opts.on("--backend TEXT") { |v| options[:backend] = v }
  opts.on("--test NAME:STATUS") { |v| options[:tests] << v }
  opts.on("--screenshot PATH") { |v| options[:screenshots] << v }
  opts.on("--points N") { |v| options[:points] = v }
  opts.on("--base-ref REF") { |v| options[:base_ref] = v }
  opts.on("--no-estimate") { options[:no_estimate] = true }
end
parser.parse!(ARGV)

title = ARGV[0]
abort parser.banner if title.nil? || title.empty?

if options[:points] && !TrelloClient::FIB_LABEL_COLORS.key?(options[:points])
  abort "Invalid --points #{options[:points]} (must be one of: #{TrelloClient::FIB_LABEL_COLORS.keys.join(', ')})"
end

summary = ARGV[1] || ""
list_name = ENV["TRELLO_LIST_NAME"]
auth = { key: ENV.fetch("TRELLO_API_KEY"), token: ENV.fetch("TRELLO_TOKEN") }

description = summary.dup
description << "\n\n## Frontend\n#{options[:frontend]}" if options[:frontend]
description << "\n\n## Backend\n#{options[:backend]}" if options[:backend]

# An explicit TRELLO_LIST_NAME still targets that list verbatim; the default
# is the current week's "Done - Week of ..." list (weeks run Monday–Sunday).
list = if list_name
  TrelloClient.find_or_create_list(list_name, auth)
else
  TrelloClient.find_or_create_weekly_done_list(Time.now.utc.to_date, auth)
end

card_params = auth.merge(idList: list["id"], name: title, desc: description)
# A manual --points still wins outright — set the label at creation time,
# same as before, and skip the auto-estimator entirely below.
card_params[:idLabels] = TrelloClient.points_label_id(options[:points], auth) if options[:points]

card = TrelloClient.request(:post, "/cards", card_params)

unless options[:tests].empty?
  checklist = TrelloClient.request(:post, "/checklists", auth.merge(idCard: card["id"], name: "Tests"))
  options[:tests].each do |entry|
    name, status = entry.split(":", 2)
    abort "Malformed --test entry (expected NAME:STATUS): #{entry}" if status.nil?

    TrelloClient.request(:post, "/checklists/#{checklist['id']}/checkItems",
                          auth.merge(name: name, checked: status.casecmp?("pass")))
  end
end

options[:screenshots].each { |path| TrelloClient.attach(card["id"], path, auth) }

puts "Logged to Trello: #{card['shortUrl']}"

if options[:points]
  puts "Points: #{options[:points]} (manual)"
elsif options[:no_estimate]
  puts "Points: skipped (--no-estimate)"
else
  begin
    base_ref = options[:base_ref] || "HEAD~1"
    outcome = StoryPointEstimator.run(base_ref: base_ref, card_id: card["id"], auth: auth)
    case outcome["result"]["status"]
    when "auto", "auto_median"
      qualifier = outcome["result"]["status"] == "auto_median" ? " (median of a 1-step split — see the card comment)" : ""
      puts "Points: #{outcome['result']['points']}#{qualifier} [#{outcome['method']}]"
    when "flagged"
      puts "Points: NOT auto-assigned — the 3 scoring attempts disagreed by " \
           "#{outcome['result']['disagreement_steps']} Fibonacci steps. Flagged on the card for manual review."
    end
  rescue => e
    # Best-effort, same philosophy as the rest of this script: a broken
    # estimator (missing key, network blip, API error) must never make an
    # otherwise-successful card log look like it failed.
    warn "[trello_log] Automatic point estimation failed (card was still logged): #{e.class}: #{e.message}"
  end
end
