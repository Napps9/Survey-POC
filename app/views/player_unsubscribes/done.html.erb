<div class="you-page">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <div class="you-shell you-shell-narrow">
    <div class="you-mark"><%= image_tag "playverto.svg", alt: "Playverto", width: 120 %></div>
    <div class="you-card">
      <h1 class="you-h1"><%= t("player_unsubscribe.done_title") %></h1>
      <p class="you-sub">
        <%= @done == "all" ? t("player_unsubscribe.done_all") :
              t("player_unsubscribe.done_org", org: @notification.organisation.name) %>
      </p>
      <%= link_to t("player_unsubscribe.done_cta"), you_path, class: "you-btn" %>
    </div>
  </div>
</div>
