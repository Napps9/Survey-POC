<% content_for :title, t("partnership_accounts.title", partnership: @partnership.name) %>

<div style="position:relative;overflow:hidden;min-height:100vh;background:#1C2034;display:flex;align-items:center;justify-content:center;padding:24px;">
  <div class="gen-orbs" style="opacity:0.25;">
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
  </div>

  <div style="position:relative;z-index:1;width:100%;max-width:460px;">

    <%= link_to partnership_path(@partnership),
          style: "display:inline-flex;align-items:center;gap:6px;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);text-decoration:none;margin-bottom:18px;" do %>
      <span style="opacity:0.7;">←</span> <%= t("partnership_accounts.back_to_partnership", partnership: @partnership.name) %>
    <% end %>

    <div style="text-align:center;margin-bottom:32px;">
      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;">
        <span style="width:8px;height:8px;border-radius:50%;background:#01EACB;box-shadow:0 0 12px rgba(1,234,203,0.7);"></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);letter-spacing:0.12em;text-transform:uppercase;"><%= t("partnerships.picker_eyebrow") %></span>
      </div>
      <h1 style="font-family:'Alata',sans-serif;font-size: var(--text-3xl);color:#F7F7F7;margin:0 0 6px;"><%= t("partnership_accounts.heading") %></h1>
      <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.45);margin:0;">
        <%= t("partnership_accounts.subtitle", partnership: @partnership.name) %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="alert-error">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: partnership_partnership_accounts_path(@partnership),
                  method: :post, data: { turbo: false } do |f| %>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-family:'Alata',sans-serif;font-size: var(--text-base);letter-spacing:0.08em;color:rgba(247,247,247,0.6);margin-bottom:8px;text-transform:uppercase;"><%= t("partnership_accounts.name_label") %></label>
        <%= f.text_field :name,
              required: true, autofocus: true, placeholder: t("partnership_accounts.name_placeholder"),
              value: params[:name],
              class: "form-input" %>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-family:'Alata',sans-serif;font-size: var(--text-base);letter-spacing:0.08em;color:rgba(247,247,247,0.6);margin-bottom:8px;text-transform:uppercase;"><%= t("partnership_accounts.email_label") %></label>
        <%= f.email_field :email_address,
              required: true, placeholder: t("partnership_accounts.email_placeholder"),
              value: params[:email_address],
              class: "form-input" %>
      </div>

      <div style="margin-bottom:32px;">
        <label style="display:block;font-family:'Alata',sans-serif;font-size: var(--text-base);letter-spacing:0.08em;color:rgba(247,247,247,0.6);margin-bottom:8px;text-transform:uppercase;"><%= t("partnership_accounts.org_label") %></label>
        <%= f.text_field :organisation_name,
              required: true, placeholder: t("partnership_accounts.org_placeholder"),
              value: params[:organisation_name],
              class: "form-input" %>
      </div>

      <div style="display:flex;gap:10px;">
        <%= link_to t("partnership_accounts.cancel"), partnership_path(@partnership),
              style: "flex:0 0 auto;background:none;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:12px 22px;color:rgba(255,255,255,0.7);font-family:'Alata',sans-serif;font-size: var(--text-md);text-decoration:none;text-align:center;" %>
        <%= f.submit t("partnership_accounts.submit"),
              style: "flex:1;background:#01EACB;border:none;border-radius:8px;padding:14px;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.05em;cursor:pointer;" %>
      </div>

    <% end %>
  </div>
</div>
