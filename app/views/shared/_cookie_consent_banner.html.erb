<%# Shown on first visit, everywhere (dashboard, auth pages, and the public
    /play/:token player) — see app/javascript/controllers/cookie_consent_controller.js
    for the gating logic. Hidden by default; the controller reveals it only
    when no consent cookie exists yet, and shows it once at most per browser. %>
<div class="cookie-consent-banner hidden"
     data-controller="cookie-consent"
     data-cookie-consent-clarity-id-value="wyq1mb82dv">
  <div class="cookie-consent-panel" data-cookie-consent-target="banner">
    <p class="cookie-consent-text">
      <%= t("cookie_consent.banner_text_html", privacy_url: privacy_path, cookie_url: cookie_policy_path) %>
    </p>
    <div class="cookie-consent-actions">
      <button type="button" class="cookie-consent-link-btn"
              data-action="click->cookie-consent#openSettings"><%= t("cookie_consent.manage_preferences") %></button>
      <button type="button" class="cookie-consent-btn-secondary"
              data-action="click->cookie-consent#rejectAll"><%= t("cookie_consent.reject_all") %></button>
      <button type="button" class="cookie-consent-btn-primary"
              data-action="click->cookie-consent#acceptAll"><%= t("cookie_consent.accept_all") %></button>
    </div>
  </div>

  <div class="cookie-consent-panel hidden" data-cookie-consent-target="settings">
    <div class="cookie-consent-category">
      <div>
        <p class="cookie-consent-category-title"><%= t("cookie_consent.necessary_title") %></p>
        <p class="cookie-consent-category-desc"><%= t("cookie_consent.necessary_description") %></p>
      </div>
      <input type="checkbox" class="cookie-consent-toggle" checked disabled aria-label="<%= t('cookie_consent.necessary_title') %>">
    </div>
    <div class="cookie-consent-category">
      <div>
        <p class="cookie-consent-category-title"><%= t("cookie_consent.analytics_title") %></p>
        <p class="cookie-consent-category-desc"><%= t("cookie_consent.analytics_description") %></p>
      </div>
      <input type="checkbox" class="cookie-consent-toggle"
             data-cookie-consent-target="analyticsToggle"
             aria-label="<%= t('cookie_consent.analytics_title') %>">
    </div>
    <div class="cookie-consent-actions" style="margin-top:14px;">
      <button type="button" class="cookie-consent-link-btn"
              data-action="click->cookie-consent#backToBanner"><%= t("cookie_consent.back") %></button>
      <button type="button" class="cookie-consent-btn-primary"
              data-action="click->cookie-consent#savePreferences"><%= t("cookie_consent.save_preferences") %></button>
    </div>
  </div>
</div>
