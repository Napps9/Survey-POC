<%# The per-card answer-branching controls. Authored inside the card but
    relocated by type_panel_controller into the right-hand "Branching" panel for
    the selected card; CSS hides it while it still sits in the card (see
    application.css `.survey-card-wrap .logic-branch-block`). Editor-only chrome.
    `rows` is [{ canonical:, label:, selected: }]; `default_selected` is the
    encoded "otherwise" route ("card:<cid>" | "end:<id>" | ""); `hint` is an
    optional line explaining the type's match semantics (multi-pick /
    prioritise). %>
<div class="logic-branch-block" data-logic-block data-owner-cid="<%= owner_cid %>">
  <div class="logic-branch-intro">
    Send each answer to a different card or finish screen. Leave one on
    “Continue” to follow the normal flow.
    <% if local_assigns[:hint].present? %>
      <span class="logic-branch-hint"><%= local_assigns[:hint] %></span>
    <% end %>
  </div>
  <ul class="logic-branch-list">
    <% Array(rows).each do |row| %>
      <li class="logic-branch-row">
        <span class="logic-branch-answer"><%= row[:label] %></span>
        <span class="logic-branch-arrow" aria-hidden="true">→</span>
        <%= render "shared/logic_route_select", canonical: row[:canonical], selected: row[:selected] %>
      </li>
    <% end %>
  </ul>
  <div class="logic-default-row">
    <span class="logic-default-label">If no answer above matches, go to</span>
    <%= render "shared/logic_route_select", canonical: nil, selected: default_selected %>
  </div>
</div>
