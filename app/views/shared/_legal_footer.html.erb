<footer class="legal-footer">
  <%= link_to t("legal.footer_privacy"), privacy_path %>
  <span aria-hidden="true">·</span>
  <%= link_to t("legal.footer_terms"), terms_path %>
  <span aria-hidden="true">·</span>
  <%= link_to t("legal.footer_cookie_policy"), cookie_policy_path %>
  <span aria-hidden="true">·</span>
  <button type="button" onclick="window.dispatchEvent(new CustomEvent('cookie-consent:reopen'))">
    <%= t("legal.footer_cookie_settings") %>
  </button>
</footer>
