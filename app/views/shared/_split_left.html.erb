<%# Card left panel — shared by editor (surveys/show), preview
    (surveys/_preview_card), and player (player/_play_card).

    Locals:
      card     — the card hash
      progress — integer 0–100
      mode     — :editor, :preview, or :player (default: :preview)
%>
<%
  mode      ||= :preview
  editable   = (mode == :editor)
  has_lottie = card["lottie"].present?
  has_video  = card["video"].present?
  has_img    = card["image"].present?
  has_media  = has_video || has_img
  credit_word = has_video ? "Video by" : "Photo by"
  animate_asset = card["animate_asset"] == true
%>

<%# The animation backdrop (card["media_bg"]) paints only where an animation
    fills the panel; a photo or video covers .split-left itself, so there would
    be nothing to see. Falls through to the Verto-wide --brand-panel when the
    card hasn't set one. %>
<div class="split-left<%= " has-asset-breathe" if animate_asset %>" style="<%= card_media_bg_style(card) %>">
  <% if card["type"].to_s == "range" %>
    <%# Range: the LEFT panel plays a Lottie animation that swaps to match the
        slider position. The lottie-player controller listens for the
        `verto:scaleValue` event dispatched by the range slider on the right.
        No initial_value — the helper defaults to the neutral middle frame, so
        the character starts expressionless (see NpsHelper::NPS_NEUTRAL_FRAME). %>
    <%= render_nps_reaction(theme: range_theme_slug(card)) %>
  <% elsif has_lottie %>
    <%# A pasted LottieFiles animation, stored same-origin by CardLottieStore
        and played on a loop. Its own class (card-lottie, not nps-lottie): the
        :has(.nps-lottie) CSS hides the Change-media CTA, which this keeps. %>
    <div class="card-lottie"<%= " data-card-media".html_safe if editable %>
         data-controller="lottie-player"
         data-lottie-player-urls-value="<%= [ card["lottie"] ].to_json %>"
         data-lottie-player-current-value="1"
         data-lottie-player-loop-value="true">
      <div class="card-lottie-mount" data-lottie-player-target="mount"></div>
    </div>
  <% elsif has_media %>
    <% if has_video %>
      <%# Autoplaying, looped, muted card video. preload="none" + poster keeps
          off-screen cards at zero bytes; the autoplay-video controller plays
          only while the card is on screen and pauses otherwise. %>
      <video class="split-left-video"<%= " data-card-media".html_safe if editable %>
             muted loop playsinline autoplay preload="none"
             data-controller="autoplay-video"
             <% if card["video_poster"].present? %>poster="<%= card["video_poster"] %>"<% end %>>
        <source src="<%= card["video"] %>" type="video/mp4">
      </video>
    <% else %>
      <%# --focal-y only bites where the frame crops vertically — the mobile
          header strip — so desktop is unaffected by it. %>
      <div class="split-left-img"<%= " data-card-media".html_safe if editable %>
           data-controller="bg-image-healer"
           style="background-image:url('<%= card["image"] %>'); --focal-y: <%= card_focal_y(card) %>%;"></div>
    <% end %>
    <div class="split-left-overlay"<%= " data-card-media".html_safe if editable %>></div>
    <%# Subtle creator credit (Pexels picks). Doubles as the link back to
        Pexels the API guidelines ask for. %>
    <% if card["image_credit"].present? %>
      <div class="split-left-credit"<%= " data-card-media".html_safe if editable %>>
        <% if card["image_credit_url"].present? %>
          <a href="<%= card["image_credit_url"] %>" target="_blank" rel="noopener nofollow"><%= credit_word %> <%= card["image_credit"] %></a>
        <% else %>
          <%= credit_word %> <%= card["image_credit"] %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="panel-progress">
    <div class="panel-progress-fill" style="width:<%= progress %>%;"></div>
  </div>

  <%# Editor: prompt the creator to add design (an image). The button stays in
      the DOM for every editor-mode card — including NPS — so type-switching
      in the editor (e.g. range → NPS → range) finds it ready to reappear.
      CSS hides it while a Lottie is mounted (.split-left:has(.nps-lottie) …). %>
  <% if editable %>
    <% if card["type"].to_s == "range" %>
      <%# Range cards play a Lottie instead of an image — give the animation its
          own "change" CTA (the animation counterpart of the media picker), on
          the panel like every other asset's. A distinct class so the
          .split-left:has(.nps-lottie) rule that hides the image chrome leaves
          this one visible. A second CTA opens the ordinary media picker for
          this card's Animation background (media-picker#open already shows
          that section for a range card — _cardAnimates just checks the card
          type — the only gap was nothing on this panel ever calling it). %>
      <div class="split-left-cta-row">
        <button type="button" class="add-animation-fab"
                data-action="click->animation-picker#open"
                title="<%= t("editor.change_animation_title", default: "Change this card's animation") %>">
          <span class="add-animation-fab-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="3"></rect>
              <path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"></path>
            </svg>
          </span>
          <span><%= t("editor.change_animation", default: "Change animation") %></span>
        </button>
        <button type="button" class="add-bg-fab"
                data-action="click->media-picker#open"
                title="<%= t("editor.change_background_title", default: "Customise this card's background colour or image") %>">
          <span><%= t("editor.change_background", default: "Background") %></span>
        </button>
      </div>
    <% elsif has_lottie %>
      <%# A Lottie is the one medium that can be TRANSPARENT, so what sits
          behind it is a real design decision rather than nothing — and this
          panel offered no way to make it ("I need the Change Background
          option here for when we upload transparent lottie files"). Only the
          entry point was missing: media-picker#_cardAnimates already returns
          true for any card carrying a lottie, not just for range, so the
          Animation background section has been in that modal all along with
          nothing on this panel calling it.
          Scoped to lotties deliberately. A photo or a video is opaque; a
          background behind one is a control that does nothing. %>
      <div class="split-left-cta-row">
        <button type="button" class="add-media-fab"
                data-action="click->media-picker#open"
                title="<%= t("editor.change_media_title") %>">
          <span class="add-media-fab-plus">＋</span>
          <span><%= t("editor.change_media") %></span>
        </button>
        <button type="button" class="add-bg-fab"
                data-action="click->media-picker#open"
                title="<%= t("editor.change_background_title", default: "Customise this card's background colour or image") %>">
          <span><%= t("editor.change_background", default: "Background") %></span>
        </button>
      </div>
    <% elsif has_media %>
      <button type="button" class="add-media-fab"
              data-action="click->media-picker#open"
              title="<%= t("editor.change_media_title") %>">
        <span class="add-media-fab-plus">＋</span>
        <span><%= t("editor.change_media") %></span>
      </button>
    <% else %>
      <button type="button" class="split-left-design-prompt"
              data-action="click->media-picker#open"
              title="<%= t("editor.add_design_title") %>">
        <span class="split-left-design-prompt-icon">＋</span>
        <span class="split-left-design-prompt-title"><%= t("editor.add_design") %></span>
        <span class="split-left-design-prompt-sub"><%= t("editor.add_design_sub") %></span>
      </button>
    <% end %>
  <% end %>
</div>
