<%# Card right-panel renderer — shared by editor (surveys/show),
    preview (surveys/_preview_card), and player (player/_play_card).

    Locals:
      card — the card hash (must respond to `[]` for "type", "options", etc.)
      mode — :editor, :preview, or :player (default: :preview)

    The :editor mode adds inline edit chrome: contenteditable text,
    "card-editor" controller alongside "picker", per-option delete buttons,
    "Add option" / "Add statement" rows, and the tap-stack reset row. The
    other modes render the same widgets read-only.
%>
<%
  mode    ||= :preview
  editable = (mode == :editor)
  type     = card["type"].to_s
  render_type = type
  eyebrow  = CardTypes.eyebrow(type).presence || type.tr("_", " ")
  is_q     = type != "welcome_card"
  ce_attr  = editable ? "contenteditable=\"true\"".html_safe : "".html_safe

  # Quiz: in the editor, a quiz Verto lets the creator mark each question's
  # correct answer. `quiz` may arrive as a local (a freshly added card has no
  # @survey yet); otherwise fall back to the survey flag. Controls are hidden on
  # translation tabs by CSS, so a correct answer is only ever set in the primary
  # language it's stored against.
  quiz_on      = local_assigns.key?(:quiz) ? local_assigns[:quiz] : @survey&.quiz?
  quiz_mode    = editable && is_q && !!quiz_on
  correct_vals = Array(card["correct"]).map(&:to_s)
  correct_map  = card["correct"].is_a?(Hash) ? card["correct"] : {}
  mark_correct = ->(label) { correct_vals.include?(label.to_s) }

  # Picker-style lists carry an extra card-editor controller in :editor
  # mode so the per-card "delete option" / "add option" actions resolve.
  picker_controllers = editable ? "picker card-editor" : "picker"

  # Language: `display` holds the text/options for the locale being shown
  # (falls back to primary); `canon` holds the PRIMARY option labels, which is
  # what answers are stored against so results align across languages. The
  # editor always renders the primary card; the player passes the chosen locale.
  locale         ||= nil
  default_locale ||= SupportedLocales::DEFAULT
  display          = localized_card(card, locale, default_locale)
  canon            = Array(card["options"])
  # Card CONTENT follows the card's own language (the passed locale, else the
  # Verto's primary) — never the platform/UI locale, so a card never mixes
  # languages (e.g. an English question with Spanish Yes/No).
  display_locale   = (locale.presence || default_locale).to_s
%>

<div class="split-right">

  <%# Creator's logo, centred at the top of the right (content) panel on the
      welcome card — player only, and only when a logo is actually uploaded. %>
  <% if mode == :player && type == "welcome_card" && @survey&.organisation&.logo&.attached? %>
    <div class="split-right-logo">
      <%= brand_logo_tag @survey.organisation, style: "height:34px;width:auto;max-width:60%;display:block;" %>
    </div>
  <% end %>

  <%# Question heading group — wrapped so the player mobile theme can drop
      a single white panel behind the eyebrow + title + subtitle when a
      themed mobile background is in play. %>
  <div class="q-header">
    <% if is_q %>
      <div class="q-eyebrow"><%= eyebrow %></div>
    <% end %>

    <div class="q-title" <%= ce_attr %>><%= display["text"] %></div>

    <% if display["description"].present? %>
      <div class="q-subtitle" <%= ce_attr %>><%= display["description"] %></div>
    <% end %>
  </div>

  <div class="mt-2"<%= " data-card-component".html_safe if editable %>>
    <% case render_type
       when "multiple_choice", "select_many" %>
      <% items = Array(display["options"]) %>
      <% multi = (type == "select_many") %>
      <ul class="choice-list"
          data-controller="<%= picker_controllers %>"
          data-picker-mode-value="<%= multi ? 'multi' : 'single' %>">
        <% items.each_with_index do |opt, i| %>
          <li class="choice-list-item pick-item"
              data-picker-target="item"
              data-action="click->picker#pick"
              data-canonical="<%= canon[i] %>"
              data-correct="<%= mark_correct.call(canon[i]) %>"
              data-selected="false">
            <div class="choice-list-tile choice-bg-<%= (i % 6) + 1 %>"><%= OptionIconLibrary.svg_for(canon[i]) %></div>
            <span class="pick-text choice-list-label" <%= ce_attr %>><%= opt %></span>
            <span class="choice-list-tick <%= multi ? 'pick-square' : 'pick-dot' %>">✓</span>
            <% if quiz_mode %>
              <button type="button" class="mark-correct" data-picker-mode="<%= multi ? 'multi' : 'single' %>"
                      data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
            <% end %>
            <% if editable %>
              <button type="button" class="pick-item-delete"
                      data-action="click->card-editor#deleteOption">×</button>
            <% end %>
          </li>
        <% end %>
        <% if editable %>
          <li class="pick-add-btn"
              data-action="click->card-editor#addPickOption"
              data-card-editor-add>
            <span>＋</span> <%= t("card.add_option") %>
          </li>
        <% end %>
      </ul>

    <% when "prioritise" %>
      <%# Drag-to-rank list: respondents arrange the options top (highest
          priority) to bottom. The stored answer is the ordered list of
          canonical labels. Reuses the pick-item list chrome (edit/add/delete)
          but a `prioritise` controller handles reordering; in the player the
          initial order is shuffled so the authored order isn't a default bias. %>
      <% items = Array(display["options"]) %>
      <ul class="choice-list prioritise-list"
          data-controller="<%= editable ? 'prioritise card-editor' : 'prioritise' %>"
          <%= 'data-prioritise-shuffle-value="true"'.html_safe if mode == :player %>>
        <% items.each_with_index do |opt, i| %>
          <li class="choice-list-item pick-item prioritise-item"
              data-prioritise-target="item"
              data-canonical="<%= canon[i] %>"
              data-action="pointerdown->prioritise#start">
            <span class="prioritise-rank" data-prioritise-target="rank"><%= i + 1 %></span>
            <div class="choice-list-tile choice-bg-<%= (i % 6) + 1 %>"></div>
            <span class="pick-text choice-list-label" <%= ce_attr %>><%= opt %></span>
            <span class="prioritise-grip" aria-hidden="true">⋮⋮</span>
            <% if editable %>
              <button type="button" class="pick-item-delete"
                      data-action="click->card-editor#deleteOption">×</button>
            <% end %>
          </li>
        <% end %>
        <% if editable %>
          <li class="pick-add-btn"
              data-action="click->card-editor#addPickOption"
              data-card-editor-add>
            <span>＋</span> <%= t("card.add_option") %>
          </li>
        <% end %>
      </ul>

    <% when "yes_no" %>
      <ul class="choice-list"
          data-controller="picker"
          data-picker-mode-value="single">
        <% [["Yes", 1], ["No", 4]].each do |canon_label, bg| %>
          <li class="choice-list-item pick-item"
              data-picker-target="item"
              data-action="click->picker#pick"
              data-canonical="<%= canon_label %>"
              data-correct="<%= mark_correct.call(canon_label) %>"
              data-selected="false">
            <div class="choice-list-tile choice-bg-<%= bg %>"></div>
            <span class="pick-text choice-list-label" <%= ce_attr %>><%= t("card.#{canon_label.downcase}", locale: display_locale, default: canon_label) %></span>
            <span class="choice-list-tick pick-dot">✓</span>
            <% if quiz_mode %>
              <button type="button" class="mark-correct" data-picker-mode="single"
                      data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
            <% end %>
          </li>
        <% end %>
      </ul>

    <% when "select_one_grid", "select_many_grid" %>
      <% opts = Array(display["options"]) %>
      <% cols = opts.size >= 5 ? 3 : 2 %>
      <% multi = (type == "select_many_grid") %>
      <ul class="choice-grid choice-grid-<%= cols %>"
          data-controller="picker"
          data-picker-mode-value="<%= multi ? 'multi' : 'single' %>">
        <% opts.each_with_index do |opt, i| %>
          <li class="choice-card"
              data-picker-target="item"
              data-action="click->picker#pick"
              data-canonical="<%= canon[i] %>"
              data-correct="<%= mark_correct.call(canon[i]) %>"
              data-selected="false">
            <div class="choice-card-bg choice-bg-<%= (i % 6) + 1 %>">
              <%= OptionIconLibrary.svg_for(canon[i]) %>
              <div class="choice-overlay"></div>
              <div class="choice-tick">✓</div>
              <% if quiz_mode %>
                <button type="button" class="mark-correct mark-correct-grid" data-picker-mode="<%= multi ? 'multi' : 'single' %>"
                        data-action="click->survey-editor#toggleCorrect" title="<%= t('card.mark_correct') %>">✓</button>
              <% end %>
            </div>
            <div class="choice-label" <%= ce_attr %>><%= opt %></div>
          </li>
        <% end %>
      </ul>

    <% when "tap_card" %>
      <% option_images = Array(card["option_images"]) %>
      <div class="rotate-wrap"
           data-controller="<%= editable ? 'tap-stack card-editor' : 'tap-stack' %>"
           data-action="tap-stack:reset->tap-stack#reset">
        <div class="rotate-card-stack">
          <% Array(display["options"]).each_with_index do |opt, i| %>
            <% img = option_images[i] %>
            <% bg_a = ['#d4edda','#d1ecf1','#fff3cd','#f8d7da','#e2d9f3'][i % 5] %>
            <% bg_b = ['#a8d5b5','#9fd5df','#ffd88a','#f5a8b0','#c3aee8'][i % 5] %>
            <% bg_style = img.present? ?
                 "background:#fff url('#{img}') center/cover no-repeat;" :
                 "background:linear-gradient(135deg,#{bg_a},#{bg_b});" %>
            <div class="rotate-card"
                 data-tap-stack-target="card"
                 data-canonical="<%= canon[i] %>">
              <div class="rotate-card-media" style="<%= bg_style %>"></div>
              <%# Statement sits in a dark band at the TOP of the card. %>
              <div class="rotate-card-statement"><span <%= ce_attr %>><%= opt %></span></div>
              <% if editable %>
                <button type="button" class="tap-card-delete"
                        data-action="click->card-editor#deleteOption">×</button>
              <% end %>
            </div>
          <% end %>

          <%# Controls live INSIDE the card: three responses (No swipe-left,
              Unsure swipe-up off the top, Yes swipe-right) over a bottom scrim,
              and the remaining-cards dots. The controller builds the dots. %>
          <div class="rotate-card-controls">
            <div class="rotate-actions rotate-actions-3">
              <div class="rotate-action">
                <button type="button" class="rotate-action-btn rotate-action-no"
                        data-action="click->tap-stack#pick"
                        data-tap-stack-direction="left"
                        aria-label="<%= t("card.swipe_no") %>">👎</button>
                <span class="rotate-action-label"><%= t("card.swipe_no") %></span>
              </div>
              <div class="rotate-action">
                <button type="button" class="rotate-action-btn rotate-action-unsure"
                        data-action="click->tap-stack#pick"
                        data-tap-stack-direction="up"
                        aria-label="<%= t("card.swipe_unsure", default: "Unsure") %>">☝</button>
                <span class="rotate-action-label"><%= t("card.swipe_unsure", default: "Unsure") %></span>
              </div>
              <div class="rotate-action">
                <button type="button" class="rotate-action-btn rotate-action-yes"
                        data-action="click->tap-stack#pick"
                        data-tap-stack-direction="right"
                        aria-label="<%= t("card.swipe_yes") %>">👍</button>
                <span class="rotate-action-label"><%= t("card.swipe_yes") %></span>
              </div>
            </div>
            <div class="rotate-dots" data-tap-stack-target="dots"></div>
          </div>
        </div>

        <div class="rotate-reset-row">
          <button type="button" class="rotate-reset-btn"
                  data-action="click->tap-stack#reset">↺ <%= t("card.reset") %></button>
        </div>
        <% if editable %>
          <button type="button" class="tap-add-btn"
                  data-action="click->card-editor#addTapOption">＋ <%= t("card.add_statement") %></button>
        <% end %>
      </div>

    <% when "range" %>
      <% labels = Array(display["options"]) %>
      <% n = [labels.size, 2].max %>
      <div class="slider-wrap"
           data-controller="slider"
           data-slider-steps-value="<%= n %>">
        <div class="slider-track-wrap">
          <div class="slider-track"
               data-slider-target="track"
               data-action="pointerdown->slider#start">
            <% n.times do |i| %>
              <div class="s-dot" data-slider-target="dot"
                   style="left:<%= (i.to_f / (n - 1) * 100).round(2) %>%"></div>
            <% end %>
            <div class="slider-thumb" data-slider-target="thumb" style="left:50%;">
              <div class="s-line"></div><div class="s-line"></div><div class="s-line"></div>
            </div>
          </div>
        </div>
        <div class="slider-labels">
          <% labels.each do |opt| %>
            <span class="slider-label-text" data-slider-target="label" <%= ce_attr %>><%= opt %></span>
          <% end %>
        </div>
      </div>

    <% when "nps" %>
      <%# NPS — a vertical "liquid container" the respondent drags to fill to
          their number. Defaults to the classic 0–10 (the reactive Lottie now
          lives on Range). Labels are editable and drive the step count, so a
          creator can keep 0–10, use a shorter 4/5-point scale, or swap in an
          agree/emotion range. The container silhouette is themed per Verto
          (nps_container_shape). column-reverse stacks index 0 at the bottom,
          matching the fill rising from the bottom. The stored answer is the
          0-indexed position. %>
      <% labels = Array(display["options"]).presence || nps_default_labels %>
      <% n = [labels.size, 2].max %>
      <div class="nps-slider"
           data-controller="nps-slider"
           data-nps-slider-steps-value="<%= n %>"
           data-nps-slider-axis-value="vertical"
           data-action="pointerdown->nps-slider#start keydown->nps-slider#key"
           tabindex="0" role="slider"
           aria-valuemin="0" aria-valuemax="<%= n - 1 %>">
        <div class="nps-slider-stage">
          <div class="slider-labels nps-slider-labels">
            <% labels.each do |opt| %>
              <span class="slider-label-text" data-nps-slider-target="label" <%= ce_attr %>><%= opt %></span>
            <% end %>
          </div>
          <%= render_nps_control(shape: nps_container_shape(@survey), steps: n) %>
        </div>
      </div>

    <% when "rating" %>
      <% labels    = Array(display["options"]) %>
      <% first_lbl = labels.first || "Poor" %>
      <% last_lbl  = labels.last  || "Excellent" %>
      <% icon      = rating_icon(@survey) %>
      <div class="rating-wrap rating-kind-<%= icon[:kind] %>" data-controller="rating">
        <div class="rating-stars">
          <% 5.times do |i| %>
            <span class="rating-star"
                  data-rating-target="star"
                  data-rating-index="<%= i %>"
                  data-rating-on="<%= icon[:on] %>"
                  data-rating-off="<%= icon[:off] %>"
                  data-action="click->rating#pick mouseover->rating#hover mouseout->rating#unhover"><%= icon[:off] %></span>
          <% end %>
        </div>
        <div class="rating-labels">
          <span class="rating-label" <%= ce_attr %>><%= first_lbl %></span>
          <span class="rating-label" <%= ce_attr %>><%= last_lbl %></span>
        </div>
      </div>

    <% when "open_ended" %>
      <% if card["input"] == "date" %>
        <%# Date-flavoured open question — a native picker instead of free text. %>
        <div class="freeform-wrap">
          <input type="date" class="freeform-date"
                 max="<%= Date.current.iso8601 %>"
                 aria-label="<%= card["text"] %>" />
        </div>
      <% elsif card["input"] == "month" %>
        <%# Month-flavoured open question (the "When were you born?" demographic)
            — month + year only, no day. Two plain numeric fields rather than a
            native <input type="month">: that control's inline segments are
            rendered by the browser/OS and can show a spelled-out month name
            (e.g. "May") instead of digits, which isn't universal across the
            app's 19 locales. Two digit-only fields read the same everywhere. %>
        <div class="freeform-wrap">
          <div class="freeform-monthyear" data-controller="month-year">
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2"
                   class="freeform-month" placeholder="02"
                   aria-label="<%= card["text"] %> — month"
                   data-month-year-target="month" />
            <span class="freeform-monthyear-sep">/</span>
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                   class="freeform-year" placeholder="1995"
                   aria-label="<%= card["text"] %> — year"
                   data-month-year-target="year" />
          </div>
          <div class="freeform-date-hint">MM / YYYY</div>
        </div>
      <% elsif card["input"] == "location" %>
        <%# Location-flavoured open question (the "Where do you live?"
            demographic) — satnav-style search-and-pick via OpenStreetMap
            Nominatim instead of free text, so location data groups reliably
            (structured city/region/country) instead of by whatever a
            respondent happened to type. This is the ONE universal source of
            a Verto's region data (see PlayerController#sync_region_from_answers!).
            See NominatimClient for the privacy note (never lat/long, never a
            raw address — only the resolved city/region/country is kept).
            The answer itself is a plain "CC|Label" string, read generically
            like any other open_ended card (see player_controller.js#_read). %>
        <div class="freeform-wrap">
          <div class="welcome-location-search" data-controller="location-search"
               <% if @survey.publish_token.present? %>
                 data-location-search-url-value="<%= player_location_search_url(@survey.publish_token) %>"
               <% end %>>
            <div class="location-search-input-wrap">
              <input type="text" autocomplete="off" maxlength="80" class="location-search-field"
                     placeholder="<%= t("player.region_search_placeholder") %>"
                     data-location-search-target="input"
                     data-action="input->location-search#search keydown->location-search#keydown" />
              <ul class="location-search-results" data-location-search-target="results" hidden></ul>
            </div>
            <input type="hidden" class="location-search-value" data-location-search-target="value" />
            <div class="location-search-selected" data-location-search-target="selected" hidden>
              <span data-location-search-target="selectedText"></span>
              <button type="button" class="location-search-change" data-action="click->location-search#change">
                <%= t("player.region_search_change") %>
              </button>
            </div>
            <div class="location-search-credit"><%= t("player.region_search_credit") %></div>
          </div>
        </div>
      <% else %>
        <div class="freeform-wrap"
             data-controller="freeform"
             data-freeform-max-value="200">
          <textarea class="freeform-textarea"
                    placeholder="<%= t("card.answer_placeholder") %>"
                    data-freeform-target="input"
                    data-action="input->freeform#update"></textarea>
          <div class="freeform-counter" data-freeform-target="counter">0/200 <%= t("card.characters") %></div>
        </div>
      <% end %>

    <% when "welcome_card" %>
      <%# Welcome card — in the player it hosts the intake (compare promise +
          region picker), moved here from the old top banners. %>
      <% if mode == :player %><%= render "player/welcome_intake" %><% end %>
    <% end %>
  </div>

  <%# Quiz: the correct-answer controls for this card. List/grid/yes-no mark the
      correct option(s) inline (above); here we cover swipe directions, scale /
      rating / open-text answers, and the per-card explanation. Hidden on
      translation tabs (CSS), so answers are only set in the primary language. %>
  <% if quiz_mode %>
    <div class="quiz-correct-block" data-quiz-block>
      <div class="quiz-correct-title"><span class="quiz-correct-star">★</span> <%= t("card.mark_correct") %></div>
      <div class="quiz-correct-hint">
        <%= t(case type
              when "open_ended"          then "card.accepted_answers_hint"
              when "range", "nps", "rating" then "card.correct_scale_hint"
              when "tap_card"            then "card.correct_tap_hint"
              else "card.correct_pick_hint" end) %>
      </div>

      <% case type
         when "tap_card" %>
        <% Array(display["options"]).each_with_index do |opt, i| %>
          <% dir = correct_map[canon[i]].to_s %>
          <div class="quiz-tap-row" data-statement="<%= canon[i] %>" data-correct-dir="<%= dir %>">
            <span class="quiz-tap-label"><%= opt %></span>
            <button type="button" class="quiz-tap-btn no<%= ' is-on' if dir == 'no' %>"
                    data-dir="no" data-action="click->survey-editor#toggleTapCorrect">✕</button>
            <button type="button" class="quiz-tap-btn yes<%= ' is-on' if dir == 'yes' %>"
                    data-dir="yes" data-action="click->survey-editor#toggleTapCorrect">✓</button>
          </div>
        <% end %>

      <% when "range", "nps" %>
        <%# Both store the 0-indexed scale position, so grade against the index. %>
        <% scale_labels = Array(display["options"]).presence || (type == "nps" ? nps_default_labels : %w[1 2 3 4 5]) %>
        <select class="quiz-correct-select" data-quiz-correct data-action="change->survey-editor#markDirty">
          <option value="">—</option>
          <% scale_labels.each_with_index do |lbl, i| %>
            <option value="<%= i %>" <%= "selected" if card["correct"].to_s == i.to_s %>><%= lbl %></option>
          <% end %>
        </select>

      <% when "rating" %>
        <select class="quiz-correct-select" data-quiz-correct data-action="change->survey-editor#markDirty">
          <option value="">—</option>
          <% (1..5).each do |n| %>
            <option value="<%= n %>" <%= "selected" if card["correct"].to_s == n.to_s %>><%= n %> ★</option>
          <% end %>
        </select>

      <% when "open_ended" %>
        <textarea class="quiz-correct-textarea" data-quiz-accepted rows="2"
                  data-controller="autogrow"
                  data-action="input->survey-editor#markDirty"
                  placeholder="<%= t('card.accepted_answers') %>"><%= Array(card["correct"]).join("\n") %></textarea>
      <% end %>

      <textarea class="quiz-correct-textarea quiz-explanation" data-quiz-explanation rows="2"
                data-controller="autogrow"
                data-action="input->survey-editor#markDirty"
                placeholder="<%= t('card.explanation_placeholder') %>"><%= card["explanation"] %></textarea>
    </div>
  <% end %>

  <%# "Other" free-text — a standalone answer the creator can toggle per card.
      Rendered for every question type (not welcome). In the editor it's always
      present (hidden on welcome) so the toggle survives a type switch. %>
  <% if editable || (is_q && card["allow_other"]) %>
    <div class="other-block" data-controller="other"<%= ' hidden'.html_safe if (editable && type == "welcome_card") %>>
      <% if editable %>
        <label class="other-edit-toggle">
          <input type="checkbox" data-action="change->survey-editor#toggleOther" <%= "checked" if card["allow_other"] %>>
          <span><%= t("card.allow_other") %></span>
        </label>
        <%# Required — when on, the player blocks Next until this card is
            answered. Persisted like allow_other (data-card-required on the wrap,
            serialised back into the card JSON). %>
        <label class="other-edit-toggle">
          <input type="checkbox" data-action="change->survey-editor#toggleRequired" <%= "checked" if card["required"] %>>
          <span><%= t("card.required") %></span>
        </label>
      <% end %>
      <div class="other-cta-wrap" data-other-target="wrap"<%= ' hidden'.html_safe unless card["allow_other"] %>>
        <button type="button" class="other-cta-btn" data-other-target="btn"
                data-action="click->other#toggle"<%= ' disabled'.html_safe if editable %>>＋ <%= t("card.other") %></button>
        <div class="other-panel" data-other-target="panel" hidden
             data-controller="freeform" data-freeform-max-value="200">
          <textarea class="freeform-textarea other-textarea"
                    placeholder="<%= t("card.other_placeholder") %>"
                    data-other-input
                    data-freeform-target="input"
                    data-action="input->freeform#update"></textarea>
          <div class="freeform-counter" data-freeform-target="counter">0/200 <%= t("card.characters") %></div>
        </div>
      </div>
    </div>
  <% end %>

</div>
