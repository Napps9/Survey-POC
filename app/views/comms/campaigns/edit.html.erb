<%# The Comms campaign builder — the Verto Editor's chrome and grammar
    applied to an email document. One editor-grid root: canvas left, panels
    right, glass-pill chrome floating over it. The same event bus idea as the
    survey editor: every edit funnels into comms-editor#markDirty (a bubbled
    `input`, or a controller's :changed event), which debounces one PATCH of
    the whole document. %>
<%
  doc      = @campaign.document
  settings = doc["settings"]
  editable = @campaign.editable?
%>
<div class="editor-grid <%= "is-panel-open" unless editable %>" data-editor-panel-target="grid"
     data-controller="comms-editor editor-panel device-frame media-picker rich-text emoji-picker"
     data-comms-editor-url-value="<%= comms_campaign_path(@campaign) %>"
     data-comms-editor-preview-url-value="<%= preview_comms_campaign_path(@campaign) %>"
     data-comms-editor-locked-value="<%= @campaign.editing_locked? %>"
     data-media-picker-moderate-url-value="<%= moderate_image_comms_campaign_path(@campaign) %>"
     data-media-picker-card-image-url-value="<%= image_comms_campaign_path(@campaign) %>"
     data-media-picker-pexsearch-url-value="<%= pexels_comms_campaign_path(@campaign) %>"
     data-media-picker-library-url-value="<%= current_membership&.admin? ? organisation_assets_path(current_organisation, format: :json) : "" %>"
     data-action="rich-text:changed->comms-editor#markDirty
                  media-picker:commsImage->comms-editor#applyImage
                  input->comms-editor#markDirty">

  <div class="editor-backdrop"></div>

  <% if flash[:notice] || flash[:alert] %>
    <div class="comms-flash <%= "comms-flash--alert" if flash[:alert] %>">
      <%= flash[:notice] || flash[:alert] %>
    </div>
  <% end %>

  <%# ── LEFT: the canvas column ─────────────────────────────────────────── %>
  <div class="flex-1 min-h-0 relative flex flex-col">

    <div class="editor-float-bar">
      <div class="editor-float-group">
        <%= link_to comms_path, class: "editor-leave-btn" do %>
          <svg class="editor-leave-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M9.5 3.5 5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="editor-leave-label"><%= t("comms.editor.back", default: "Comms") %></span>
        <% end %>
        <span class="editor-verto-title <%= "is-locked" unless editable %>"
              <%= "contenteditable=true" if editable %>
              data-comms-editor-target="title"
              data-action="<%= "input->comms-editor#renameCampaign:stop keydown.enter->comms-editor#commitRename blur->comms-editor#restoreRenameIfBlank" if editable %>"
              spellcheck="false"><%= @campaign.title %></span>
        <span class="editor-save-pill"><span data-comms-editor-target="status" class="text-xs text-smoke/60"><%= editable ? "Saved" : "Locked" %></span></span>
        <% if editable %>
          <button type="button" class="editor-undo-btn" disabled
                  data-comms-editor-target="undoBtn"
                  data-action="click->comms-editor#undo"
                  aria-keyshortcuts="Control+Z Meta+Z">
            <span class="editor-undo-label">Undo</span>
          </button>
        <% end %>
      </div>

      <div class="editor-float-group editor-float-pinned" style="display:flex;gap:8px;align-items:center;">
        <div class="device-toggle" role="group" aria-label="Preview device">
          <button type="button" class="device-toggle-btn comms-device-btn is-active" data-device="desktop"
                  data-device-frame-target="btn" data-action="click->device-frame#set" aria-pressed="true">Desktop</button>
          <button type="button" class="device-toggle-btn comms-device-btn" data-device="mobile"
                  data-device-frame-target="btn" data-action="click->device-frame#set" aria-pressed="false">Mobile</button>
        </div>
        <button type="button" class="editor-leave-btn" data-action="click->comms-editor#openPreview">
          <span class="editor-leave-label">▶ <%= t("comms.editor.preview", default: "Preview email") %></span>
        </button>
      </div>
    </div>

    <div class="editor-feed comms-feed device-desktop" data-device-frame-target="feed"
         style="flex:1;min-height:0;overflow-y:auto;padding:76px 16px 96px;">
      <div class="comms-canvas" data-comms-editor-target="canvas"
           style="background:<%= settings["backgroundColor"] %>;">
        <div class="comms-paper" data-comms-editor-target="paper"
             data-setting-background-color="<%= settings["backgroundColor"] %>"
             data-setting-content-background-color="<%= settings["contentBackgroundColor"] %>"
             data-setting-text-color="<%= settings["textColor"] %>"
             data-setting-link-color="<%= settings["linkColor"] %>"
             data-setting-font-family="<%= settings["fontFamily"] %>"
             data-setting-content-width="<%= settings["contentWidth"] %>"
             data-setting-heading-weight="<%= settings["headingWeight"] %>"
             data-setting-heading-transform="<%= settings["headingTransform"] %>"
             data-setting-heading-letter-spacing="<%= settings["headingLetterSpacing"] %>"
             data-setting-button-radius="<%= settings["buttonRadius"] %>"
             style="background:<%= settings["contentBackgroundColor"] %>;max-width:<%= settings["contentWidth"] %>px;font-family:<%= settings["fontFamily"] %>;">
          <% doc["blocks"].each do |block| %>
            <%= render "block_row", block: block, settings: settings, editable: editable %>
          <% end %>
          <% if editable %>
            <div class="comms-add-row" data-comms-editor-target="addRow">
              <button type="button" class="aq-trigger-btn comms-add-btn"
                      data-action="click->comms-editor#toggleAddMenu">＋ <%= t("comms.editor.add_block", default: "Add block") %></button>
              <div class="comms-add-menu" data-comms-editor-target="addMenu" hidden>
                <% Comms::EmailDocument::TYPES.each do |type| %>
                  <button type="button" data-action="click->comms-editor#addBlock"
                          data-type="<%= type %>"><%= type.capitalize %></button>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="comms-footer-note">
            <%= t("comms.editor.footer_note", default: "Footer with the unsubscribe link is added automatically — use Preview to see the real email.") %>
          </div>
        </div>
      </div>
    </div>

    <% if editable %>
      <div class="editor-float-bar editor-float-bottom">
        <div class="editor-float-group">
          <button type="button" class="editor-leave-btn" data-action="click->comms-editor#openDesign">
            <span class="editor-leave-label">🎨 <%= t("comms.editor.design", default: "Design") %></span>
          </button>
          <button type="button" class="editor-leave-btn" data-action="click->comms-editor#openAudience">
            <span class="editor-leave-label">👥 <%= t("comms.editor.audience", default: "Audience") %></span>
          </button>
          <button type="button" class="editor-leave-btn" data-action="click->comms-editor#openSend">
            <span class="editor-leave-label">🚀 <%= t("comms.editor.send", default: "Send") %></span>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── RIGHT: block inspector + design/audience/send takeovers, or the
      send-status panel once the campaign is past editing ─────────────── %>
  <div class="right-column">
    <% unless editable %>
      <div class="type-panel panel-paper panel--types"
           data-controller="comms-campaign-status"
           data-comms-campaign-status-url-value="<%= status_comms_campaign_path(@campaign) %>"
           data-comms-campaign-status-status-value="<%= @campaign.status %>">
        <div class="type-panel-top">
          <div style="font-family:'Alata',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.75);">
            <%= t("comms.editor.status_eyebrow", default: "Campaign status") %>
          </div>
          <div data-comms-campaign-status-target="state"
               style="font-family:'Alata',sans-serif;font-size:20px;color:#fff;text-transform:capitalize;"><%= @campaign.status %></div>
        </div>
        <div class="panel-island comms-controls">
          <% counts = @campaign.email_campaign_recipients.group(:status).count %>
          <div class="comms-count-card">
            <span class="comms-count-num"><%= @campaign.recipient_count %></span>
            <span class="comms-count-label"><%= t("comms.editor.recipients_label", default: "recipients") %></span>
          </div>
          <div data-comms-campaign-status-target="counts"
               style="font-family:'ABeeZee',sans-serif;font-size:12px;color:rgba(255,255,255,0.8);">
            <% if counts.any? %>
              <%= counts.map { |status, n| "#{status}: #{n}" }.join(" · ") %>
            <% end %>
          </div>
          <% if @campaign.sending? %>
            <%= button_to t("comms.editor.cancel_send", default: "Stop sending"), cancel_send_comms_campaign_path(@campaign),
                  method: :post, form: { data: { turbo: false } },
                  style: "background:#FF1E6F;color:#fff;font-family:'Alata',sans-serif;font-size:13px;border:none;border-radius:100px;padding:9px 18px;cursor:pointer;width:100%;" %>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="type-panel panel-paper panel--types" data-comms-editor-target="blockView" <%= "hidden" unless editable %>>
      <div class="type-panel-top">
        <div style="font-family:'Alata',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.75);">
          <%= t("comms.editor.block_eyebrow", default: "Selected block") %>
        </div>
        <div data-comms-editor-target="panelTitle"
             style="font-family:'Alata',sans-serif;font-size:18px;color:#fff;">—</div>
      </div>
      <div class="type-panel-empty" data-comms-editor-target="panelEmpty">
        ↖ <%= t("comms.editor.select_hint", default: "Select a block on the canvas to edit it") %>
      </div>

      <%# Generic inspector: one section per block type; inputs carry
          data-field and write straight back to the selected block. %>
      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="heading" hidden>
        <label>Level
          <select data-field="level" data-action="change->comms-editor#applyField">
            <option value="1">H1</option><option value="2">H2</option><option value="3">H3</option>
          </select>
        </label>
        <label>Align
          <select data-field="align" data-action="change->comms-editor#applyField">
            <option value="left">Left</option><option value="center">Center</option><option value="right">Right</option>
          </select>
        </label>
        <label>Color <input type="color" data-field="color" data-action="input->comms-editor#applyField"></label>
      </div>

      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="text" hidden>
        <label>Align
          <select data-field="align" data-action="change->comms-editor#applyField">
            <option value="left">Left</option><option value="center">Center</option><option value="right">Right</option>
          </select>
        </label>
        <label>Color <input type="color" data-field="color" data-action="input->comms-editor#applyField"></label>
      </div>

      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="button" hidden>
        <label>Link URL <input type="url" data-field="href" placeholder="https://…"
               data-action="input->comms-editor#applyField"></label>
        <label>Align
          <select data-field="align" data-action="change->comms-editor#applyField">
            <option value="left">Left</option><option value="center">Center</option><option value="right">Right</option>
          </select>
        </label>
        <label>Background <input type="color" data-field="backgroundColor" data-action="input->comms-editor#applyField"></label>
        <label>Text color <input type="color" data-field="textColor" data-action="input->comms-editor#applyField"></label>
        <label>Corners <input type="range" min="0" max="24" data-field="radius" data-action="input->comms-editor#applyField"></label>
      </div>

      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="image" hidden>
        <button type="button" class="media-btn-ghost" style="width:100%;margin-bottom:10px;"
                data-action="click->media-picker#openComms"><%= t("comms.editor.change_image", default: "Choose image…") %></button>
        <label>Alt text <input type="text" data-field="alt" data-action="input->comms-editor#applyField"></label>
        <label>Link URL <input type="url" data-field="href" placeholder="https://…"
               data-action="input->comms-editor#applyField"></label>
        <label>Width <input type="range" min="10" max="100" data-field="widthPct" data-action="input->comms-editor#applyField"></label>
        <label>Align
          <select data-field="align" data-action="change->comms-editor#applyField">
            <option value="left">Left</option><option value="center">Center</option><option value="right">Right</option>
          </select>
        </label>
      </div>

      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="divider" hidden>
        <label>Color <input type="color" data-field="color" data-action="input->comms-editor#applyField"></label>
      </div>

      <div class="panel-island comms-controls" data-comms-editor-target="controls" data-block-controls="spacer" hidden>
        <label>Height <input type="range" min="4" max="160" data-field="height" data-action="input->comms-editor#applyField"></label>
      </div>
    </div>

    <%# Design takeover: document-wide settings, brand-palette-controller
        grammar (live apply, saved by the same autosave PATCH). %>
    <div class="type-panel panel-paper panel--why" data-comms-editor-target="designView" hidden>
      <div class="type-panel-top">
        <button type="button" class="publish-panel-back" data-action="click->comms-editor#closeDesign">←
          <%= t("comms.editor.back_to_block", default: "Block") %></button>
        <div style="font-family:'Alata',sans-serif;font-size:18px;color:#fff;"><%= t("comms.editor.design", default: "Design") %></div>
      </div>
      <div class="panel-island comms-controls">
        <label>Page background <input type="color" data-setting="backgroundColor" data-action="input->comms-editor#applySetting"></label>
        <label>Card background <input type="color" data-setting="contentBackgroundColor" data-action="input->comms-editor#applySetting"></label>
        <label>Link color <input type="color" data-setting="linkColor" data-action="input->comms-editor#applySetting"></label>
        <label>Content width <input type="range" min="320" max="800" step="10" data-setting="contentWidth" data-action="input->comms-editor#applySetting"></label>
        <label>Font
          <select data-setting="fontFamily" data-action="change->comms-editor#applySetting">
            <option value="<%= Comms::EmailDocument::SYSTEM_FONT_STACK %>">System (safest)</option>
            <% Survey::BRAND_FONTS.each do |token, font| %>
              <option value="<%= font[:stack] %>"><%= font[:label] %></option>
            <% end %>
          </select>
        </label>
        <label>Heading weight
          <select data-setting="headingWeight" data-action="change->comms-editor#applySetting">
            <option value="400">Regular</option><option value="600">Semibold</option>
            <option value="700">Bold</option><option value="800">Heavy</option>
          </select>
        </label>
        <label>Heading style
          <select data-setting="headingTransform" data-action="change->comms-editor#applySetting">
            <option value="none">Normal</option><option value="uppercase">UPPERCASE</option>
          </select>
        </label>
        <label>Heading letter spacing <input type="range" min="-2" max="6" data-setting="headingLetterSpacing" data-action="input->comms-editor#applySetting"></label>
      </div>
    </div>

    <%# Audience takeover: who this campaign goes to. Its own controller —
        it PATCHes the audience slice itself (brand-palette shape) and keeps
        the live count fresh via the resolver-backed count endpoint. %>
    <% if editable %>
      <div class="type-panel panel-paper panel--tokens" data-comms-editor-target="audienceView" hidden
           data-controller="comms-audience"
           data-comms-audience-url-value="<%= comms_campaign_path(@campaign) %>"
           data-comms-audience-count-url-value="<%= audience_count_comms_campaign_path(@campaign) %>"
           data-comms-audience-definition-value="<%= (@campaign.audience.presence || { "kind" => "all_users" }).to_json %>">
        <div class="type-panel-top">
          <button type="button" class="publish-panel-back" data-action="click->comms-editor#closeAudience">←
            <%= t("comms.editor.back_to_block", default: "Block") %></button>
          <div style="font-family:'Alata',sans-serif;font-size:18px;color:#1C2034;"><%= t("comms.editor.audience", default: "Audience") %></div>
        </div>

        <div class="panel-island comms-controls">
          <div class="comms-count-card">
            <span class="comms-count-num" data-comms-audience-target="count">…</span>
            <span class="comms-count-label"><%= t("comms.editor.recipients", default: "recipients after unsubscribes & suppressions") %></span>
          </div>

          <label class="comms-kind-row"><input type="radio" name="audience_kind" value="all_users"
                 data-comms-audience-target="kind" data-action="change->comms-audience#changed">
            <%= t("comms.editor.all_users", default: "All platform users (verified)") %></label>

          <label class="comms-kind-row"><input type="radio" name="audience_kind" value="organisations"
                 data-comms-audience-target="kind" data-action="change->comms-audience#changed">
            <%= t("comms.editor.by_org", default: "Members of specific organisations") %></label>
          <div data-comms-audience-target="section" data-audience-section="organisations" hidden
               style="display:flex;flex-direction:column;gap:8px;">
            <select multiple size="6" data-comms-audience-target="orgSelect"
                    data-action="change->comms-audience#changed" style="width:100%;">
              <% @organisations.each do |org| %>
                <option value="<%= org.id %>"><%= org.name %></option>
              <% end %>
            </select>
            <label>Role
              <select data-comms-audience-target="roleSelect" data-action="change->comms-audience#changed">
                <option value="any">Everyone</option>
                <option value="admin">Admins only</option>
              </select>
            </label>
          </div>

          <label class="comms-kind-row"><input type="radio" name="audience_kind" value="users"
                 data-comms-audience-target="kind" data-action="change->comms-audience#changed">
            <%= t("comms.editor.picked_users", default: "Specific users (by email)") %></label>
          <div data-comms-audience-target="section" data-audience-section="users" hidden>
            <textarea rows="4" data-comms-audience-target="emailsInput"
                      data-action="input->comms-audience#changed"
                      placeholder="nick@playverto.com&#10;someone@example.org"
                      style="width:100%;font-family:monospace;font-size:12px;"></textarea>
          </div>

          <label class="comms-kind-row"><input type="radio" name="audience_kind" value="list"
                 data-comms-audience-target="kind" data-action="change->comms-audience#changed">
            <%= t("comms.editor.from_list", default: "An imported list") %></label>
          <div data-comms-audience-target="section" data-audience-section="list" hidden
               style="display:flex;flex-direction:column;gap:8px;">
            <select data-comms-audience-target="listSelect" data-action="change->comms-audience#changed" style="width:100%;">
              <option value=""><%= t("comms.editor.pick_list", default: "Pick a list…") %></option>
              <% @lists.each do |list| %>
                <option value="<%= list.id %>"><%= list.name %> (<%= list.contacts_count %>)</option>
              <% end %>
            </select>
            <a href="<%= comms_lists_path %>" target="_blank"
               style="font-family:'Alata',sans-serif;font-size:12px;color:#1C2034;text-decoration:underline;">
              <%= t("comms.editor.manage_lists", default: "Manage lists ↗") %></a>
          </div>
        </div>
      </div>

      <%# Send takeover: the publish panel's grammar — message fields, a
          test send, and the one-way door. %>
      <div class="type-panel panel-paper panel--logic" data-comms-editor-target="sendView" hidden
           data-controller="comms-send"
           data-comms-send-url-value="<%= comms_campaign_path(@campaign) %>">
        <div class="type-panel-top">
          <button type="button" class="publish-panel-back" data-action="click->comms-editor#closeSend">←
            <%= t("comms.editor.back_to_block", default: "Block") %></button>
          <div style="font-family:'Alata',sans-serif;font-size:18px;color:#fff;"><%= t("comms.editor.send", default: "Send") %></div>
        </div>
        <div class="publish-panel-body" style="overflow-y:auto;">
          <details class="publish-block" open>
            <summary class="publish-block-title"><%= t("comms.editor.message", default: "Message") %> <span class="pub-chev">▾</span></summary>
            <div class="comms-controls">
              <label style="flex-direction:column;align-items:stretch;gap:4px;">
                <span><%= t("comms.editor.subject", default: "Subject") %>
                  <button type="button" data-emoji-picker-trigger
                          data-action="click->emoji-picker#open"
                          style="background:none;border:none;cursor:pointer;font-size:14px;">😊</button>
                </span>
                <input type="text" data-comms-send-target="subject"
                       data-action="input->comms-send#changed"
                       value="<%= @campaign.subject %>" style="max-width:none;">
              </label>
              <label style="flex-direction:column;align-items:stretch;gap:4px;">
                <span><%= t("comms.editor.preheader", default: "Preheader (inbox snippet)") %></span>
                <input type="text" data-comms-send-target="preheader"
                       data-action="input->comms-send#changed"
                       value="<%= @campaign.preheader %>" style="max-width:none;">
              </label>
            </div>
          </details>

          <details class="publish-block">
            <summary class="publish-block-title"><%= t("comms.editor.sender", default: "Sender") %> <span class="pub-chev">▾</span></summary>
            <div class="comms-controls">
              <label style="flex-direction:column;align-items:stretch;gap:4px;">
                <span><%= t("comms.editor.from_name", default: "From name") %></span>
                <input type="text" data-comms-send-target="fromName"
                       data-action="input->comms-send#changed"
                       value="<%= @campaign.from_name %>" placeholder="Playverto" style="max-width:none;">
              </label>
              <label style="flex-direction:column;align-items:stretch;gap:4px;">
                <span><%= t("comms.editor.reply_to", default: "Reply-to") %></span>
                <input type="email" data-comms-send-target="replyTo"
                       data-action="input->comms-send#changed"
                       value="<%= @campaign.reply_to %>" placeholder="nick@playverto.com" style="max-width:none;">
              </label>
            </div>
          </details>

          <details class="publish-block">
            <summary class="publish-block-title"><%= t("comms.editor.test_send", default: "Send a test to me") %> <span class="pub-chev">▾</span></summary>
            <div class="comms-controls">
              <p style="font-family:'ABeeZee',sans-serif;font-size:12px;color:rgba(255,255,255,0.75);margin:0;">
                <%= t("comms.editor.test_send_hint", default: "Mails the current draft to %{email} with tracking stubbed.", email: Current.user.email_address) %>
              </p>
              <%= button_to t("comms.editor.test_send_cta", default: "Send test email"), test_send_comms_campaign_path(@campaign),
                    method: :post, form: { data: { turbo: false } },
                    style: "background:rgba(255,255,255,0.12);color:#fff;font-family:'Alata',sans-serif;font-size:13px;border:1px solid rgba(255,255,255,0.25);border-radius:100px;padding:9px 18px;cursor:pointer;width:100%;" %>
            </div>
          </details>

          <details class="publish-block" open>
            <summary class="publish-block-title"><%= t("comms.editor.send_now", default: "Send now") %> <span class="pub-chev">▾</span></summary>
            <div class="comms-controls">
              <p style="font-family:'ABeeZee',sans-serif;font-size:12px;color:rgba(255,255,255,0.75);margin:0;">
                <%= t("comms.editor.send_now_hint", default: "Freezes the email exactly as approved and starts delivery. Edits after this land on the next campaign, not this one.") %>
              </p>
              <%= button_to t("comms.editor.send_now_cta", default: "Send to the audience now"), send_now_comms_campaign_path(@campaign),
                    method: :post,
                    form: { data: { turbo_confirm: t("comms.editor.send_confirm", default: "Send this campaign now?") } },
                    style: "background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size:14px;border:none;border-radius:100px;padding:11px 18px;cursor:pointer;width:100%;" %>
            </div>
          </details>
        </div>
      </div>
    <% end %>
  </div>

<% if editable %>
<%# Block templates for client-side insertion — the same partial the server
    renders, so added blocks are byte-identical to loaded ones. %>
<% brand = @playverto_brand %>
<% Comms::EmailDocument::TYPES.each do |type| %>
  <template data-comms-template="<%= type %>">
    <%= render "block_row", block: Comms::EmailDocument.create_block(type, brand: brand),
                            settings: settings, editable: true %>
  </template>
<% end %>

<%# Floating rich-text toolbar — the survey editor's, plus Link (email only). %>
<div class="rich-text-toolbar" data-rich-text-target="toolbar" hidden>
  <button type="button" data-rich-text-target="boldBtn"
          data-action="click->rich-text#bold" title="<%= t("js.editor.rich_bold") %>"><b>B</b></button>
  <button type="button" data-rich-text-target="italicBtn"
          data-action="click->rich-text#italic" title="<%= t("js.editor.rich_italic") %>"><i>I</i></button>
  <button type="button" data-rich-text-target="underlineBtn"
          data-action="click->rich-text#underline" title="<%= t("js.editor.rich_underline") %>"><u>U</u></button>
  <button type="button" data-rich-text-target="linkBtn"
          data-action="click->rich-text#link" title="<%= t("comms.editor.rich_link", default: "Link") %>">🔗</button>
  <select data-rich-text-target="fontSelect" data-action="change->rich-text#fontChanged"
          aria-label="<%= t("js.editor.rich_font") %>"></select>
  <select data-rich-text-target="sizeSelect" data-action="change->rich-text#sizeChanged"
          aria-label="<%= t("js.editor.rich_size") %>"></select>
</div>

<%# Emoji popover (subject field) — the survey editor's markup verbatim. %>
<div class="emoji-picker-popover" data-emoji-picker-target="popover" hidden
     role="dialog" aria-label="<%= t("editor.emoji_pick", default: "Choose an emoji") %>">
  <div class="emoji-picker-head">
    <input type="search" class="emoji-picker-search"
           data-emoji-picker-target="search"
           data-action="input->emoji-picker#onSearch"
           placeholder="<%= t("editor.emoji_search", default: "Search emoji…") %>"
           aria-label="<%= t("editor.emoji_search", default: "Search emoji…") %>" />
    <button type="button" class="emoji-picker-clear"
            data-action="click->emoji-picker#clear"><%= t("editor.emoji_clear", default: "Clear") %></button>
  </div>
  <div class="emoji-picker-tabs" data-emoji-picker-target="tabs"></div>
  <div class="emoji-picker-grid" data-emoji-picker-target="grid"></div>
</div>
<% end %>

<%# Compiled-artifact preview: the sandboxed iframe shows the real table-based
    email HTML, not the canvas — proving the compile. %>
<div class="comms-preview-overlay" data-comms-editor-target="previewOverlay" hidden>
  <div class="comms-preview-frame-wrap">
    <iframe data-comms-editor-target="previewFrame" sandbox="" title="Email preview"></iframe>
  </div>
  <button type="button" class="comms-preview-close" data-action="click->comms-editor#closePreview" aria-label="Close">✕</button>
</div>

<%= render "surveys/media_modal" if editable %>
</div>
