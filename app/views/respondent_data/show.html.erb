<%# GDPR data-subject rights for one respondent (P0-7). Deliberately plain: this
    is a compliance tool an admin uses a handful of times, not a dashboard. %>
<div style="min-height:100%;background:#1C2034;padding:36px 24px;">
  <div style="max-width:760px;margin:0 auto;">

    <%= link_to survey_results_path(@survey),
          style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);text-decoration:none;" do %>
      ← <%= t("respondent_data.back_to_results") %>
    <% end %>

    <h1 style="font-family:'Alata',sans-serif;font-size: var(--text-2xl);color:#fff;margin:14px 0 6px;">
      <%= t("respondent_data.title") %>
    </h1>
    <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);line-height:1.6;margin-bottom:8px;">
      <%= t("respondent_data.intro", verto: @survey.title.presence || @survey.theme.presence) %>
    </p>
    <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.4);line-height:1.6;margin-bottom:24px;">
      <%= t("respondent_data.identifier_note") %>
    </p>

    <%= form_with url: survey_respondent_data_path(@survey), method: :get, data: { turbo: false },
          style: "background:#272D4A;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:20px;" do |f| %>
      <% field = "width:100%;background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.14);border-radius:9px;padding:10px 12px;color:#fff;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);" %>
      <% label = "display:block;font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.5);margin-bottom:6px;" %>

      <label style="<%= label %>"><%= t("respondent_data.session_token_label") %></label>
      <%= f.text_field :session_token, value: @session_token, style: field, autocomplete: "off" %>

      <label style="<%= label %>margin-top:14px;"><%= t("respondent_data.respondent_code_label") %></label>
      <%= f.text_field :respondent_code, value: @respondent_code, style: field, autocomplete: "off" %>

      <button type="submit" style="margin-top:16px;padding:10px 20px;border-radius:100px;border:none;cursor:pointer;background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-sm);">
        <%= t("respondent_data.find") %>
      </button>
    <% end %>

    <% if @searched %>
      <div style="margin-top:26px;">
        <% if @responses.empty? %>
          <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);">
            <%= t("respondent_data.not_found") %>
          </p>
        <% else %>
          <h2 style="font-family:'Alata',sans-serif;font-size: var(--text-lg);color:#fff;margin-bottom:12px;">
            <%= t("respondent_data.found", count: @responses.size) %>
          </h2>

          <% @responses.each do |r| %>
            <div style="background:#272D4A;border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:14px 16px;margin-bottom:10px;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);line-height:1.7;">
              <div><strong style="color:#fff;">#<%= r.id %></strong> · <%= r.status %> · <%= l(r.created_at, format: :long) rescue r.created_at.to_s %></div>
              <div style="color:rgba(255,255,255,0.45);">
                <%= t("respondent_data.consent_state",
                      state: r.consent_agreed_at ? t("respondent_data.consent_agreed") : t("respondent_data.consent_none")) %>
                <% if r.region_label.present? %> · <%= r.region_label %><% end %>
                <% if r.demographic_birth_year.present? %> · <%= r.demographic_birth_year %><% end %>
              </div>
            </div>
          <% end %>

          <div style="display:flex;gap:10px;margin-top:18px;flex-wrap:wrap;">
            <%= link_to t("respondent_data.download"),
                  survey_respondent_data_export_path(@survey, session_token: @session_token, respondent_code: @respondent_code),
                  data: { turbo: false },
                  style: "padding:10px 20px;border-radius:100px;background:rgba(255,255,255,0.1);color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-sm);text-decoration:none;" %>

            <%= button_to t("respondent_data.erase"),
                  survey_respondent_data_path(@survey, session_token: @session_token, respondent_code: @respondent_code),
                  method: :delete,
                  form: { data: { turbo_confirm: t("respondent_data.erase_confirm", count: @responses.size) } },
                  style: "padding:10px 20px;border-radius:100px;border:1px solid rgba(255,90,90,0.5);background:transparent;color:#FF8080;font-family:'Alata',sans-serif;font-size: var(--text-sm);cursor:pointer;" %>
          </div>
          <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.35);margin-top:10px;line-height:1.6;">
            <%= t("respondent_data.erase_note") %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
