<% content_for :title, t("portfolios.show_title", name: @portfolio.name) %>
<% content_for :head do %>
  <style>body { overflow: auto !important; height: auto !important; }</style>
<% end %>

<div style="max-width:640px;margin:0 auto;padding:48px 24px 60px;">
  <%= link_to t("portfolios.back_to_funder"), funder_path(@funder),
        style: "display:inline-block;color:rgba(255,255,255,0.45);font-size: var(--text-sm);text-decoration:none;margin-bottom:18px;" %>

  <h1 style="font-family:'Alata',sans-serif;font-size: var(--text-2xl);color:#fff;margin:0 0 6px;"><%= @portfolio.name %></h1>
  <p style="color:rgba(255,255,255,0.4);font-size: var(--text-md);margin:0 0 24px;"><%= t("portfolios.member_view_heading") %></p>

  <% if @questions.empty? %>
    <div style="border:1px dashed rgba(255,255,255,0.12);border-radius:12px;padding:20px;text-align:center;color:rgba(255,255,255,0.4);"><%= t("portfolios.no_sets_title") %></div>
  <% else %>
    <ul style="margin:0;padding-left:20px;color:rgba(255,255,255,0.8);display:flex;flex-direction:column;gap:8px;">
      <% @questions.each do |cq| %>
        <li><%= cq.text %></li>
      <% end %>
    </ul>
  <% end %>
</div>
