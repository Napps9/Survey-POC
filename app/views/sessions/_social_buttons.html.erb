<%# Social sign-in buttons — one per provider with credentials configured
    (SocialAuth.enabled mirrors the OmniAuth initializer). The request phase
    must be a CSRF-protected POST, hence button_to; turbo is off because the
    response is a redirect to the provider's domain. %>
<% providers = SocialAuth.enabled %>
<% if providers.any? %>
  <%
    icons = {
      google_oauth2: '<svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>'
    }
  %>
  <div style="display:flex;flex-direction:column;gap:10px;">
    <% providers.each do |p| %>
      <%= button_to "/auth/#{p.key}",
            data: { turbo: false },
            form: { style: "margin:0;" },
            style: "width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:13px;border-radius:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.16);color:#F7F7F7;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);cursor:pointer;transition:background 0.15s;",
            onmouseover: "this.style.background='rgba(255,255,255,0.12)'",
            onmouseout:  "this.style.background='rgba(255,255,255,0.06)'" do %>
        <%= icons[p.key].html_safe %>
        <span><%= t("auth.social_continue", provider: p.label) %></span>
      <% end %>
    <% end %>
  </div>

  <div style="display:flex;align-items:center;gap:12px;margin:22px 0;">
    <div style="flex:1;height:1px;background:rgba(255,255,255,0.12);"></div>
    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.08em;"><%= t("auth.social_divider") %></span>
    <div style="flex:1;height:1px;background:rgba(255,255,255,0.12);"></div>
  </div>
<% end %>
