<%# Respondent-local data-saving toggle, remembered across every Verto this
    browser plays — same localStorage-preference shape as the font-size
    control above it (player_controller.js#toggleLite/_loadLiteMode).
    Strips ambient motion (like forms mode), skips autoplaying video and
    decorative Lottie loops, and pins the card-art fit algorithm to its
    floor — see application.css's .lite-mode rules and _fitCard's lite gate.
    Hiding media via CSS alone can't reliably stop an already-requested
    background-image fetch, so the honest saving is video/lottie gating
    plus cards that were never shown never loading at all; the toggle's own
    copy says so rather than promising "no images". %>
<button type="button" class="lite-mode-btn"
        data-player-target="liteModeBtn"
        data-action="click->player#toggleLite"
        aria-pressed="false"
        aria-label="<%= t("player.lite_mode") %>"
        title="<%= t("player.lite_mode") %>">
  <%= t("player.lite_mode_short") %>
</button>
