<% content_for :title, "#{@survey.theme} · Playverto" %>
<%
  cards   = Array(@survey.cards)
  total_q = cards.count { |c| CardTypes.question?(c["type"]) }
  prev_q  = 0

  # Owner preview (from the dashboard): the exact respondent experience but
  # with blank recording endpoints, so stepping through never creates a
  # Response. Drafts have no publish_token, so their URLs must stay blank too.
  # Live visitors keep the token they arrived with (publish or share), so
  # progress/submit resolve the same attribution context.
  preview_mode    = @preview == true
  play_token      = params[:token].presence || @survey.publish_token
  progress_url    = preview_mode ? "" : progress_survey_url(play_token)
  submit_url      = preview_mode ? "" : submit_survey_url(play_token)
  consent_url     = preview_mode ? "" : consent_survey_url(play_token)
  results_url     = @survey.show_results_comparison? && play_token.present? ? player_results_url(play_token) : ""
  show_comparison = @survey.show_results_comparison? && results_url.present?
  # The public play link respondents can pass on via the Share button on the
  # thank-you screen. Blank in owner preview (and for token-less drafts).
  share_url       = preview_mode || play_token.blank? ? "" : play_survey_url(play_token)

  # Every Verto captures region data via the "Where do you live?" demographic
  # question, so the post-finish map is always available — it just needs a
  # reachable token (drafts in preview have none).
  regions_url = play_token.present? ? player_regions_url(play_token) : ""

  # Quiz mode: each graded card is scored server-side as the player advances.
  # The grade/state endpoints need a reachable token, so they're blank in owner
  # preview (and for token-less drafts) — preview instead grades client-side
  # from correct answers embedded only on the owner's preview page. The scores
  # ("how you compare") endpoint is a read and likewise needs a live token.
  quiz_mode      = @survey.quiz?
  live_quiz      = quiz_mode && !preview_mode && play_token.present?
  grade_url      = live_quiz ? grade_survey_url(play_token) : ""
  quiz_state_url = live_quiz ? quiz_state_survey_url(play_token) : ""
  scores_url     = live_quiz ? player_scores_url(play_token) : ""
  graded_set     = quiz_mode ? @survey.graded_card_indices.to_set : Set.new

  # Tokenisation: a card's token config is public (rendered straight into the
  # page), so the running total is computed entirely client-side — no
  # grade-style round trip needed. The server only recomputes the
  # authoritative total at progress/submit time (PlayerController#apply_token_totals).
  token_mode         = @survey.tokenisation_enabled?
  token_awarding_set = token_mode ? @survey.token_awarding_indices.to_set : Set.new
%>
<%# No inline height here — `.preview-overlay`'s own CSS (position:fixed +
    inset:0, backed by the JS-measured --app-100vh custom property on mobile)
    handles sizing. A hardcoded "height:100vh;" here previously overrode that
    CSS unconditionally (inline styles beat any class rule), which is the
    classic mobile WebKit bug: 100vh locks to the viewport with the browser's
    toolbar hidden, so on first paint (toolbar visible) the bottom of the
    page — including the Next button — rendered below the visible fold with
    no way to scroll to it. %>
<div class="preview-overlay flex flex-col"
     style="<%= verto_backdrop_style_attr(@survey) %>"
     dir="<%= SupportedLocales.dir(@display_locale) %>"
     data-controller="player"
     data-player-progress-url-value="<%= progress_url %>"
     data-player-submit-url-value="<%= submit_url %>"
     data-player-consent-url-value="<%= consent_url %>"
     data-player-results-url-value="<%= results_url %>"
     data-player-regions-url-value="<%= regions_url %>"
     data-player-locale-value="<%= @display_locale %>"
     data-player-share-url-value="<%= share_url %>"
     data-player-show-comparison-value="<%= show_comparison %>"
     data-player-quiz-value="<%= quiz_mode %>"
     data-player-grade-url-value="<%= grade_url %>"
     data-player-quiz-state-url-value="<%= quiz_state_url %>"
     data-player-scores-url-value="<%= scores_url %>"
     data-player-tokenisation-value="<%= token_mode %>"
     data-player-token-types-value="<%= @survey.token_types.to_json %>">

  <% if preview_mode %>
    <div style="flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:14px;padding:7px 14px;background:rgba(1,234,203,0.1);border-bottom:1px solid rgba(1,234,203,0.25);">
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm, 12px);color:#01EACB;">
        ▶ <%= t("player.preview_banner") %>
      </span>
      <%= link_to t("player.exit_preview"), root_path,
            style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm, 12px);color:rgba(255,255,255,0.85);text-decoration:underline;text-underline-offset:3px;" %>
    </div>
  <% end %>

  <%# The compare-results promise used to be a top banner; it now lives on the
      welcome card (player/welcome_intake) to free up screen space. The
      publishing org's logo (when uploaded) sits at the top of the welcome
      card itself — see player/_play_card. %>

  <%# Slim content-language switcher for multilingual Vertos, so respondents can
      still change the content language. %>
  <% if @survey.multilingual? %>
    <div class="player-lang-bar">
      <%= render "player/content_lang_switcher" %>
    </div>
  <% end %>

  <div class="preview-body">
    <%# Consent gate as the first card in the deck (reuses the creator's consent
        text). It carries NO data-card-index, so it's never captured as an answer
        and never shifts the answer keys, which align to the @survey.cards index. %>
    <% if @survey.consent_required? %>
      <div class="preview-card"
           data-player-target="card"
           data-card-type="consent_card">
        <%# Rendered as the standard split-card so consent is in keeping with the
            question-card design (empty branded left panel + content on the right). %>
        <div class="split-card">
          <div class="split-left">
            <div class="panel-progress"><div class="panel-progress-fill" style="width:5%;"></div></div>
          </div>
          <div class="split-right">
            <div data-player-target="consentMain" class="play-consent-main">
              <div class="q-header">
                <div class="q-title"><%= t("player.consent_title") %></div>
              </div>
              <div class="play-consent-body"><%= safe_join(@survey.consent_text.split("\n"), tag.br) %></div>
              <div class="play-consent-actions">
                <button type="button" class="play-consent-agree"
                        data-action="click->player#agreeConsent"><%= t("player.consent_agree") %></button>
                <button type="button" class="play-consent-decline"
                        data-action="click->player#declineConsent"><%= t("player.consent_decline") %></button>
              </div>
            </div>
            <div class="play-consent-declined hidden" data-player-target="consentDeclined">
              <%= t("player.consent_declined") %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% cards.each_with_index do |card, idx| %>
      <%
        type    = card["type"].to_s
        is_q    = CardTypes.question?(type)
        graded  = graded_set.include?(idx)
        awards_tokens = token_awarding_set.include?(idx)
        prev_q += 1 if is_q
        prog   = total_q > 0 ? ((prev_q.to_f / total_q) * 100).round : 5
        prog   = 5 unless is_q
      %>
      <%# A graded card carries only a boolean flag in the live player — never
          its correct answer (that's revealed by the server after answering).
          In owner preview the answer rides along so the reveal works offline.
          A card's token config is NOT secret (unlike a quiz's correct answer)
          — it's public config the creator set, so it rides along even live,
          letting the player compute a running total client-side. %>
      <div class="preview-card"
           data-player-target="card"
           data-card-index="<%= idx %>"
           data-card-type="<%= type %>"
           data-card-graded="<%= graded %>"
           <% if preview_mode && graded %>data-card-correct="<%= QuizGrading.correct_display(card).to_json %>" data-card-explanation="<%= card['explanation'] %>"<% end %>
           data-card-awards-tokens="<%= awards_tokens %>"
           <% if awards_tokens %>data-card-tokens="<%= card['tokens'].to_json %>" data-card-token-award="<%= card['token_award'].to_json %>" data-card-token-award-mode="<%= card['token_award_mode'] %>"<% end %>
           data-card-required="<%= (is_q && card['required']) ? 'true' : 'false' %>">
        <%= render "player/play_card", card: card, progress: prog,
              locale: @display_locale, default_locale: @survey.default_locale %>
      </div>
    <% end %>

    <div class="preview-thankyou" data-player-target="thankyou">
      <div data-player-target="thankyouMain" class="preview-thankyou-card">
        <%# Publishing org's logo sits prominently at the top of the
            thank-you card — the player nav is hidden on mobile, so this
            is the only place the brand is shown. %>
        <%= brand_logo_tag @survey.organisation, style: "height:44px;width:auto;max-width:60%;margin:0 auto 18px;display:block;" %>

        <div class="preview-thankyou-title"><%= @survey.thankyou_title_text %></div>
        <div class="preview-thankyou-sub">
          <%= safe_join(@survey.thankyou_body_text.split("\n"), tag.br) %>
        </div>

        <%# Quiz final score — filled in by the player on finish (live: from the
            submit response; preview: from client-side grading). %>
        <% if quiz_mode %>
          <div class="quiz-result-card hidden" data-player-target="quizScore"></div>
        <% end %>

        <%# Tokenisation final totals — filled in by the player on finish (live:
            from the submit response; preview/offline: from the running client
            tally, since a card's token config is public, not secret like a
            quiz's correct answer). %>
        <% if token_mode %>
          <div class="token-result-card hidden" data-player-target="tokenScore"></div>
        <% end %>

        <%# Thank-you actions: compare (brand CTA) then the outline secondaries —
            forward-to-website, share, and regions. %>
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:22px;width:100%;">
          <% if quiz_mode && scores_url.present? %>
            <button type="button"
                    data-player-target="scoresBtn"
                    data-action="click->player#showScores"
                    style="padding:11px 22px;border-radius:100px;background:var(--brand-cta,#01EACB);color:var(--brand-cta-text,#1C2034);font-family:'Alata',sans-serif;font-size:13px;letter-spacing:0.05em;border:none;cursor:pointer;">
              <%= t("player.quiz_compare_cta") %>
            </button>
          <% end %>

          <% if show_comparison %>
            <button type="button"
                    data-player-target="compareBtn"
                    data-action="click->player#showComparison"
                    style="padding:11px 22px;border-radius:100px;background:var(--brand-cta,#01EACB);color:var(--brand-cta-text,#1C2034);font-family:'Alata',sans-serif;font-size:13px;letter-spacing:0.05em;border:none;cursor:pointer;">
              <%= t("player.compare_cta") %>
            </button>
          <% end %>

          <% if @survey.forward_url? %>
            <a href="<%= @survey.forward_url %>" target="_blank" rel="noopener"
               style="padding:11px 22px;border-radius:100px;background:transparent;color:#fff;font-family:'Alata',sans-serif;font-size:13px;letter-spacing:0.05em;border:1px solid rgba(255,255,255,0.25);text-decoration:none;cursor:pointer;">
              <%= t("player.visit_website") %> →
            </a>
          <% end %>

          <button type="button"
                  data-player-target="shareBtn"
                  data-action="click->player#share"
                  style="padding:11px 22px;border-radius:100px;background:transparent;color:#fff;font-family:'Alata',sans-serif;font-size:13px;letter-spacing:0.05em;border:1px solid rgba(255,255,255,0.25);cursor:pointer;">
            <%= t("player.share") %>
          </button>

          <% if regions_url.present? %>
            <button type="button"
                    data-player-target="regionsBtn"
                    data-action="click->player#showRegions"
                    style="padding:11px 22px;border-radius:100px;background:transparent;color:#fff;font-family:'Alata',sans-serif;font-size:13px;letter-spacing:0.05em;border:1px solid rgba(255,255,255,0.25);cursor:pointer;">
              🌍 <%= t("player.see_regions") %>
            </button>
          <% end %>
        </div>

        <%# Small "Powered by Playverto" wordmark at the bottom. %>
        <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:22px;opacity:0.45;">
          <span style="font-family:'ABeeZee',sans-serif;font-size:10px;color:#fff;"><%= t("player.powered_by") %></span>
          <%= image_tag "playverto.svg", alt: "", style: "height:12px;width:auto;" %>
        </div>
      </div>

      <% if regions_url.present? %>
        <%# Post-finish regions view: a full-screen, pannable/zoomable world map
            of where answers came from, then per-region comparison against
            this respondent's own answers. %>
        <div data-player-target="regionsPanel" class="hidden regions-overlay">
          <div class="regions-header">
            <div>
              <div class="regions-header-title"><%= t("player.regions_title") %></div>
              <div data-player-target="regionsMeta" class="regions-header-meta"></div>
            </div>
            <button type="button" class="preview-close-btn" data-action="click->player#hideRegions">
              <%= t("player.back") %>
            </button>
          </div>

          <div data-player-target="regionsMain" class="regions-main">
            <div data-player-target="regionsMapViewport" class="regions-map-viewport">
              <div data-player-target="regionsMapStage" class="regions-map-stage">
                <%= render "shared/world_map" %>
              </div>
              <div class="regions-zoom-controls">
                <button type="button" class="regions-zoom-btn" data-action="click->player#zoomInMap"
                        aria-label="<%= t("player.region_zoom_in") %>">+</button>
                <button type="button" class="regions-zoom-btn" data-action="click->player#zoomOutMap"
                        aria-label="<%= t("player.region_zoom_out") %>">−</button>
                <button type="button" class="regions-zoom-btn" data-action="click->player#resetMapView"
                        aria-label="<%= t("player.region_reset_view") %>">⟲</button>
              </div>
            </div>
            <div class="regions-hint"><%= t("player.region_compare_hint") %></div>
            <div data-player-target="regionsList" class="regions-list"></div>
          </div>

          <div data-player-target="regionDetail" class="hidden regions-detail">
            <div data-player-target="regionDetailTitle"
                 style="font-family:'Alata',sans-serif;font-size:16px;color:#01EACB;margin-bottom:12px;text-align:center;"></div>
            <div data-player-target="regionDetailList" style="display:flex;flex-direction:column;gap:14px;"></div>
          </div>
        </div>
      <% end %>

      <%# Quiz: "how you compare" — your score against everyone's distribution,
          plus a per-question correct-rate. Filled by player#showScores. %>
      <% if quiz_mode && scores_url.present? %>
        <div data-player-target="scoresPanel" class="hidden"
             style="width:100%;max-width:640px;margin:0 auto;padding:24px 22px 28px;overflow-y:auto;max-height:calc(100vh - 120px);background:#1C2034;border:1px solid rgba(255,255,255,0.08);border-radius:24px;box-shadow:0 20px 50px rgba(0,0,0,0.35);">
          <div style="text-align:center;margin-bottom:18px;">
            <div style="font-family:'Alata',sans-serif;font-size:22px;color:#fff;letter-spacing:0.02em;"><%= t("player.quiz_compare_title") %></div>
            <div style="font-family:'ABeeZee',sans-serif;font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;"
                 data-player-target="scoresMeta"></div>
          </div>
          <div data-player-target="scoresList" style="display:flex;flex-direction:column;gap:14px;"></div>
          <div style="display:flex;justify-content:center;margin-top:18px;">
            <button type="button"
                    data-action="click->player#hideScores"
                    style="padding:9px 18px;border-radius:100px;background:transparent;color:#fff;font-family:'ABeeZee',sans-serif;font-size:12px;border:1px solid rgba(255,255,255,0.2);cursor:pointer;">
              <%= t("player.back") %>
            </button>
          </div>
        </div>
      <% end %>

      <% if show_comparison %>
        <div data-player-target="comparison" class="hidden"
             style="width:100%;max-width:640px;margin:0 auto;padding:24px 22px 28px;overflow-y:auto;max-height:calc(100vh - 120px);background:#1C2034;border:1px solid rgba(255,255,255,0.08);border-radius:24px;box-shadow:0 20px 50px rgba(0,0,0,0.35);">
          <div style="text-align:center;margin-bottom:18px;">
            <div style="font-family:'Alata',sans-serif;font-size:22px;color:#fff;letter-spacing:0.02em;"><%= t("player.comparison_title") %></div>
            <div style="font-family:'ABeeZee',sans-serif;font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;"
                 data-player-target="comparisonMeta"></div>
          </div>
          <div data-player-target="comparisonList" style="display:flex;flex-direction:column;gap:14px;"></div>
          <div style="display:flex;justify-content:center;margin-top:18px;">
            <button type="button"
                    data-action="click->player#hideComparison"
                    style="padding:9px 18px;border-radius:100px;background:transparent;color:#fff;font-family:'ABeeZee',sans-serif;font-size:12px;border:1px solid rgba(255,255,255,0.2);cursor:pointer;">
              <%= t("player.back") %>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Shown when the respondent tries to advance past a required, unanswered
      question; cleared as soon as they move on. %>
  <div class="preview-required-hint hidden" data-player-target="requiredHint">
    <%= t("player.required_hint") %>
  </div>

  <div class="preview-footer">
    <button class="preview-btn preview-btn-back invisible"
            data-player-target="backBtn"
            data-action="click->player#back"
            aria-label="Back"><%= t("player.back") %></button>
    <span class="preview-progress-text" data-player-target="progress"></span>
    <%# Quiz running score — shown only on a quiz, updated after each graded card. %>
    <span class="quiz-score-chip hidden" data-player-target="scoreChip" aria-live="polite"></span>
    <%# Tokenisation running total — shown only when tokenisation is on,
        updated after each token-awarding card is answered. %>
    <span class="token-score-chip hidden" data-player-target="tokenScoreChip" aria-live="polite"></span>
    <button class="preview-btn preview-btn-next"
            data-player-target="nextBtn"
            data-action="click->player#next"><%= t("player.next") %></button>
    <button class="preview-btn preview-btn-finish hidden"
            data-player-target="finishBtn"
            data-action="click->player#finish"><%= t("player.submit") %></button>
  </div>

</div>
