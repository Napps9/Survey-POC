<%
  left_bg_for = {
    "multiple_choice"  => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_many"      => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_one_grid"  => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_many_grid" => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "yes_no"           => "linear-gradient(150deg,#002b4d 0%,#001a30 100%)",
    "tap_card"         => "linear-gradient(150deg,#002b4d 0%,#001a30 100%)",
    "range"            => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "rating"           => "linear-gradient(150deg,#3d2a00 0%,#1a1000 100%)",
    "open_ended"       => "linear-gradient(150deg,#3d0020 0%,#1a0010 100%)",
    "nps"              => "linear-gradient(150deg,#3d2a00 0%,#1a1000 100%)"
  }
%>

<div style="height:100%;background:#1C2034;display:flex;overflow:hidden;position:relative;">

  <div class="gen-orbs results-orbs" aria-hidden="true">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
  </div>

  <div style="flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden;position:relative;z-index:1;">

    <%# Top bar %>
    <div style="height:54px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;padding:0 24px;gap:12px;background:#1C2034;">
      <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);letter-spacing:0.1em;text-transform:uppercase;">
        <%= t("common_questions.results_title", default: "Common Questions Results") %>
      </span>
      <span style="color:rgba(255,255,255,0.15);">·</span>
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.35);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;"><%= @set.name %></span>
      <%= link_to t("common_questions.back_to_set", default: "Set editor"), common_question_set_path(@set),
            style: "flex-shrink:0;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);text-decoration:none;padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);" %>
    </div>

    <%# Scrollable feed %>
    <div style="flex:1;overflow-y:auto;padding:24px 24px 48px;">
      <div style="max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:14px;">

        <% if @set.deleted? %>
          <div style="padding:12px 16px;border-radius:12px;background:rgba(255,30,111,0.1);border:1px solid rgba(255,30,111,0.3);color:#FF1E6F;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);">
            <%= t("common_questions.deleted_banner", default: "This set has been deleted. Existing Vertos keep their snapshot — these results stay viewable.") %>
          </div>
        <% end %>

        <%# Stats strip %>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;">
          <% [
            { value: @total_surveys.to_s,   label: t("common_questions.stat_vertos",    default: "Vertos with responses"),   accent: "#615BF5" },
            { value: @total_responses.to_s, label: t("common_questions.stat_responses", default: "Total responses"),         accent: "#01EACB" },
            { value: @set.common_questions.size.to_s, label: t("common_questions.stat_questions", default: "Questions"),     accent: "#0CA7FF" }
          ].each do |s| %>
            <div style="padding:16px;border-radius:14px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);text-align:center;">
              <div style="font-family:'Alata',sans-serif;font-size:30px;color:<%= s[:accent] %>;line-height:1;"><%= s[:value] %></div>
              <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.5);letter-spacing:0.12em;text-transform:uppercase;margin-top:6px;"><%= s[:label] %></div>
            </div>
          <% end %>
        </div>

        <%# Per-question result cards %>
        <% @per_question.each_with_index do |result, idx| %>
          <% type      = result[:type] || result[:card]["type"]
             card_data = result[:card]
             total_ans = result[:total].to_i
             cq        = result[:common_question]
             card_meta = card_type_meta(type)
             variants  = @snapshot_variants[cq.id]
             drift     = result[:drift?] %>

          <div style="border-radius:14px;overflow:hidden;background:#fff;border:1px solid rgba(255,255,255,0.08);">

            <%# Header %>
            <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;background:rgba(0,0,0,0.05);">
              <span class="s-badge <%= card_meta[:badge_css] %>"><%= card_meta[:badge] %></span>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(0,0,0,0.4);">Q<%= idx + 1 %></span>
              <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:<%= total_ans > 0 ? '#615BF5' : 'rgba(0,0,0,0.25)' %>;">
                <%= pluralize(total_ans, "answer") %>
              </span>
            </div>

            <div style="padding:14px 18px;display:flex;flex-direction:column;gap:10px;">
              <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:#111;line-height:1.45;font-weight:500;">
                <%= cq.text %>
              </div>

              <% if drift %>
                <details style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(0,0,0,0.45);">
                  <summary style="cursor:pointer;"><%= t("common_questions.drift_summary", default: "Text differed in older Vertos") %></summary>
                  <ul style="margin:6px 0 0 18px;padding:0;line-height:1.6;">
                    <% variants.each do |snapshot_text, survey_ids| %>
                      <% next if snapshot_text == cq.text %>
                      <li>"<%= snapshot_text %>" — <%= pluralize(survey_ids.size, "Verto") %></li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <% if total_ans == 0 %>
                <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(0,0,0,0.25);font-style:italic;"><%= t("common_questions.no_responses", default: "No responses yet across attached Vertos.") %></div>

              <% elsif %w[multiple_choice yes_no select_one_grid select_many select_many_grid].include?(type) %>
                <% counts = result[:counts] || {}; grand = [counts.values.sum.to_f, 1.0].max %>
                <div style="display:flex;flex-direction:column;gap:5px;">
                  <% counts.sort_by { |_, v| -v }.each do |label, count| %>
                    <% pct = ((count / grand) * 100).round %>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;min-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= label %>"><%= label.to_s.truncate(20) %></span>
                      <div style="flex:1;height:7px;border-radius:4px;background:rgba(97,91,245,0.1);overflow:hidden;">
                        <div style="height:100%;border-radius:4px;background:#615BF5;width:<%= pct %>%;"></div>
                      </div>
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);min-width:50px;text-align:right;"><%= count %> (<%= pct %>%)</span>
                    </div>
                  <% end %>
                </div>

              <% elsif type == "range" || type == "nps" %>
                <% labels = Array(card_data["options"] || cq.options); n = [labels.size, 2].max; counts = result[:counts] || {}; grand = [counts.values.sum.to_f, 1.0].max %>
                <div style="display:flex;flex-direction:column;gap:5px;">
                  <% n.times do |i| %>
                    <% count = counts[i].to_i; label = labels[i] || "Step #{i + 1}"; pct = ((count / grand) * 100).round %>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;min-width:100px;"><%= label.to_s.truncate(20) %></span>
                      <div style="flex:1;height:7px;border-radius:4px;background:rgba(97,91,245,0.1);overflow:hidden;">
                        <div style="height:100%;border-radius:4px;background:#615BF5;width:<%= pct %>%;"></div>
                      </div>
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);min-width:50px;text-align:right;"><%= count %> (<%= pct %>%)</span>
                    </div>
                  <% end %>
                </div>

              <% elsif type == "rating" %>
                <% avg = result[:avg]; counts = result[:counts] || {}; grand = [counts.values.sum.to_f, 1.0].max %>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
                  <div style="font-size: var(--text-2xl);letter-spacing:2px;">
                    <% 5.times do |i| %><span style="color:<%= i < avg.to_f.round ? '#FFCC00' : 'rgba(0,0,0,0.12)' %>"><%= i < avg.to_f.round ? "★" : "☆" %></span><% end %>
                  </div>
                  <span style="font-family:'Alata',sans-serif;font-size: var(--text-3xl);color:#615BF5;line-height:1;"><%= avg %></span>
                </div>
                <div style="display:flex;flex-direction:column;gap:3px;">
                  <% (5).downto(1) do |star| %>
                    <% count = counts[star].to_i; pct = ((count / grand) * 100).round %>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);min-width:24px;"><%="★" * star %></span>
                      <div style="flex:1;height:5px;border-radius:3px;background:rgba(255,204,0,0.12);overflow:hidden;">
                        <div style="height:100%;border-radius:3px;background:#FFCC00;width:<%= pct %>%;"></div>
                      </div>
                      <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);min-width:28px;text-align:right;"><%= count %></span>
                    </div>
                  <% end %>
                </div>

              <%# Was a hand-rolled yes/no split that left Unsure out of both the
                  bar AND the denominator, so a statement 40% of people were
                  unsure about reported as a straight majority. The shared
                  partial counts every response on the card's scale. %>
              <% elsif type == "tap_card" %>
                <%= render "shared/tap_result_bars", result: result %>

              <% elsif type == "open_ended" %>
                <ul style="margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;line-height:1.5;">
                  <% Array(result[:texts]).first(20).each do |txt| %>
                    <li><%= txt %></li>
                  <% end %>
                </ul>
                <% if Array(result[:texts]).size > 20 %>
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(0,0,0,0.4);">+ <%= Array(result[:texts]).size - 20 %> more</div>
                <% end %>

              <% else %>
                <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(0,0,0,0.5);"><%= total_ans %> answer<%= total_ans == 1 ? "" : "s" %></div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>
