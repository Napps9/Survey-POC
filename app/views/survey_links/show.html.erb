<%# The Share panel: everything needed to put this Verto in front of someone.
    Rendered into a Turbo Frame the dashboard opens as a modal, and re-rendered
    by the same frame after every change made inside it, so there is exactly one
    description of this screen.

    Deliberately narrow (2026-08-17 simplification): sharing the main link,
    creating/recalling custom links, and the two take-down moves — unpublish and
    convert to Test Mode. What a respondent sees after they finish is the
    editor's Publish & share panel's business, not this modal's; per-link
    overrides of those settings are still honoured by the player for links that
    carry them, they just aren't edited here. %>
<%= turbo_frame_tag SurveyLinksController::FRAME_ID do %>
  <%
    # Two names, deliberately. The heading matches the dashboard card this modal
    # was opened from (theme first — see _dashboard_card), so it's obviously the
    # same Verto. What goes out to a respondent uses the creator's own title
    # first, which is the wording written to be read by someone else.
    heading     = @survey.theme.presence || @survey.title.presence || t("dashboard_card.untitled")
    share_name  = @survey.title.presence || @survey.theme.presence || t("dashboard_card.fallback_name")
    main_key    = @survey.public_link_key
    main_url    = main_key.present? ? play_survey_url(main_key) : nil
    live        = @survey.published?
    error       = params[:link_error].to_s.presence
    at_limit    = @links.size >= SurveyLink::MAX_PER_SURVEY
    share_text  = t("share_modal.share_text", name: share_name)
  %>

  <div class="share-modal">
    <div class="share-modal__bar"></div>

    <div class="share-modal__head">
      <div style="min-width:0;">
        <div class="share-modal__eyebrow"><%= t("share_modal.eyebrow") %></div>
        <div class="share-modal__title"><%= heading %></div>
      </div>
      <button type="button" data-action="click->share-modal#close"
              aria-label="<%= t("share_modal.close") %>" class="share-modal__close">✕</button>
    </div>

    <div class="share-modal__body">

      <% if error.present? %>
        <div class="share-alert">
          <%= case error
              when "taken" then t("share_modal.error_taken")
              when "limit" then t("share_modal.error_limit", count: SurveyLink::MAX_PER_SURVEY)
              else              t("share_modal.error_create")
              end %>
        </div>
      <% end %>

      <% unless live %>
        <%# A draft has no address to hand out. Links can still be prepared here
            (they resolve the moment it goes live), so the panel stays usable —
            it just says plainly that nothing works yet. %>
        <div class="share-notice">
          <div class="share-notice__title"><%= t("share_modal.not_live_title") %></div>
          <div class="share-notice__body"><%= t("share_modal.not_live_body") %></div>
          <%= link_to t("share_modal.not_live_cta"), survey_path(@survey, panel: "publish"),
                data: { turbo_frame: "_top" }, class: "share-btn share-btn--primary",
                style: "margin-top:12px;display:inline-block;text-decoration:none;" %>
        </div>
      <% end %>

      <%# ── The Verto's own link ──────────────────────────────────────────── %>
      <section class="share-section">
        <div class="share-section__head">
          <span class="share-section__title"><%= t("share_modal.main_link") %></span>
          <span class="share-count"><%= t("share_modal.responders", count: @default_responder_count) %></span>
        </div>

        <% if live %>
          <div class="share-url-row">
            <input type="text" readonly id="share-url-main" value="<%= main_url %>" class="share-url" />
            <button type="button" class="share-btn share-btn--primary"
                    data-copy-label="<%= t("share_modal.copy") %>"
                    onclick="(navigator.clipboard?.writeText(document.getElementById('share-url-main').value) ?? Promise.reject()).then(()=>{this.textContent='<%= j t("share_modal.copied") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2000)}).catch(()=>{this.textContent='<%= j t("share_modal.copy_failed") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2500)})"><%= t("share_modal.copy") %></button>
          </div>

          <%# The one button that actually opens a share: the OS share sheet on a
              phone, where most links are passed on. Hidden where the browser
              has no navigator.share rather than shown as a dead control. %>
          <div class="share-via-row">
            <button type="button" class="share-chip share-chip--native" hidden
                    data-share-modal-target="nativeShare"
                    data-share-title="<%= share_name %>"
                    data-share-text="<%= share_text %>"
                    data-share-url="<%= main_url %>"
                    data-action="click->share-modal#nativeShare">📤 <%= t("share_modal.share_sheet") %></button>
            <%= link_to "✉ #{t("share_modal.via_email")}",
                  "mailto:?subject=#{CGI.escape(share_name)}&body=#{CGI.escape("#{share_text}\n\n#{main_url}")}",
                  class: "share-chip", target: "_blank", rel: "noopener" %>
            <%= link_to "💬 #{t("share_modal.via_whatsapp")}",
                  "https://wa.me/?text=#{CGI.escape("#{share_text} #{main_url}")}",
                  class: "share-chip", target: "_blank", rel: "noopener" %>
            <%= link_to "✕ #{t("share_modal.via_x")}",
                  "https://twitter.com/intent/tweet?text=#{CGI.escape(share_text)}&url=#{CGI.escape(main_url)}",
                  class: "share-chip", target: "_blank", rel: "noopener" %>
            <%= link_to "in #{t("share_modal.via_linkedin")}",
                  "https://www.linkedin.com/sharing/share-offsite/?url=#{CGI.escape(main_url)}",
                  class: "share-chip", target: "_blank", rel: "noopener" %>
          </div>

          <div class="share-qr-row">
            <div class="share-qr-plate">
              <div style="width:84px;height:84px;"><%= verto_qr_svg(main_url) %></div>
            </div>
            <div style="min-width:0;">
              <div class="share-hint"><%= t("share_modal.qr_hint") %></div>
              <%= link_to t("share_modal.download_qr"), qr_survey_path(@survey),
                    data: { turbo_frame: "_top" }, class: "share-btn",
                    style: "margin-top:8px;display:inline-block;text-decoration:none;" %>
            </div>
          </div>
        <% end %>

        <%# The Verto's own vanity address. Same field as the editor's Publish
            panel, in the place a creator is actually looking for it. %>
        <div class="share-field">
          <label class="share-label" for="share-main-slug"><%= t("share_modal.custom_url") %></label>
          <%= form_with url: survey_settings_path(@survey), method: :post, class: "share-slug-form" do %>
            <input type="hidden" name="return_to" value="share" />
            <span class="share-slug-prefix"><%= root_url %>play/</span>
            <input type="text" name="slug" id="share-main-slug" maxlength="<%= Survey::MAX_SLUG_LENGTH %>"
                   value="<%= @survey.slug %>"
                   placeholder="<%= t("share_modal.custom_url_placeholder") %>"
                   onchange="this.form.requestSubmit()" class="share-input" />
          <% end %>
          <% if params[:slug_error] == "taken" %>
            <div class="share-error"><%= t("share_modal.error_taken") %></div>
          <% else %>
            <div class="share-hint"><%= t("share_modal.custom_url_hint") %></div>
          <% end %>
        </div>
      </section>

      <%# ── Custom links ───────────────────────────────────────────────────── %>
      <section class="share-section">
        <div class="share-section__head">
          <span class="share-section__title"><%= t("share_modal.links_title") %></span>
          <span class="share-count"><%= @links.size %>/<%= SurveyLink::MAX_PER_SURVEY %></span>
        </div>
        <div class="share-hint" style="margin-bottom:12px;"><%= t("share_modal.links_hint") %></div>

        <% @links.each do |link| %>
          <% link_url = play_survey_url(link.play_key) %>
          <div class="share-link<%= " share-link--paused" unless link.active? %>">
            <div class="share-link__top">
              <%= form_with url: survey_link_path(@survey, link), method: :patch, style: "margin:0;flex:1;min-width:0;" do %>
                <input type="text" name="name" value="<%= link.name %>"
                       maxlength="<%= SurveyLink::MAX_NAME %>"
                       onchange="this.form.requestSubmit()"
                       class="share-link__name"
                       aria-label="<%= t("share_modal.link_name_label") %>" />
              <% end %>
              <% unless link.active? %>
                <span class="share-count share-count--recalled"><%= t("share_modal.recalled_badge") %></span>
              <% end %>
              <span class="share-count"><%= t("share_modal.responders", count: (@link_responder_counts[link.id] || 0)) %></span>
            </div>

            <div class="share-url-row">
              <input type="text" readonly id="share-url-<%= link.id %>" value="<%= link_url %>" class="share-url" />
              <button type="button" class="share-btn"
                      data-copy-label="<%= t("share_modal.copy") %>"
                      onclick="(navigator.clipboard?.writeText(document.getElementById('share-url-<%= link.id %>').value) ?? Promise.reject()).then(()=>{this.textContent='<%= j t("share_modal.copied") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2000)}).catch(()=>{this.textContent='<%= j t("share_modal.copy_failed") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2500)})"><%= t("share_modal.copy") %></button>
            </div>

            <div class="share-link__foot">
              <%# Recall is the reversible take-back: the address stops resolving
                  — reads and writes both — until restored. No confirm: undoing
                  it is one click on the button this one becomes. %>
              <%= form_with url: survey_link_path(@survey, link), method: :patch, style: "margin:0;" do %>
                <input type="hidden" name="active" value="<%= link.active? ? 0 : 1 %>" />
                <button type="submit" class="share-link__action<%= " share-link__action--warn" if link.active? %>">
                  <%= link.active? ? t("share_modal.recall_link") : t("share_modal.restore_link") %>
                </button>
              <% end %>
              <div style="display:flex;align-items:center;gap:10px;">
                <%= link_to t("share_modal.download_qr_short"), qr_survey_path(@survey, link_id: link.id),
                      data: { turbo_frame: "_top" }, class: "share-link__action" %>
                <%= button_to t("share_modal.delete_link"), survey_link_path(@survey, link), method: :delete,
                      form: { style: "margin:0;", data: { turbo_confirm: t("share_modal.delete_confirm", name: link.name) } },
                      class: "share-link__action share-link__action--danger" %>
              </div>
            </div>
          </div>
        <% end %>

        <% if @links.empty? %>
          <div class="share-hint" style="margin-bottom:12px;"><%= t("share_modal.links_empty") %></div>
        <% end %>

        <% if at_limit %>
          <div class="share-hint"><%= t("share_modal.error_limit", count: SurveyLink::MAX_PER_SURVEY) %></div>
        <% else %>
          <%= form_with url: survey_links_path(@survey), method: :post, class: "share-new" do %>
            <input type="text" name="name" class="share-input"
                   placeholder="<%= t("share_modal.new_name_placeholder") %>"
                   maxlength="<%= SurveyLink::MAX_NAME %>" />
            <div class="share-slug-form" style="margin:0;">
              <span class="share-slug-prefix"><%= root_url %>play/</span>
              <input type="text" name="slug" class="share-input"
                     placeholder="<%= t("share_modal.new_url_placeholder") %>"
                     maxlength="<%= Survey::MAX_SLUG_LENGTH %>"
                     aria-label="<%= t("share_modal.custom_url") %>" />
            </div>
            <button type="submit" class="share-btn share-btn--primary"><%= t("share_modal.add_link") %></button>
          <% end %>
        <% end %>
      </section>

      <%# ── Test Mode & status ─────────────────────────────────────────────── %>
      <section class="share-section">
        <div class="share-section__head">
          <span class="share-section__title"><%= t("share_modal.test_mode_title") %></span>
        </div>
        <div class="share-hint" style="margin-bottom:10px;"><%= t("share_modal.test_mode_hint") %></div>

        <% if @survey.test_token.present? %>
          <div class="share-url-row">
            <input type="text" readonly id="share-url-test" value="<%= test_survey_url(@survey.test_token) %>"
                   class="share-url share-url--test" />
            <button type="button" class="share-btn"
                    data-copy-label="<%= t("share_modal.copy") %>"
                    onclick="(navigator.clipboard?.writeText(document.getElementById('share-url-test').value) ?? Promise.reject()).then(()=>{this.textContent='<%= j t("share_modal.copied") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2000)}).catch(()=>{this.textContent='<%= j t("share_modal.copy_failed") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2500)})"><%= t("share_modal.copy") %></button>
          </div>
          <%= button_to t("share_modal.test_link_off"), test_link_survey_path(@survey, return_to: "share"), method: :delete,
                form: { style: "margin:8px 0 0;", data: { turbo_confirm: t("share_modal.test_link_off_confirm") } },
                class: "share-btn", style: "width:100%;" %>
        <% elsif live %>
          <%# One step, two effects — the confirm text carries both: off /play,
              test link on. Only offered while there is no test link yet;
              afterwards the Status block below is the take-down control. %>
          <%= button_to t("share_modal.convert_test_button"), test_mode_survey_path(@survey), method: :post,
                form: { style: "margin:0;", data: { turbo_confirm: t("share_modal.convert_test_confirm") } },
                class: "share-btn", style: "width:100%;" %>
        <% else %>
          <%= button_to t("share_modal.test_link_create"), test_link_survey_path(@survey, return_to: "share"), method: :post,
                form: { style: "margin:0;" },
                class: "share-btn", style: "width:100%;" %>
        <% end %>

        <% if live && main_key.present? %>
          <%# The OTHER way into Test Mode, and the only one that doesn't take
              the Verto off /play: the player's hidden press-and-hold hatch
              (player/_test_mode_hatch), for whoever is already holding the live
              link — a facilitator at an event, a partner demoing on their own
              phone. It is deliberately unlabelled and unannounced IN THE PLAYER,
              because anyone with the public link can reach that page and a
              respondent who tripped into it would have their real answers
              silently discarded. None of that argues for hiding it from the
              creator, who is signed in and is the person handing the link out —
              and with nothing here, the gesture was undiscoverable to everyone,
              which is not "hidden", it is missing. So: the gesture spelled out,
              plus the plain URL it leads to, for anyone who can't perform it. %>
          <div class="share-field">
            <div class="share-label"><%= t("share_modal.live_test_title") %></div>
            <div class="share-hint" style="margin-bottom:8px;"><%= t("share_modal.live_test_hint") %></div>
            <div class="share-url-row">
              <input type="text" readonly id="share-url-live-test" value="<%= live_test_survey_url(main_key) %>"
                     class="share-url share-url--test" />
              <button type="button" class="share-btn"
                      data-copy-label="<%= t("share_modal.copy") %>"
                      onclick="(navigator.clipboard?.writeText(document.getElementById('share-url-live-test').value) ?? Promise.reject()).then(()=>{this.textContent='<%= j t("share_modal.copied") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2000)}).catch(()=>{this.textContent='<%= j t("share_modal.copy_failed") %>';setTimeout(()=>this.textContent=this.dataset.copyLabel,2500)})"><%= t("share_modal.copy") %></button>
            </div>
          </div>
        <% end %>

        <% if live %>
          <% has_responses = @survey.responses.exists? %>
          <div class="share-field">
            <div class="share-label"><%= t("share_modal.status_title") %></div>
            <%# Same fork as the editor's Publish panel: with responses in, a
                take-down closes the Verto (results kept, deck stays locked);
                without any, it goes back to an editable draft. Either way the
                publish token is kept, so publishing again restores the link. %>
            <%= button_to (has_responses ? t("share_modal.unpublish_close") : t("share_modal.unpublish_draft")),
                  unpublish_survey_path(@survey, return_to: "share"), method: :post,
                  form: { style: "margin:0;", data: { turbo_confirm:
                    has_responses ? t("share_modal.unpublish_confirm_close") : t("share_modal.unpublish_confirm_draft") } },
                  class: "share-btn share-btn--warn", style: "width:100%;" %>
            <div class="share-hint" style="margin-top:6px;">
              <%= has_responses ? t("share_modal.unpublish_hint_close") : t("share_modal.unpublish_hint_draft") %>
            </div>
          </div>
        <% end %>
      </section>

    </div>
  </div>
<% end %>
