<%# Staff-facing and English-only, like the review queue it links to.
    Inline styles + table layout for email-client compatibility. %>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#272D4A;margin:0;padding:0;width:100%;">
  <tr>
    <td align="center" style="padding:40px 16px;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:520px;background:#1C2034;border-radius:16px;">

        <tr>
          <td align="center" style="padding:36px 32px 8px;">
            <span style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:28px;letter-spacing:1.5px;line-height:1;">
              <span style="color:#F7F7F7;">play</span><span style="color:#FF1E6F;">verto</span>
            </span>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:20px 32px 10px;">
            <h1 style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:20px;color:#F7F7F7;margin:0;font-weight:400;">
              <%= @entries.size %> <%= "Verto".pluralize(@entries.size) %> submitted to the Ask corpus
            </h1>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:0 36px 20px;">
            <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.6;color:rgba(247,247,247,0.7);margin:0;">
              <strong style="color:#F7F7F7;"><%= @user.name.presence || @user.email_address %></strong>
              (<%= @organisation.name %>) has offered these Vertos to Ask Verto.
              Nothing joins the corpus until the Verto team approves it.
            </p>
          </td>
        </tr>

        <% @rows.each do |row| %>
          <tr>
            <td style="padding:0 32px 10px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border:1px solid rgba(247,247,247,0.12);border-radius:10px;">
                <tr>
                  <td style="padding:10px 14px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;color:#F7F7F7;">
                    <%= row[:name] %>
                    <span style="display:block;font-size:12px;color:rgba(247,247,247,0.5);margin-top:2px;">
                      <%= number_with_delimiter(row[:responses]) %> people answered ·
                      <%= row[:whole] ? "all #{row[:total]} questions" : "#{row[:offered]} of #{row[:total]} questions" %>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td align="center" style="padding:14px 32px 28px;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td align="center" bgcolor="#01EACB" style="background:#01EACB;border-radius:10px;">
                  <%= link_to "Review the submission", corpus_reviews_url,
                        style: "display:inline-block;padding:13px 30px;font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:14px;letter-spacing:0.5px;color:#1C2034;text-decoration:none;" %>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:0 36px 30px;border-top:1px solid rgba(247,247,247,0.07);">
            <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;line-height:1.6;color:rgba(247,247,247,0.4);margin:16px 0 0;">
              You're receiving this because the Verto team reviews Ask Verto submissions.
              Aggregate figures only — raw responses never leave the Verto.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
