<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#272D4A;margin:0;padding:0;width:100%;">
  <tr>
    <td align="center" style="padding:40px 16px;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:520px;background:#1C2034;border-radius:16px;">

        <tr>
          <td align="center" style="padding:36px 32px 8px;">
            <span style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:28px;letter-spacing:1.5px;line-height:1;">
              <span style="color:#F7F7F7;">play</span><span style="color:#FF1E6F;">verto</span>
            </span>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:20px 32px 10px;">
            <h1 style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:20px;color:#F7F7F7;margin:0;font-weight:400;">
              <%= t("ask_submission_mailer.confirmation_heading") %>
            </h1>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:0 36px 20px;">
            <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.6;color:rgba(247,247,247,0.7);margin:0;">
              <%= t("ask_submission_mailer.confirmation_intro") %>
            </p>
          </td>
        </tr>

        <% @rows.each do |row| %>
          <tr>
            <td style="padding:0 32px 10px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border:1px solid rgba(247,247,247,0.12);border-radius:10px;">
                <tr>
                  <td style="padding:10px 14px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;color:#F7F7F7;">
                    <%= row[:name] %>
                    <span style="display:block;font-size:12px;color:rgba(247,247,247,0.5);margin-top:2px;">
                      <%= t("js.ask.people_answered", count: number_with_delimiter(row[:responses])) %> ·
                      <%= row[:whole] ? t("ask_submission_mailer.offer_all", count: row[:total]) : t("ask_submission_mailer.offer_partial", offered: row[:offered], total: row[:total]) %>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td align="center" style="padding:6px 36px 30px;">
            <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;line-height:1.6;color:rgba(247,247,247,0.5);margin:0;">
              <%= t("ask_submission_mailer.confirmation_outro") %>
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
