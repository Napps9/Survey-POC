<%= render "shell", org_name: @org_name, stop_org: @stop_org, stop_all: @stop_all, account_url: @account do %>
  <h1 style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:21px;color:#F7F7F7;margin:0 0 8px;font-weight:400;line-height:1.3;">
    <%= t("player_notification_mailer.follow_up.heading", org: @org_name) %>
  </h1>
  <%# The reason is on the card, always. A respondent who cannot see why they
      are being shown something has been retargeted, not helped — and the only
      fact this app has is which Verto they played. %>
  <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;line-height:1.65;color:rgba(247,247,247,0.75);margin:0 0 20px;">
    <%= t("player_notification_mailer.follow_up.because",
          verto: @survey.theme.presence || @survey.title) %>
  </p>

  <% @follow_ups.each do |next_verto| %>
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#272D4A;border-radius:12px;margin:0 0 12px;">
      <tr>
        <td style="padding:16px 18px;">
          <p style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:16px;color:#F7F7F7;margin:0 0 6px;">
            <%= next_verto.theme.presence || next_verto.title %>
          </p>
          <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;color:rgba(247,247,247,0.5);margin:0 0 12px;">
            <%= t("player_notification_mailer.follow_up.meta") %>
          </p>
          <a href="<%= play_survey_url(next_verto.publish_token) %>"
             style="display:inline-block;background:#01EACB;color:#1C2034;font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:14px;text-decoration:none;padding:9px 20px;border-radius:100px;">
            <%= t("player_notification_mailer.follow_up.cta") %>
          </a>
        </td>
      </tr>
    </table>
  <% end %>
<% end %>
