<%= render "shell", org_name: @org_name, stop_org: @stop_org, stop_all: @stop_all, account_url: @account do %>
  <h1 style="font-family:'Alata','Helvetica Neue',Arial,sans-serif;font-size:21px;color:#F7F7F7;margin:0 0 8px;font-weight:400;line-height:1.3;">
    <%= @survey.impact_headline %>
  </h1>
  <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;color:rgba(247,247,247,0.5);margin:0 0 18px;">
    <%= t("player_notification_mailer.impact.after", verto: @survey.theme.presence || @survey.title) %>
  </p>
  <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;line-height:1.65;color:rgba(247,247,247,0.85);margin:0 0 18px;">
    <%= @survey.impact_body %>
  </p>

  <%# The bullets are the substance and they are optional — a creator with one
      decision writes a sentence. %>
  <% @survey.impact_changes_list.each do |line| %>
    <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.6;color:rgba(247,247,247,0.75);margin:0 0 8px;">
      <span style="color:#01EACB;">→</span> <%= line %>
    </p>
  <% end %>

  <% if @survey.impact_link? %>
    <p style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;margin:16px 0 0;">
      <a href="<%= @survey.impact_link_url %>" style="color:#01EACB;"><%= @survey.impact_link_text %> ↗</a>
    </p>
  <% end %>
<% end %>
