<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= SupportedLocales.dir(I18n.locale) %>">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body style="height:100dvh;min-height:100vh;overflow:hidden;background:#272D4A;color:#F7F7F7;font-family:'ABeeZee',sans-serif;">
    <%# @chromeless pages (e.g. the owner's Verto preview) render bare even
        when signed in, so they replicate exactly what a respondent sees. %>
    <% if Current.user && !@chromeless %>
      <div data-controller="command-palette">
        <%# @hide_main_nav pages (the editor) drop the top nav to free the
            space, but keep the command palette reachable via ⌘K. %>
        <%= render "shared/bottom_bar" unless @hide_main_nav %>
        <%= render "shared/command_palette" %>
      </div>
      <div style="position: fixed; top: <%= @hide_main_nav ? "0" : "56px" %>; left: 0; right: 0; bottom: 0; overflow: auto;">
        <%= yield %>
      </div>
    <% else %>
      <%# Unauthenticated chrome-less pages (login, register, password). The
          player has its own content-language switcher in its nav. %>
      <% unless controller_name == "player" || @chromeless %>
        <div class="lang-switcher-fixed"><%= render "shared/locale_switcher" %></div>
      <% end %>
      <%= yield %>
      <%# Same non-player, non-chromeless gate as the locale switcher above —
          the player's own consent gate / cookie banner is enough there; a
          second links footer would clutter its full-viewport experience. %>
      <% unless controller_name == "player" || @chromeless %>
        <%= render "shared/legal_footer" %>
      <% end %>
    <% end %>

    <%= render "shared/cookie_consent_banner" %>
  </body>
</html>
