<title><%= content_for(:title) || "Playverto Verto Studio" %></title>
<%# interactive-widget is PLAYER-ONLY. On Chrome/Android it makes the soft
    keyboard shrink the LAYOUT viewport, so the player's `position: fixed;
    inset: 0` overlay becomes genuinely the visible area and its footer rides
    above the keyboard instead of being stranded mid-screen. Everywhere else
    it is unwanted: the editor is built for a pointer, and the auth pages
    depend on the browser's ordinary scroll-the-field-into-view behaviour.
    iOS Safari ignores the hint entirely — see lib/viewport_height.js, which
    is what carries that platform. %>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover<%= ",interactive-widget=resizes-content" if controller_name == "player" %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<%# A second theme-color meta wouldn't win — browsers honour the first valid
    one, so a per-Verto colour has to replace this tag, not follow it. %>
<meta name="theme-color" content="<%= content_for(:theme_color) || "#1C2034" %>">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Microsoft Clarity analytics — NOT loaded here. It's non-essential
    (session-replay) analytics, so it must not run before the visitor has
    given cookie consent. cookie_consent_controller.js injects this same tag
    itself, only once the Analytics category is accepted (or was already
    accepted on a prior visit). See app/javascript/controllers/
    cookie_consent_controller.js and app/views/shared/_cookie_consent_banner. %>

<%= yield :head %>

<%# @pwa_manifest_url (PlayerController#show) swaps in the per-Verto
    manifest so "Add to Home Screen" installs the Verto itself, scoped to
    /play/, instead of the studio-wide one every other page keeps. %>
<link rel="manifest" href="<%= @pwa_manifest_url || pwa_manifest_path %>">
<%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
<%= favicon_link_tag "favicon.svg", rel: "apple-touch-icon", type: "image/svg+xml" %>
<%# ABeeZee/Alata are now self-hosted (app/assets/tailwind/application.css +
    public/fonts/) instead of loaded from Google's fonts.googleapis.com /
    fonts.gstatic.com CDN, which sent every visitor's IP address to Google
    before any consent — see the @font-face rules for details. They ship as
    part of the "tailwind" stylesheet below, so no separate <link> is needed. %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= render "layouts/i18n_js" %>
<%= javascript_importmap_tags %>
