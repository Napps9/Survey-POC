<% content_for :title, t("funders.new_title") %>
<% content_for :head do %>
  <style>body { overflow: auto !important; height: auto !important; }</style>
<% end %>

<div style="position:relative;overflow:hidden;min-height:100vh;background:#1C2034;display:flex;align-items:center;justify-content:center;padding:24px;">
  <div class="gen-orbs" style="opacity:0.25;">
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
  </div>

  <div style="position:relative;z-index:1;width:100%;max-width:480px;">

    <div style="text-align:center;margin-bottom:32px;">
      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;">
        <span style="width:8px;height:8px;border-radius:50%;background:#615BF5;box-shadow:0 0 12px rgba(97,91,245,0.7);"></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);letter-spacing:0.12em;text-transform:uppercase;"><%= t("funders.new_eyebrow") %></span>
      </div>
      <h1 style="font-family:'Alata',sans-serif;font-size: var(--text-3xl);color:#fff;margin:0 0 6px;"><%= t("funders.new_heading") %></h1>
      <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.45);margin:0;">
        <%= t("funders.new_sub") %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div style="background:rgba(216,0,39,0.1);border:1px solid rgba(216,0,39,0.3);border-radius:10px;padding:11px 16px;margin-bottom:20px;color:#FF6B83;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with model: @funder, url: funders_path, local: true do |f| %>
      <div style="margin-bottom:20px;">
        <label style="display:block;font-family:'Alata',sans-serif;font-size: var(--text-base);letter-spacing:0.08em;color:rgba(247,247,247,0.6);margin-bottom:8px;text-transform:uppercase;"><%= t("funders.name_label") %></label>
        <%= f.text_field :name,
              required: true, autofocus: true, maxlength: 80,
              placeholder: t("funders.name_placeholder"),
              class: "form-input" %>
      </div>

      <div style="margin-bottom:24px;">
        <label style="display:block;font-family:'Alata',sans-serif;font-size: var(--text-base);letter-spacing:0.08em;color:rgba(247,247,247,0.6);margin-bottom:8px;text-transform:uppercase;"><%= t("funders.seat_count_label") %></label>
        <%= f.number_field :seat_count,
              required: true, min: 0, value: (@funder.seat_count.presence || 0),
              placeholder: t("funders.seat_count_placeholder"),
              class: "form-input" %>
        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.35);margin-top:6px;"><%= t("funders.seat_count_hint") %></div>
      </div>

      <div style="display:flex;gap:10px;">
        <%= link_to t("funders.cancel"), funders_path,
              style: "flex:0 0 auto;background:none;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:12px 22px;color:rgba(255,255,255,0.7);font-family:'Alata',sans-serif;font-size: var(--text-md);text-decoration:none;text-align:center;" %>
        <%= f.submit t("funders.create_submit"),
              style: "flex:1;background:#615BF5;border:none;border-radius:8px;padding:14px;color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.05em;cursor:pointer;" %>
      </div>
    <% end %>

  </div>
</div>
