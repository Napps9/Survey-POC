<%# A respondent's own Vertos. Signed out is a first-class state: there is no
    sign-in form anywhere in this app, so the page explains where a link comes
    from rather than sending anyone to a screen they cannot use. %>
<div class="you-page">
  <div class="you-orbs" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div>
  <div class="you-shell">

    <%# Nothing on the RIGHT of this bar: the fullscreen layout parks its
        language switcher there, and an avatar chip landed underneath it. The
        account is named under the heading instead, which says more than an
        initial did anyway — on a shared device, WHICH account you are in is
        the thing worth knowing. The wallet pill below reaches that corner the
        only way anything can — through the layout's own fixed cluster. %>
    <div class="you-bar">
      <%= image_tag "playverto.svg", alt: "Playverto", width: 104, class: "you-mark-sm" %>
    </div>

    <%= render "you/wallet_pill", rows: @purse_rows, total: @purse_total, current: :vertos %>

    <% if !player_signed_in? %>
      <div class="you-card">
        <h1 class="you-h1"><%= t("you.signed_out_title") %></h1>
        <p class="you-sub"><%= t("you.signed_out_body") %></p>
      </div>

    <% else %>
      <div class="you-head">
        <div class="you-eyebrow"><span class="you-dot"></span><%= t("you.eyebrow") %></div>
        <h1 class="you-h1"><%= t("you.kept", count: @claims.size) %></h1>
        <div class="you-whoami"><%= current_player.email_address %></div>
      </div>

      <% if @claims.empty? %>
        <div class="you-card">
          <p class="you-sub"><%= t("you.empty") %></p>
        </div>
      <% else %>
        <div class="you-list">
          <% @claims.each do |claim| %>
            <% survey = claim.survey %>
            <%# The row is a CARD, not a link, now that it carries its own
                actions — an <a> cannot hold three more. The title is the link
                that the whole row used to be, so the destination is unchanged
                and the tap target is the thing you would aim at anyway. %>
            <div class="you-verto">
              <span class="you-verto-rule" aria-hidden="true"></span>
              <div class="you-verto-body">
                <div class="you-verto-org"><%= survey.organisation.name %></div>
                <h2 class="you-verto-title">
                  <%= link_to survey.theme.presence || survey.title,
                        you_verto_path(survey), class: "you-verto-link" %>
                </h2>
                <%# When they PLAYED it, not when they claimed it — a device key
                    can claim a Verto months after the run, and the date that
                    means anything to them is the day they answered. %>
                <div class="you-verto-when">
                  <%= t("you.played_on",
                        date: l((claim.response.completed_at || claim.claimed_at).to_date, format: :long)) %>
                </div>
                <% piles = Array(survey.token_types).filter_map do |tt|
                     n = claim.response.token_totals.to_h[tt["id"]].to_i
                     next if n.zero?
                     [ tt["icon"], n, tt["name"] ]
                   end %>
                <% if piles.any? %>
                  <div class="you-piles">
                    <% piles.each do |icon, n, name| %>
                      <span class="you-pile"><%= icon %> <b><%= number_with_delimiter(n) %></b> <%= name %></span>
                    <% end %>
                  </div>
                <% end %>
                <% case @compare[survey.id] %>
                <% when :closed %>
                  <div class="you-verto-note">
                    <%= t("you.compare_closed", org: survey.organisation.name) %>
                  </div>
                <% when Hash %>
                  <div class="you-verto-note">
                    <%= t("you.compare_pending",
                          needed: Response::MIN_REGION_SAMPLE_SIZE,
                          have: @compare[survey.id][:have]) %>
                  </div>
                <% end %>

                <%# ONE SLOT, two occupants. "Compare results" is the primary
                    action on a row and the reason line stands exactly where it
                    would have been — so a respondent never presses a button
                    that leads to the sentence explaining why it leads nowhere.
                    The cost of that choice, stated because it is real: on a row
                    whose comparison is shut, the primary CTA is the one that is
                    missing, and the two that remain are both secondary. %>
                <div class="you-ctas">
                  <% if @compare[survey.id] == :ready %>
                    <%= link_to t("you.cta_compare"), you_verto_path(survey, anchor: "compare"),
                          class: "you-cta you-cta-primary" %>
                  <% end %>
                  <%= link_to t("you.cta_impact"), you_verto_path(survey, anchor: "impact"),
                        class: "you-cta" %>
                  <%# Native share where the browser has it, clipboard where it
                      does not, and an ordinary link to the Verto where neither
                      works — the label it swaps to is passed from here so it is
                      translated by Rails rather than needing a JS string. %>
                  <% if survey.playable? %>
                    <%= link_to t("you.cta_share"), play_survey_url(survey.publish_token),
                          class: "you-cta",
                          data: { controller: "share-verto",
                                  action: "share-verto#share",
                                  share_verto_title_value: survey.theme.presence || survey.title,
                                  share_verto_copied_value: t("you.share_copied") } %>
                  <% end %>
                </div>

                <%# What this Verto points at next, on the Verto that points —
                    so the reason needs no restating. Drawn only when there IS
                    one, which for most Vertos there is not. %>
                <% if @follow_ups[survey.id].present? %>
                  <div class="you-followups">
                    <div class="you-followups-head"><%= t("you.next_title") %></div>
                    <% @follow_ups[survey.id].each do |next_verto| %>
                      <%= link_to play_survey_path(next_verto.publish_token), class: "you-followup" do %>
                        <span class="you-followup-body">
                          <span class="you-followup-title"><%= next_verto.theme.presence || next_verto.title %></span>
                          <span class="you-followup-meta"><%= t("you.next_meta") %></span>
                        </span>
                        <span class="you-followup-go" aria-hidden="true">→</span>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="you-foot">
        <%= button_to t("you.sign_out"), you_sign_out_path, method: :post,
              class: "you-link", form: { style: "display:inline;margin:0;" } %>
        <%= button_to t("you.delete"), you_path, method: :delete,
              class: "you-link you-link-quiet",
              form: { style: "display:inline;margin:0;",
                      data: { turbo_confirm: t("you.delete_confirm") } } %>
      </div>
    <% end %>
  </div>
</div>
