<%# The account's own nav. Two tabs, not the three the design carries: "Next"
    is follow-ups, which is a later phase — an empty tab is worse than no tab.
    aria-current rather than a class alone, so the state is announced and not
    only coloured. %>
<nav class="you-tabs" aria-label="<%= t("you.tabs_label") %>">
  <%= link_to t("you.tab_vertos"), you_path,
        class: "you-tab#{" is-on" if current == :vertos}",
        "aria-current": (current == :vertos ? "page" : nil) %>
  <%= link_to t("you.tab_wallet"), you_wallet_path,
        class: "you-tab#{" is-on" if current == :wallet}",
        "aria-current": (current == :wallet ? "page" : nil) %>
</nav>
