<div style="display:flex;min-height:100vh;background:#1C2034;">
  <div style="flex:1;display:flex;flex-direction:column;min-width:0;padding:40px 48px;overflow-y:auto;">
    <div style="max-width:700px;margin:0 auto;width:100%;">

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;">
        <h1 style="font-family:'Alata',sans-serif;font-size: var(--text-4xl);color:#F7F7F7;margin:0;">Members</h1>
        <%= link_to "Invite member →", new_organisation_invite_path(current_organisation),
              style: "background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.05em;padding:10px 22px;border-radius:20px;text-decoration:none;" %>
      </div>

      <% if flash[:alert] %>
        <div class="alert-error">
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%# ── Brand: organisation logo ── %>
      <div style="background:#161B2E;border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:22px 24px;margin-bottom:32px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <div>
            <div style="font-family:'Alata',sans-serif;font-size: var(--text-lg);color:#F7F7F7;">Brand</div>
            <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.45);margin-top:3px;line-height:1.5;">
              Shown at the top of every Verto preview and shared play link. Without one, no logo is shown at all.
            </div>
          </div>
          <div style="height:44px;min-width:120px;display:flex;align-items:center;justify-content:center;padding:6px 14px;border-radius:10px;background:rgba(28,32,52,0.7);border:1px solid rgba(255,255,255,0.06);">
            <span class="logo-slot-empty">No logo</span>
            <%= brand_logo_tag current_organisation, style: "height:32px;width:auto;max-width:160px;" %>
          </div>
        </div>

        <%= form_with model: current_organisation,
              url: organisation_path(current_organisation),
              method: :patch,
              multipart: true,
              data: { turbo: false },
              html: { style: "display:flex;flex-wrap:wrap;align-items:center;gap:10px;" } do |f| %>
          <%= f.file_field :logo,
                accept: Organisation::LOGO_CONTENT_TYPES.join(","),
                style: "flex:1;min-width:200px;padding:10px 12px;border-radius:10px;background:#272D4A;border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);" %>
          <%= f.submit "Upload",
                style: "padding:10px 20px;border-radius:10px;background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.04em;border:none;cursor:pointer;" %>
          <% if current_organisation.logo.attached? %>
            <%= button_to "Remove",
                  organisation_path(current_organisation),
                  method: :patch,
                  params: { organisation: { remove_logo: "1" } },
                  data: { turbo_confirm: "Remove your organisation's logo? Your Vertos will show no logo until you upload another." },
                  form: { style: "display:inline;margin:0;" },
                  style: "padding:10px 16px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.6);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;" %>
          <% end %>
        <% end %>
        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);margin-top:10px;">
          PNG, JPG, GIF, SVG or WebP · transparent backgrounds work best.
          Also editable from any Verto's Design panel, under Branding.
        </div>

        <%# ── The same logo again, for light surfaces ──
            Everything the platform draws is dark chrome except one thing, and
            it is the first thing a respondent sees: the welcome card's logo
            sits on the WHITE answer panel. A white wordmark — which is what
            most accounts upload, because the rest of the platform is dark —
            vanishes there. Optional: with nothing here the logo above is used
            on both, exactly as before.
            The preview swatch is deliberately WHITE, so what a creator judges
            the upload against is the surface it will actually be drawn on. %>
        <div style="border-top:1px solid rgba(255,255,255,0.07);margin-top:18px;padding-top:18px;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:14px;">
            <div>
              <div style="font-family:'Alata',sans-serif;font-size: var(--text-md);color:#F7F7F7;">Logo for light backgrounds</div>
              <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.45);margin-top:3px;line-height:1.5;">
                Optional. Your welcome card sits on white — if the logo above is white, upload a dark or colour version here. Without one, the logo above is used everywhere.
              </div>
            </div>
            <div style="height:44px;min-width:120px;display:flex;align-items:center;justify-content:center;padding:6px 14px;border-radius:10px;background:#fff;border:1px solid rgba(255,255,255,0.06);flex-shrink:0;">
              <% if (light = brand_logo_for(current_organisation, :light)) %>
                <%= image_tag rails_storage_proxy_path(light, only_path: true),
                      style: "height:32px;width:auto;max-width:160px;object-fit:contain;" %>
              <% else %>
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(0,0,0,0.35);">No logo</span>
              <% end %>
            </div>
          </div>

          <%= form_with model: current_organisation,
                url: organisation_path(current_organisation),
                method: :patch,
                multipart: true,
                data: { turbo: false },
                html: { style: "display:flex;flex-wrap:wrap;align-items:center;gap:10px;" } do |f| %>
            <%= f.file_field :logo_on_light,
                  accept: Organisation::LOGO_CONTENT_TYPES.join(","),
                  style: "flex:1;min-width:200px;padding:10px 12px;border-radius:10px;background:#272D4A;border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);" %>
            <%= f.submit "Upload",
                  style: "padding:10px 20px;border-radius:10px;background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.04em;border:none;cursor:pointer;" %>
            <% if current_organisation.logo_on_light.attached? %>
              <%= button_to "Remove",
                    organisation_path(current_organisation),
                    method: :patch,
                    params: { organisation: { remove_logo_on_light: "1" } },
                    data: { turbo_confirm: "Remove the light-background logo? Your welcome cards will use your main logo instead." },
                    form: { style: "display:inline;margin:0;" },
                    style: "padding:10px 16px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.6);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# ── Brand asset library ── %>
      <% assets = current_organisation.ordered_assets.to_a %>
      <div style="background:#161B2E;border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:22px 24px;margin-bottom:32px;">
        <div style="margin-bottom:14px;">
          <div style="font-family:'Alata',sans-serif;font-size: var(--text-lg);color:#F7F7F7;">Brand asset library</div>
          <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.45);margin-top:3px;line-height:1.5;">
            Upload your brand images once — they appear under “Your brand library” in every Verto’s media picker, ready to drop onto any card or background. Only your account can see them.
          </div>
        </div>

        <% if assets.any? %>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
            <% assets.each do |att| %>
              <div style="position:relative;width:96px;height:96px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);background:#0f1322 center/cover no-repeat url('<%= as_thumb_path(att) %>');">
                <%= button_to "×",
                      organisation_asset_path(current_organisation, att.id),
                      method: :delete,
                      data: { turbo_confirm: "Remove this asset from your brand library?" },
                      form: { style: "position:absolute;top:4px;right:4px;margin:0;" },
                      title: "Remove",
                      style: "width:22px;height:22px;line-height:1;padding:0;border-radius:6px;background:rgba(12,15,26,0.82);border:1px solid rgba(255,255,255,0.2);color:#fff;font-family:'Alata',sans-serif;font-size:15px;cursor:pointer;" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.35);margin-bottom:16px;">
            No brand assets yet — add your logos, product shots or illustrations below.
          </div>
        <% end %>

        <%= form_with url: organisation_assets_path(current_organisation),
              method: :post,
              multipart: true,
              data: { turbo: false,
                      controller: "asset-upload",
                      asset_upload_remaining_value: Organisation::MAX_ASSETS - assets.size,
                      asset_upload_max_bytes_value: Organisation::ASSET_MAX_BYTES,
                      asset_upload_accept_value: Organisation::ASSET_CONTENT_TYPES.join(",") },
              html: { style: "display:flex;flex-wrap:wrap;align-items:center;gap:10px;" } do %>
          <%= file_field_tag "assets[]",
                multiple: true,
                accept: Organisation::ASSET_CONTENT_TYPES.join(","),
                data: { asset_upload_target: "input", action: "change->asset-upload#check" },
                style: "flex:1;min-width:200px;padding:10px 12px;border-radius:10px;background:#272D4A;border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);" %>
          <%= submit_tag "Add to library",
                data: { asset_upload_target: "submit" },
                style: "padding:10px 20px;border-radius:10px;background:#01EACB;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.04em;border:none;cursor:pointer;" %>
          <div data-asset-upload-target="error" hidden
               style="flex-basis:100%;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#FF1E6F;"></div>
        <% end %>
        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);margin-top:10px;">
          PNG, JPG, GIF, SVG or WebP · up to <%= Organisation::ASSET_MAX_BYTES / 1.megabyte %> MB each · <%= assets.size %>/<%= Organisation::MAX_ASSETS %> used.
        </div>
      </div>

      <%# Active members %>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:32px;">
        <% @memberships.each do |membership| %>
          <div style="background:#161B2E;border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px 20px;display:flex;align-items:center;gap:16px;">
            <div style="flex:1;">
              <div style="font-family:'Alata',sans-serif;font-size: var(--text-lg);color:#F7F7F7;"><%= membership.user.name.presence || "—" %></div>
              <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);"><%= membership.user.email_address %></div>
            </div>
            <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.08em;text-transform:uppercase;padding:3px 10px;border-radius:20px;background:<%= membership.admin? ? 'rgba(1,234,203,0.15)' : 'rgba(255,255,255,0.06)' %>;color:<%= membership.admin? ? '#01EACB' : 'rgba(255,255,255,0.4)' %>;">
              <%= membership.role %>
            </span>
            <% if membership.user != Current.user %>
              <%= button_to "Remove",
                    organisation_membership_path(current_organisation, membership),
                    method: :delete,
                    data: { turbo_confirm: "Remove #{membership.user.name} from #{current_organisation.name}?" },
                    style: "background:none;border:1px solid rgba(216,0,39,0.3);border-radius:8px;padding:5px 12px;color:rgba(216,0,39,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Pending invites %>
      <% if @pending_invites.any? %>
        <div style="margin-top:8px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
            <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);letter-spacing:0.1em;text-transform:uppercase;">Pending invites</span>
            <div style="flex:1;height:1px;background:rgba(255,255,255,0.06);"></div>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <% @pending_invites.each do |invite| %>
              <div style="background:#161B2E;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:14px 20px;display:flex;align-items:center;gap:16px;">
                <div style="flex:1;">
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.6);"><%= invite.email_address %></div>
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);margin-top:2px;">
                    Expires <%= distance_of_time_in_words_to_now(invite.expires_at) %> from now
                    · invited by <%= invite.invited_by.name.presence || invite.invited_by.email_address %>
                  </div>
                </div>
                <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.08em;text-transform:uppercase;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.35);">
                  <%= invite.role %>
                </span>
                <button type="button"
                        onclick="navigator.clipboard.writeText('<%= invite_url(invite.token) %>').then(()=>{this.textContent='Copied!';setTimeout(()=>{this.textContent='Copy link'},2000)})"
                        style="background:none;border:1px solid rgba(255,255,255,0.1);border-radius:7px;padding:5px 12px;color:rgba(255,255,255,0.4);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;white-space:nowrap;">
                  Copy link
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
