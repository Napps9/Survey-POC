<div style="min-height:100vh;background:#1C2034;display:flex;flex-direction:column;">

  <%# Floating brand orbs for atmosphere %>
  <div class="gen-orbs" style="opacity:0.22;pointer-events:none;">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
  </div>

  <%# Heading %>
  <div style="position:relative;z-index:1;padding:64px 36px 24px;text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;">
      <span style="width:8px;height:8px;border-radius:50%;background:#01EACB;box-shadow:0 0 12px rgba(1,234,203,0.7);"></span>
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);letter-spacing:0.12em;text-transform:uppercase;">
        <%= t("create_chooser.eyebrow", default: "Create") %>
      </span>
    </div>
    <h1 style="font-family:'Alata',sans-serif;font-size:38px;color:#fff;line-height:1.1;margin:0 0 10px;">
      <%= t("create_chooser.heading", default: "What are you creating?") %>
    </h1>
    <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-lg);color:rgba(255,255,255,0.45);margin:0 auto;max-width:540px;line-height:1.55;">
      <%= t("create_chooser.subtitle", default: "Start a brand-new Verto, or build a reusable set of Common Questions you can drop into many Vertos.") %>
    </p>
  </div>

  <%# Two tiles %>
  <div style="position:relative;z-index:1;flex:1;display:flex;align-items:center;justify-content:center;padding:24px 36px 60px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;max-width:920px;width:100%;">

      <%= link_to new_survey_path,
            style: "display:flex;flex-direction:column;gap:14px;padding:36px 28px 32px;border-radius:22px;background:linear-gradient(135deg,rgba(1,234,203,0.16),rgba(1,234,203,0.04));border:1px solid rgba(1,234,203,0.32);text-decoration:none;color:#fff;transition:transform 0.15s ease, box-shadow 0.15s ease;",
            onmouseover: "this.style.transform='translateY(-2px)';this.style.boxShadow='0 16px 40px rgba(1,234,203,0.18)';",
            onmouseout:  "this.style.transform='';this.style.boxShadow='';" do %>
        <div style="width:48px;height:48px;border-radius:14px;background:rgba(1,234,203,0.16);display:flex;align-items:center;justify-content:center;color:#01EACB;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div style="font-family:'Alata',sans-serif;font-size:24px;color:#fff;line-height:1.2;">
          <%= t("create_chooser.verto_title", default: "Create a Verto") %>
        </div>
        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.55);line-height:1.55;">
          <%= t("create_chooser.verto_body", default: "Hand us a theme, audience, and key insight — we'll design a full 10–15 question Verto and let you tweak it before publishing.") %>
        </div>
        <div style="margin-top:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;letter-spacing:0.04em;">
          <%= t("create_chooser.verto_cta", default: "Start a Verto") %> →
        </div>
      <% end %>

      <%= link_to new_common_question_set_path,
            style: "display:flex;flex-direction:column;gap:14px;padding:36px 28px 32px;border-radius:22px;background:linear-gradient(135deg,rgba(97,91,245,0.18),rgba(97,91,245,0.04));border:1px solid rgba(97,91,245,0.32);text-decoration:none;color:#fff;transition:transform 0.15s ease, box-shadow 0.15s ease;",
            onmouseover: "this.style.transform='translateY(-2px)';this.style.boxShadow='0 16px 40px rgba(97,91,245,0.20)';",
            onmouseout:  "this.style.transform='';this.style.boxShadow='';" do %>
        <div style="width:48px;height:48px;border-radius:14px;background:rgba(97,91,245,0.18);display:flex;align-items:center;justify-content:center;color:#615BF5;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="4" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/>
            <rect x="8" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </div>
        <div style="font-family:'Alata',sans-serif;font-size:24px;color:#fff;line-height:1.2;">
          <%= t("create_chooser.common_title", default: "Create Common Questions") %>
        </div>
        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.55);line-height:1.55;">
          <%= t("create_chooser.common_body", default: "Build a reusable set of 4–6 questions you can attach to many Vertos — and see results rolled up across every Verto that used them.") %>
        </div>
        <div style="margin-top:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#615BF5;letter-spacing:0.04em;">
          <%= t("create_chooser.common_cta", default: "Start a set") %> →
        </div>
      <% end %>

    </div>
  </div>
</div>
