<%
  left_bg_for = {
    "welcome_card"     => "linear-gradient(150deg,#0d3d22 0%,#051408 100%)",
    "multiple_choice"  => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_many"      => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_one_grid"  => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "select_many_grid" => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "yes_no"           => "linear-gradient(150deg,#002b4d 0%,#001a30 100%)",
    "tap_card"         => "linear-gradient(150deg,#002b4d 0%,#001a30 100%)",
    "range"            => "linear-gradient(150deg,#1a1550 0%,#0a0833 100%)",
    "rating"           => "linear-gradient(150deg,#3d2a00 0%,#1a1000 100%)",
    "open_ended"       => "linear-gradient(150deg,#3d0020 0%,#1a0010 100%)",
  }
%>

<style>
  .results-export-menu > summary { list-style: none; }
  .results-export-menu > summary::-webkit-details-marker { display: none; }
  .results-export-menu > summary::marker { content: ""; }
  .results-export-menu > summary:hover { color: #fff; border-color: rgba(255,255,255,0.3); }
</style>

<%# Full-viewport app-shell — body stays overflow:hidden from fullscreen layout %>
<div style="height:100%;background:#1C2034;display:flex;overflow:hidden;position:relative;">

  <%# Subtle on-brand ambient orbs behind everything %>
  <div class="gen-orbs results-orbs" aria-hidden="true">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
    <div class="gen-orb gen-orb-4"></div>
  </div>

  <%# ── Middle: top-bar + scrollable content ── %>
  <div style="flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden;position:relative;z-index:1;">

    <%# Top bar %>
    <div style="height:54px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;padding:0 24px;gap:12px;background:#1C2034;">
      <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);letter-spacing:0.1em;text-transform:uppercase;"><%= t("results.title") %></span>
      <span style="color:rgba(255,255,255,0.15);">·</span>
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.35);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;"><%= @survey.theme %></span>
      <%= link_to t("results.editor"), survey_path(@survey),
            style: "flex-shrink:0;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);text-decoration:none;padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);transition:all 0.15s;",
            onmouseover: "this.style.color='white';this.style.borderColor='rgba(255,255,255,0.3)'",
            onmouseout:  "this.style.color='rgba(255,255,255,0.4)';this.style.borderColor='rgba(255,255,255,0.1)'" %>
    </div>

    <%# Scrollable results feed %>
    <div style="flex:1;overflow-y:auto;padding:24px 24px 48px;">
      <div style="max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:14px;">

        <%# ── Ask Verto summary card (brand-coloured generating state) ── %>
        <div id="av-card" class="summary-card" style="border-radius:14px;background:rgba(1,234,203,0.05);border:1px solid rgba(1,234,203,0.18);padding:18px 22px;">
          <div class="summary-rainbow"></div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.4);letter-spacing:0.1em;text-transform:uppercase;"><%= t("results.ask_verto") %></span>
            <span id="av-thinking" class="gen-shimmer--brand" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);margin-left:2px;"><%= t("results.analysing") %></span>
          </div>
          <div id="av-text"
               style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.65);line-height:1.8;white-space:pre-wrap;min-height:18px;"></div>
        </div>

        <script>
          (function() {
            const card    = document.getElementById("av-card")
            const textEl  = document.getElementById("av-text")
            const thinkEl = document.getElementById("av-thinking")
            card.classList.add("is-generating")
            const stop = () => { card.classList.remove("is-generating"); thinkEl.style.display = "none" }
            fetch(<%= survey_results_summary_path(@survey).to_json.html_safe %>)
              .then(async r => {
                // A 503 means every streaming slot is busy, not that insights
                // are broken — show the server's wording, which says to retry.
                if (!r.ok) throw new Error((await r.text()).trim())
                const reader = r.body.getReader()
                const dec    = new TextDecoder()
                let started  = false
                function pump() {
                  return reader.read().then(({ done, value }) => {
                    if (done) { stop(); return }
                    if (!started) { started = true; stop() }
                    textEl.textContent += dec.decode(value, { stream: true })
                    return pump()
                  })
                }
                return pump()
              })
              .catch(err => {
                stop()
                textEl.textContent = (err && err.message) || "Insights unavailable right now."
                textEl.style.color = "rgba(255,255,255,0.2)"
              })
          })()
        </script>

        <%# ── Regions map — where responses came from (region-tagged Vertos) ── %>
        <% region_segments = @segments.select { |s| s[:id].to_s.start_with?("region_") } %>
        <% if region_segments.any? %>
          <%
            # cc → { count:, name:, segment_ids: [...] }: one region segment
            # per country (see ResolvesResultSegments), keyed here by its
            # lowercase map shape id.
            map_data = {}
            region_segments.each do |seg|
              next if seg[:country].blank?
              cc = seg[:country].downcase
              map_data[cc] ||= { count: 0, name: WorldRegions.name_for(seg[:country]), segment_ids: [] }
              map_data[cc][:count] += seg[:count]
              map_data[cc][:segment_ids] << seg[:id]
            end
          %>
          <div class="regions-box" data-controller="results-compare"
               data-results-compare-url-value="<%= survey_results_compare_path(@survey) %>"
               data-results-compare-summarize-url-value="<%= survey_results_summarize_texts_path(@survey) %>">
            <div class="regions-box-head">
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5);">🌍 Audience segments</span>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.35);">Click a country on the map to compare segments of your audience</span>
              <button type="button" class="compare-open-btn" style="margin-left:auto;"
                      data-results-compare-target="openBtn"
                      data-action="click->results-compare#toggle">⛶ Compare segments</button>
            </div>

            <%# ── Map stays visible & clickable at all times; the comparison
                panel docks beside it (never over it, so nothing on the map
                is ever hidden behind the panel). Compare mode takes this
                whole stage (map + panel) full-screen for real room to
                compare — see the controller for why it's this element (not
                the controller root above) that gets moved to <body>. ── %>
            <div class="regions-box-body" data-results-compare-target="stage">
              <div class="compare-stage-row">
                <div class="regions-map-col">
                  <%# Positioned wrapper the controller zooms against — when
                      every selected segment is in one country, the map zooms
                      in on that country's shape for a closer look. ── %>
                  <div class="compare-map-stage" data-results-compare-target="mapStage">
                    <%= render "shared/world_map" %>
                  </div>
                </div>

                <div class="compare-panel hidden" data-results-compare-target="panel">
                  <div class="compare-panel-head">
                    <div>
                      <div class="compare-panel-title">Compare segments</div>
                      <div class="compare-panel-meta" data-results-compare-target="meta">Loading…</div>
                    </div>
                    <button type="button" class="compare-close-btn" aria-label="Close">✕</button>
                  </div>
                  <div class="compare-body" data-results-compare-target="body"></div>
                </div>
              </div>

              <%# A single horizontally-scrolling row along the bottom of the
                  screen — not a wrapped grid beside the map — so picking
                  regions never eats into the map's own space. Lives outside
                  .compare-stage-row so it spans the full width, under both
                  the map and the panel. ── %>
              <div class="compare-picker-wrap hidden" data-results-compare-target="pickerWrap">
                <div class="compare-picker-label">🌍 Segments — click to add or remove</div>
                <div class="compare-picker" data-results-compare-target="picker"></div>
              </div>
            </div>
          </div>
          <script type="application/json" id="results-region-map-data"><%= map_data.to_json.html_safe %></script>
        <% end %>

        <%# ── Filterable feed: stats + segment pills + per-question cards ── %>
        <%= turbo_frame_tag "results-feed" do %>

          <%# Stats strip %>
          <div style="display:flex;align-items:center;gap:16px;padding:2px 0 6px;">
            <%# The tally updates live as answers land; the breakdown below
                rebuilds on request. Only meaningful on the unsegmented view —
                a segment's count comes from its own filtered scope, which a
                broadcast carrying whole-Verto totals would contradict. %>
            <% if @active_segment && @active_segment[:id] != "overall" %>
              <div style="display:flex;align-items:baseline;gap:5px;">
                <span style="font-family:'Alata',sans-serif;font-size:34px;color:#01EACB;line-height:1;"><%= @total %></span>
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.35);">response<%= @total == 1 ? "" : "s" %></span>
              </div>
            <% else %>
              <%= turbo_stream_from(*ResultsActivity.stream_for(@survey)) %>
              <%= render "surveys/results_live",
                    survey: @survey, live: false,
                    **ResultsActivity.counts_for(@survey) %>
            <% end %>
            <% if @active_segment && @active_segment[:id] != "overall" %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);">of <%= @overall_total %> overall</span>
            <% end %>
            <div style="width:1px;height:20px;background:rgba(255,255,255,0.1);"></div>
            <% if @survey.published_at %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);">Published <%= @survey.published_at.strftime("%b %-d, %Y") %></span>
            <% end %>
            <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
              <%= link_to play_survey_url(@survey.publish_token),
                    style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);text-decoration:none;",
                    target: "_blank" do %>↗ Play link<% end %>

              <%# ── Download CSV (raw responses / aggregated summary) ── %>
              <% csv_item = "display:block;padding:8px 12px;border-radius:7px;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);text-decoration:none;white-space:nowrap;" %>
              <details class="results-export-menu" style="position:relative;">
                <summary style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);padding:5px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.12);white-space:nowrap;transition:all 0.15s;">⤓ Download CSV</summary>
                <div style="position:absolute;right:0;top:calc(100% + 6px);background:#272D4A;border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:6px;min-width:185px;z-index:30;box-shadow:0 10px 28px rgba(0,0,0,0.4);display:flex;flex-direction:column;">
                  <%= link_to "Raw responses (.csv)", survey_results_export_path(@survey, kind: "responses", segment: @active_segment[:id]),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                  <%= link_to "Summary (.csv)", survey_results_export_path(@survey, kind: "summary", segment: @active_segment[:id]),
                        data: { turbo: false }, style: csv_item,
                        onmouseover: "this.style.background='rgba(255,255,255,0.06)'", onmouseout: "this.style.background='transparent'" %>
                </div>
              </details>

              <%# ── Connect / Export to Google Sheets ── %>
              <% if google_sheets_configured? %>
                <% if Current.user&.google_connected? %>
                  <%= form_with url: survey_google_sheet_path(@survey, segment: @active_segment[:id]), method: :post,
                        data: { controller: "sheets-export", action: "submit->sheets-export#submit", turbo: false },
                        html: { style: "display:flex;align-items:center;gap:8px;margin:0;" } do %>
                    <button type="submit" data-sheets-export-target="button"
                            style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.32);padding:5px 12px;border-radius:8px;white-space:nowrap;transition:background 0.15s;"
                            onmouseover="this.style.background='rgba(1,234,203,0.2)'" onmouseout="this.style.background='rgba(1,234,203,0.12)'">Export to Google Sheets</button>
                    <span data-sheets-export-target="status" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.45);white-space:nowrap;"></span>
                  <% end %>
                <% else %>
                  <%= link_to "Connect Google Sheets", google_connect_path(survey_id: @survey.id, segment: @active_segment[:id]),
                        data: { turbo: false },
                        style: "font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.32);padding:5px 12px;border-radius:8px;text-decoration:none;white-space:nowrap;transition:background 0.15s;",
                        onmouseover: "this.style.background='rgba(1,234,203,0.2)'", onmouseout: "this.style.background='rgba(1,234,203,0.12)'" %>
                <% end %>
              <% end %>

              <%# ── AI Report: brief → generate → preview, edit in place, download
                  PDF, save to Google Drive. First open shows a 3-question brief
                  (goal / audience / length) that steers the AI away from a
                  generic, over-long report; the answers persist on the Verto so
                  regenerations reuse them. ── %>
              <div data-controller="report-export"
                   data-report-export-stream-url-value="<%= survey_results_report_stream_path(@survey) %>"
                   data-report-export-drive-url-value="<%= survey_google_drive_path(@survey) %>"
                   data-report-export-save-url-value="<%= survey_results_report_path(@survey) %>"
                   data-report-export-exists-value="<%= @survey.results_report.present? %>"
                   data-report-export-brief-value="<%= @survey.results_report_brief.presence || "{}" %>"
                   style="display:inline-flex;">
                <button type="button" data-action="click->report-export#open"
                        style="cursor:pointer;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#1C2034;background:#01EACB;border:none;padding:5px 14px;border-radius:8px;white-space:nowrap;font-weight:600;">✨ AI Report</button>

                <div class="report-modal hidden" data-report-export-target="modal" data-action="click->report-export#backdrop">
                  <div class="report-modal-card" data-action="click->report-export#stop">
                    <div class="report-modal-head">
                      <span>✨ AI Report</span>
                      <button type="button" class="report-modal-x" data-action="click->report-export#close" aria-label="Close">✕</button>
                    </div>
                    <div class="report-modal-body">
                      <div data-report-export-target="status" class="report-modal-status"></div>

                      <%# Report brief — three questions that guide the AI. %>
                      <div class="report-brief hidden" data-report-export-target="brief">
                        <div class="report-brief-intro">Three quick questions so the report says what you need — nothing generic, no padding.</div>
                        <label class="report-brief-field">
                          What should this report achieve?
                          <input type="text" data-report-export-target="goal"
                                 placeholder="e.g. Show our funder the programme's impact on confidence" />
                        </label>
                        <label class="report-brief-field">
                          Who will read it?
                          <input type="text" data-report-export-target="audience"
                                 placeholder="e.g. Board members with 5 minutes, not analysts" />
                        </label>
                        <label class="report-brief-field">
                          How long should it be?
                          <select data-report-export-target="length">
                            <option value="short">Short — about a page</option>
                            <option value="standard" selected>Standard — two to three pages</option>
                            <option value="detailed">Detailed — full breakdown</option>
                          </select>
                        </label>
                        <button type="button" class="report-foot-btn report-foot-primary" style="align-self:flex-start;"
                                data-action="click->report-export#generate">✨ Generate report</button>
                      </div>

                      <div data-report-export-target="body" class="report-doc"></div>
                      <textarea class="report-editor hidden" data-report-export-target="editor"
                                spellcheck="false" aria-label="Edit the report markdown"></textarea>
                    </div>
                    <div class="report-modal-foot">
                      <%# The PDF is built by a job (the render spikes 100-200MB), so this
                          asks for one and collects it when it's ready rather than holding
                          the request open for it. %>
                      <button type="button" class="report-foot-btn report-foot-primary"
                              data-action="click->report-export#downloadPdf"
                              data-report-export-target="pdfBtn"
                              data-report-export-pdf-url="<%= survey_report_renders_path(@survey) %>">⤓ Download PDF</button>
                      <% if google_sheets_configured? %>
                        <button type="button" class="report-foot-btn" data-action="click->report-export#saveDrive" data-report-export-target="driveBtn">Save to Google Drive</button>
                        <span class="report-foot-status" data-report-export-target="driveStatus"></span>
                      <% end %>
                      <button type="button" class="report-foot-btn hidden" data-action="click->report-export#edit" data-report-export-target="editBtn">✎ Edit</button>
                      <button type="button" class="report-foot-btn hidden" data-action="click->report-export#save" data-report-export-target="saveBtn">✓ Save changes</button>
                      <button type="button" class="report-foot-btn hidden" data-action="click->report-export#regenerate" data-report-export-target="regenBtn">↻ Regenerate</button>
                      <button type="button" class="report-foot-btn report-foot-close" data-action="click->report-export#close" style="margin-left:auto;">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%# OAuth round-trip feedback — flash isn't rendered on fullscreen pages %>
          <% if params[:google_connected] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(1,234,203,0.1);border:1px solid rgba(1,234,203,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#01EACB;">✓ Google connected. Click “Export to Google Sheets” to create your spreadsheet.</div>
          <% elsif params[:google_error] %>
            <div style="margin:0 0 10px;padding:9px 14px;border-radius:10px;background:rgba(255,30,111,0.1);border:1px solid rgba(255,30,111,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#FF6FA0;">Couldn’t connect to Google Sheets. Please try again.</div>
          <% end %>

          <%# Segment filter pills — only when this Verto has partner segments %>
          <% if @segments.size > 1 %>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:0 0 10px;">
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-right:2px;">View</span>
              <% @segments.each do |seg| %>
                <%= link_to survey_results_path(@survey, segment: seg[:id]),
                      class: "seg-pill", aria: { current: (seg[:id] == @active_segment[:id]).to_s } do %>
                  <%= seg[:label] %><span class="seg-pill-count"><%= seg[:count] %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>

        <%# ── Per-question cards ── %>
        <% @aggregated.each_with_index do |result, idx| %>
          <% type      = result[:type]
             card_data = result[:card]
             total_ans = result[:total]
             card_meta = card_type_meta(type)
             left_bg   = left_bg_for[type] || "linear-gradient(150deg,#0d3d22 0%,#051408 100%)" %>

          <div class="s-card" style="cursor:default;overflow:visible;">

            <div class="s-card-header" style="padding:9px 14px;gap:10px;">
              <span class="s-badge <%= card_meta[:badge_css] %>"><%= card_meta[:badge] %></span>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.3);">Card <%= idx + 1 %></span>
              <% if card_data["common_question_id"].present? %>
                <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:100px;background:rgba(97,91,245,0.18);color:#9d97ff;font-family:'Alata',sans-serif;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;"
                      title="<%= t('common_questions.badge_tooltip', default: 'From a Common Questions set') %>">
                  <%= t("common_questions.badge", default: "Common") %>
                </span>
              <% end %>
              <span style="margin-left:auto;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:<%= total_ans > 0 ? '#01EACB' : 'rgba(255,255,255,0.2)' %>;">
                <%= total_ans %> answer<%= total_ans == 1 ? "" : "s" %>
              </span>
            </div>

            <div style="display:grid;grid-template-columns:120px 1fr;min-height:0;">

              <div style="background:<%= left_bg %>;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 8px;gap:6px;border-bottom-left-radius:14px;">
                <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.3);text-align:center;line-height:1.4;"><%= card_meta[:q_label].downcase.capitalize %></span>
              </div>

              <div style="background:#fff;padding:14px 18px;display:flex;flex-direction:column;gap:10px;border-bottom-right-radius:14px;">
                <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:#111;line-height:1.45;font-weight:500;">
                  <%= card_data["text"] %>
                </div>

                <% if total_ans == 0 %>
                  <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(0,0,0,0.25);font-style:italic;">No responses yet</div>

                <% elsif type == "welcome_card" %>
                  <div style="display:flex;align-items:baseline;gap:5px;">
                    <span style="font-family:'Alata',sans-serif;font-size: var(--text-4xl);color:#01EACB;line-height:1;"><%= @total %></span>
                    <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(0,0,0,0.4);">respondent<%= @total == 1 ? "" : "s" %> started</span>
                  </div>

                <% elsif %w[multiple_choice yes_no select_one_grid select_many select_many_grid].include?(type) %>
                  <% counts = result[:counts]; grand = [counts.values.sum.to_f, 1.0].max %>
                  <div style="display:flex;flex-direction:column;gap:5px;">
                    <% counts.sort_by { |_, v| -v }.each do |label, count| %>
                      <% pct = ((count / grand) * 100).round %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;min-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= label %>"><%= label.truncate(20) %></span>
                        <div style="flex:1;height:7px;border-radius:4px;background:rgba(1,234,203,0.1);overflow:hidden;">
                          <div style="height:100%;border-radius:4px;background:#01EACB;width:<%= pct %>%;"></div>
                        </div>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.4);min-width:42px;text-align:right;"><%= count %> (<%= pct %>%)</span>
                      </div>
                    <% end %>
                  </div>

                <% elsif type == "prioritise" %>
                  <%# counts[label] = sum of ranks; mean position = sum / total.
                      Lower mean = higher priority, so sort ascending. %>
                  <% counts = result[:counts]; total = [result[:total].to_i, 1].max %>
                  <% ranked = counts.map { |label, sum| [label, sum.to_f / total] }.sort_by { |_, mean| mean } %>
                  <% n = [ranked.size, 1].max %>
                  <div style="display:flex;flex-direction:column;gap:5px;">
                    <% ranked.each_with_index do |(label, mean), i| %>
                      <% pct = (((n - mean + 1) / n.to_f) * 100).clamp(0, 100).round %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:#01EACB;min-width:18px;text-align:right;"><%= i + 1 %></span>
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;min-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= label %>"><%= label.truncate(24) %></span>
                        <div style="flex:1;height:7px;border-radius:4px;background:rgba(97,91,245,0.1);overflow:hidden;">
                          <div style="height:100%;border-radius:4px;background:#615BF5;width:<%= pct %>%;"></div>
                        </div>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.4);min-width:52px;text-align:right;">avg <%= mean.round(1) %></span>
                      </div>
                    <% end %>
                  </div>

                <% elsif %w[range nps].include?(type) %>
                  <% labels = Array(card_data["options"]).presence || (type == "nps" ? (0..10).map(&:to_s) : []) %>
                  <% n = [labels.size, 2].max; grand = [result[:counts].values.sum.to_f, 1.0].max %>
                  <div style="display:flex;flex-direction:column;gap:5px;">
                    <% n.times do |i| %>
                      <% count = result[:counts][i].to_i; label = labels[i] || "Step #{i + 1}"; pct = ((count / grand) * 100).round %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#111;min-width:100px;"><%= label.truncate(20) %></span>
                        <div style="flex:1;height:7px;border-radius:4px;background:rgba(1,234,203,0.1);overflow:hidden;">
                          <div style="height:100%;border-radius:4px;background:#01EACB;width:<%= pct %>%;"></div>
                        </div>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.4);min-width:42px;text-align:right;"><%= count %> (<%= pct %>%)</span>
                      </div>
                    <% end %>
                  </div>

                <% elsif type == "rating" %>
                  <% avg = result[:avg]; grand = [result[:counts].values.sum.to_f, 1.0].max %>
                  <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
                    <div style="font-size: var(--text-2xl);letter-spacing:2px;">
                      <% 5.times do |i| %><span style="color:<%= i < avg.round ? '#FFCC00' : 'rgba(0,0,0,0.12)' %>"><%= i < avg.round ? "★" : "☆" %></span><% end %>
                    </div>
                    <span style="font-family:'Alata',sans-serif;font-size: var(--text-3xl);color:#01EACB;line-height:1;"><%= avg %></span>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:3px;">
                    <% (5).downto(1) do |star| %>
                      <% count = result[:counts][star].to_i; pct = ((count / grand) * 100).round %>
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);min-width:24px;"><%="★" * star %></span>
                        <div style="flex:1;height:5px;border-radius:3px;background:rgba(1,234,203,0.1);overflow:hidden;">
                          <div style="height:100%;border-radius:3px;background:#FFCC00;width:<%= pct %>%;"></div>
                        </div>
                        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.35);min-width:28px;text-align:right;"><%= count %></span>
                      </div>
                    <% end %>
                  </div>

                <% elsif type == "tap_card" %>
                  <div style="display:flex;flex-direction:column;gap:8px;">
                    <% result[:counts].each do |label, dirs| %>
                      <% yes_c = dirs["yes"].to_i; no_c = dirs["no"].to_i; unsure_c = dirs["unsure"].to_i %>
                      <% tot = [(yes_c + no_c + unsure_c).to_f, 1.0].max %>
                      <% yes_pct = ((yes_c / tot) * 100).round; no_pct = ((no_c / tot) * 100).round; uns_pct = ((unsure_c / tot) * 100).round %>
                      <div>
                        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.45);margin-bottom:3px;"><%= label.truncate(55) %></div>
                        <div style="display:flex;height:18px;border-radius:5px;overflow:hidden;">
                          <div style="background:#01EACB;width:<%= yes_pct %>%;display:flex;align-items:center;justify-content:center;">
                            <% if yes_pct > 15 %>
                              <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:#1C2034;"><%= yes_pct %>% Yes</span>
                            <% end %>
                          </div>
                          <div style="background:#F5A623;width:<%= uns_pct %>%;display:flex;align-items:center;justify-content:center;">
                            <% if uns_pct > 15 %>
                              <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:#1C2034;"><%= uns_pct %>% Unsure</span>
                            <% end %>
                          </div>
                          <div style="background:#D80027;flex:1;display:flex;align-items:center;justify-content:center;">
                            <% if no_pct > 15 %>
                              <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:white;"><%= no_pct %>% No</span>
                            <% end %>
                          </div>
                        </div>
                        <div style="display:flex;justify-content:space-between;margin-top:2px;gap:8px;">
                          <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:#01EACB;">Yes · <%= yes_c %></span>
                          <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:#C77F12;">Unsure · <%= unsure_c %></span>
                          <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);color:#D80027;">No · <%= no_c %></span>
                        </div>
                      </div>
                    <% end %>
                  </div>

                <% elsif type == "open_ended" %>
                  <div style="display:flex;flex-direction:column;gap:4px;max-height:160px;overflow-y:auto;">
                    <% result[:texts].first(20).each do |text| %>
                      <div style="padding:7px 11px;border-radius:7px;background:rgba(0,0,0,0.03);border-left:2px solid rgba(1,234,203,0.25);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#111;line-height:1.5;">
                        <%= text.truncate(200) %>
                      </div>
                    <% end %>
                    <% if result[:texts].size > 20 %>
                      <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.3);padding:3px 11px;">+ <%= result[:texts].size - 20 %> more</div>
                    <% end %>
                  </div>

                <% end %>

                <% if result[:other_texts].present? %>
                  <div style="margin-top:4px;padding-top:8px;border-top:1px solid rgba(0,0,0,0.06);">
                    <div style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);letter-spacing:0.1em;text-transform:uppercase;color:rgba(0,0,0,0.4);margin-bottom:5px;">Other · <%= result[:other_texts].size %> free-text</div>
                    <div style="display:flex;flex-direction:column;gap:4px;max-height:160px;overflow-y:auto;">
                      <% result[:other_texts].first(20).each do |text| %>
                        <div style="padding:7px 11px;border-radius:7px;background:rgba(0,0,0,0.03);border-left:2px solid rgba(255,30,111,0.3);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:#111;line-height:1.5;">
                          <%= text.truncate(200) %>
                        </div>
                      <% end %>
                      <% if result[:other_texts].size > 20 %>
                        <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(0,0,0,0.3);padding:3px 11px;">+ <%= result[:other_texts].size - 20 %> more</div>
                      <% end %>
                    </div>
                  </div>
                <% end %>

              </div><%# end right panel %>
            </div><%# end grid %>
          </div><%# end s-card %>
        <% end %><%# end per-question cards loop %>

        <% end %><%# end results-feed turbo-frame %>

      </div>
    </div><%# end scrollable feed %>

  </div><%# end middle column %>

  <%# ── Chat panel ── %>
  <div style="width:320px;flex-shrink:0;border-left:1px solid rgba(255,255,255,0.07);background:#161B2E;display:flex;flex-direction:column;overflow:hidden;position:relative;z-index:1;"
       data-controller="results-chat"
       data-results-chat-url-value="<%= survey_chat_path(@survey) %>"
       data-results-chat-theme-value="<%= @survey.theme.to_s.gsub('"', '&quot;') %>">

    <%# Chat header %>
    <div style="flex-shrink:0;padding:16px 18px 12px;border-bottom:1px solid rgba(255,255,255,0.07);">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-md);color:#fff;letter-spacing:0.03em;">Ask Verto</span>
        <span style="margin-left:auto;font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.25);background:rgba(1,234,203,0.12);border:1px solid rgba(1,234,203,0.2);border-radius:20px;padding:2px 8px;">AI</span>
      </div>
      <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);margin:6px 0 0;line-height:1.5;">Ask questions about your Verto results</p>
    </div>

    <%# Messages area %>
    <div data-results-chat-target="messages"
         style="flex:1;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:0;">
    </div>

    <%# Input area %>
    <div style="flex-shrink:0;border-top:1px solid rgba(255,255,255,0.07);padding:12px 12px;">
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <textarea data-results-chat-target="input"
                  data-action="keydown->results-chat#keydown"
                  placeholder="Ask about your results…"
                  rows="2"
                  style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:9px 12px;color:rgba(255,255,255,0.8);font-family:'ABeeZee',sans-serif;font-size: var(--text-md);resize:none;outline:none;line-height:1.5;"
                  onfocus="this.style.borderColor='rgba(1,234,203,0.4)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
        <button data-results-chat-target="sendBtn"
                data-action="click->results-chat#send"
                style="flex-shrink:0;width:36px;height:36px;border-radius:10px;background:#01EACB;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;"
                onmouseover="this.style.background='#00C4AB'"
                onmouseout="this.style.background='#01EACB'">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M7 1l6 6-6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

  </div><%# end chat panel %>

</div><%# end outer shell %>
