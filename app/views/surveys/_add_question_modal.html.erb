<%# Add Question modal — triggered by the "Add question" button in the cards feed.
    The controller (add-question) is scoped to the root editor div in show.html.erb. %>

<div class="aq-modal-backdrop"
     data-add-question-target="backdrop"
     data-action="click->add-question#backdropClick"
     hidden>

  <div class="aq-modal" data-add-question-target="modal">

    <%# ── Modal header (shared across all steps) ── %>
    <div class="media-modal-head">
      <div class="media-modal-title" data-add-question-target="modalTitle">Add new question</div>
      <button type="button" class="media-modal-close"
              data-action="click->add-question#close"
              aria-label="Close">✕</button>
    </div>

    <%# ════════════════════════════════════════════
        STEP 1 — Choice: Generate vs Start from Blank
        ════════════════════════════════════════════ %>
    <div class="aq-step" data-add-question-target="stepChoice">
      <div class="aq-modal-body">
        <div class="aq-choice-grid">

          <button type="button"
                  class="aq-choice-card"
                  data-action="click->add-question#chooseGenerate">
            <div class="aq-choice-icon">✨</div>
            <div class="aq-choice-name">Generate new question</div>
            <div class="aq-choice-desc">
              AI creates a question tailored to your survey's brief and existing questions
            </div>
          </button>

          <button type="button"
                  class="aq-choice-card"
                  data-action="click->add-question#chooseBlank">
            <div class="aq-choice-icon">✏</div>
            <div class="aq-choice-name">Start from blank</div>
            <div class="aq-choice-desc">
              Pick a question type and fill in the details yourself
            </div>
          </button>

          <%# Only offered when the org actually has saved questions — an empty
              library tile that leads to an empty list is worse than no tile. %>
          <% library_sets = accessible_common_question_sets.select { |s| s.common_questions.any? } %>
          <% if library_sets.any? %>
            <button type="button"
                    class="aq-choice-card"
                    data-add-question-target="libraryChoice"
                    data-action="click->add-question#chooseLibrary">
              <div class="aq-choice-icon">📚</div>
              <div class="aq-choice-name">From your library</div>
              <div class="aq-choice-desc">
                Reuse a saved Common Question so results line up across Vertos
              </div>
            </button>
          <% end %>

        </div>

        <%# ── Demographic questions ──
            One-click inserts from the DemographicQuestions registry — the
            core tail trio (age / location / gender, for a creator who deleted
            one and wants it back) and the opt-in pair — appended at the END
            of the deck (the demographics convention). One of each per Verto:
            tiles grey out once the deck has the key (key_for reads keyless
            legacy tail cards too) — server-rendered for first paint,
            re-synced client-side on open. The GDPR wall is scoped to
            NEURODIVERSITY: age, location, gender and heritage may sit beside
            a contact form; the health-adjacent question may not — said here
            rather than discovered at the save. %>
        <div class="aq-section-label">Demographics</div>
        <% contact_wall = @survey.contact_form_enabled? %>
        <% if contact_wall %>
          <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:#F5A623;line-height:1.45;margin:0 0 10px;">
            This Verto collects contact details, so it can't also ask the
            neurodiversity question — turn the contact form off in Publish &amp; share first.
          </div>
        <% end %>
        <div class="aq-choice-grid">
          <%# The Heritage tile says which taxonomy it will insert, because the
              audience country that decides it lives in a different panel — a
              creator would otherwise never learn the setting exists. %>
          <% heritage_desc =
               if @survey.audience_country.present?
                 "Ethnic or cultural background, tailored to #{@survey.audience_country_name} — added to the end of your Verto"
               else
                 "Ethnic or cultural background — optional question added to the end of your Verto. Set an audience country in Publish & share to tailor it."
               end %>
          <% deck_keys = Array(@survey.cards).filter_map { |c| DemographicQuestions.key_for(c) } %>
          <% [["age", "🎂", "Age",
               "Birth month and year — powers the age lens on results. Added to the end of your Verto."],
              ["location", "📍", "Location",
               "Where they live — powers the regions map and comparisons. Added to the end of your Verto."],
              ["gender", "🚻", "Gender",
               "With Non-binary, Other and Prefer not to say — added to the end of your Verto."],
              ["heritage", "👥", "Heritage", heritage_desc],
              ["neurodiversity", "🧠", "Neurodiversity",
               "How people think and process information — optional, never framed around disability"]].each do |key, icon, name, desc| %>
            <% walled = contact_wall && key == "neurodiversity" %>
            <button type="button"
                    class="aq-choice-card aq-demographic-tile"
                    data-add-question-target="demographicTile"
                    data-demographic-key="<%= key %>"
                    data-contact-wall="<%= walled %>"
                    data-action="click->add-question#addDemographic"
                    <%= "disabled" if walled || deck_keys.include?(key) %>>
              <div class="aq-choice-icon"><%= icon %></div>
              <div class="aq-choice-name"><%= name %></div>
              <div class="aq-choice-desc"><%= desc %></div>
            </button>
          <% end %>
        </div>

        <%# Error message shown if generation fails %>
        <div data-add-question-target="errorMsg"
             style="display:none;color:#FF1E6F;font-size: var(--text-sm);text-align:center;padding:8px 0;">
        </div>
      </div>
    </div>

    <%# ════════════════════════════════════════════
        STEP: Generating — loading state
        ════════════════════════════════════════════ %>
    <div class="aq-step" data-add-question-target="stepGenerating" hidden>
      <div class="aq-modal-body aq-loading-body">
        <div class="aq-spinner"></div>
        <div class="aq-loading-text">Generating a question…</div>
        <div class="aq-loading-sub">Claude is crafting a question that fits your brief</div>
      </div>
    </div>

    <%# ════════════════════════════════════════════
        STEP L — Pick a saved Common Question
        Each tile carries the whole card payload; picking one posts it straight
        to render_card, the same endpoint the blank path uses. The
        common_question_id / _set_id ride along so results still aggregate this
        question across every Verto that reuses it.
        ════════════════════════════════════════════ %>
    <div class="aq-step" data-add-question-target="stepLibrary" hidden>
      <div class="aq-modal-body">
        <% accessible_common_question_sets.each do |set| %>
          <% next if set.common_questions.empty? %>
          <div class="aq-library-set">
            <div class="aq-library-set-name">
              <%= set.name %>
              <% if set.organisation_id != Current.organisation.id %>
                <span class="aq-library-set-org">shared by <%= set.organisation.name %></span>
              <% end %>
            </div>
            <div class="aq-library-list">
              <% set.common_questions.sort_by(&:position).each do |question| %>
                <button type="button"
                        class="aq-library-item"
                        data-add-question-target="libraryItem"
                        data-card="<%= question.to_card.to_json %>"
                        data-action="click->add-question#pickLibraryQuestion">
                  <span class="aq-library-item-type"><%= CardTypes.meta(question.card_type)["picker_icon"] %></span>
                  <span class="aq-library-item-text"><%= question.text %></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="media-modal-foot">
        <button type="button" class="media-btn-ghost"
                data-action="click->add-question#backToChoice">← Back</button>
      </div>
    </div>

    <%# ════════════════════════════════════════════
        STEP B-1 — Pick question type
        ════════════════════════════════════════════ %>
    <div class="aq-step" data-add-question-target="stepPickType" hidden>
      <div class="aq-modal-body">
        <div class="aq-type-grid">
          <% CardTypes.pickable_for(@survey).each do |key, t| %>
            <button type="button"
                    class="aq-type-tile"
                    data-type="<%= key %>"
                    data-add-question-target="typeTile"
                    data-action="click->add-question#selectType">
              <div class="aq-type-tile-preview">
                <%= mini_preview_html({ "type" => key, "options" => [] }) %>
              </div>
              <div class="aq-type-tile-icon"><%= t["picker_icon"] %></div>
              <div class="aq-type-tile-name"><%= t["picker_name"] %></div>
              <div class="aq-type-tile-desc"><%= t["picker_desc"] %></div>
            </button>
          <% end %>
        </div>
      </div>
      <div class="media-modal-foot">
        <button type="button" class="media-btn-ghost"
                data-action="click->add-question#backToChoice">← Back</button>
      </div>
    </div>

    <%# ════════════════════════════════════════════
        STEP B-2 — Fill in question details
        ════════════════════════════════════════════ %>
    <div class="aq-step" data-add-question-target="stepDetails" hidden>
      <div class="aq-modal-body">

        <%# Selected type badge %>
        <div class="aq-selected-type" data-add-question-target="selectedTypeDisplay"></div>

        <%# Question text %>
        <div class="aq-field-group">
          <label class="aq-field-label">Question text</label>
          <input type="text"
                 class="aq-text-input"
                 placeholder="Enter question here"
                 maxlength="100"
                 autocomplete="off"
                 data-add-question-target="questionText"
                 data-action="input->add-question#onTextInput" />
          <div class="aq-char-hint" data-add-question-target="charCount">0 / 100</div>
        </div>

        <%# Options list (shown for choice types) %>
        <div data-add-question-target="optionsArea" hidden>
          <div class="aq-field-label aq-options-label">Answer options</div>
          <div class="aq-options-list" data-add-question-target="optionsList"></div>
        </div>

        <%# Scale labels (shown for range / rating types) %>
        <div data-add-question-target="labelsArea" hidden>
          <div class="aq-field-label" style="margin-bottom:8px;">Scale labels</div>
          <div class="aq-labels-row">
            <div class="aq-field-group" style="flex:1;">
              <label class="aq-field-label-sm">Low end</label>
              <input type="text" class="aq-text-input"
                     data-add-question-target="minLabel"
                     autocomplete="off" />
            </div>
            <div class="aq-field-group" style="flex:1;">
              <label class="aq-field-label-sm">High end</label>
              <input type="text" class="aq-text-input"
                     data-add-question-target="maxLabel"
                     autocomplete="off" />
            </div>
          </div>
        </div>

      </div>

      <%# Inline validation/error for this step (e.g. empty question text). %>
      <div data-add-question-target="detailsError"
           style="display:none;color:#FF1E6F;font-size: var(--text-sm);padding:0 20px 4px;">
      </div>

      <div class="media-modal-foot">
        <button type="button" class="media-btn-ghost"
                data-action="click->add-question#backToPickType">← Back</button>
        <button type="button" class="media-btn-primary"
                data-add-question-target="addBtn"
                data-action="click->add-question#addToSurvey">Add to survey →</button>
      </div>
    </div>

  </div><%# /aq-modal %>
</div><%# /aq-modal-backdrop %>
