<%
  archived    = local_assigns[:archived] == true
  # publish_token alone no longer means "live" — it survives an unpublish so the
  # link can be restored, so the live test has to be Survey#published?.
  published   = survey.published? && !archived
  unpublished = survey.unpublished? && !archived
  # Counts come from the controller's grouped queries (no responses loaded). Fall
  # back to the cheap SQL methods if a card is ever rendered outside the index.
  resp_count  = (@completed_counts || {})[survey.id] || survey.responses.where(status: "completed").count
  q_count     = Array(survey.cards).count { |c| CardTypes.question?(c["type"]) }
  # Whether anyone has answered — the same test Survey#closed? makes, but read
  # off the index's grouped counts so the dashboard doesn't fire a query per tile.
  has_responses = @response_counts ? (@response_counts[survey.id].to_i.positive?) : survey.responses.exists?
  # Response stats belong to any Verto that has ever been open, not just a live
  # one: a closed Verto keeps its results and the tile should still show them.
  ever_open   = (published || unpublished)
  responders  = ever_open ? ((@responder_counts || {})[survey.id] || survey.responders_count) : 0
  completion  =
    if ever_open && responders.to_i.positive?
      done = (@responder_completed_counts || {})[survey.id] || survey.responses.where(answered: true, status: "completed").count
      (done * 100.0 / responders).round
    end

  if archived
    accent_bg     = "rgba(255,255,255,0.05)"
    border        = "rgba(255,255,255,0.06)"
    border_hover  = "rgba(255,255,255,0.14)"
    top_bar       = "rgba(255,255,255,0.08)"
    badge_bg      = "rgba(255,255,255,0.08)"
    badge_color   = "rgba(255,255,255,0.5)"
    badge_text    = t("dashboard_card.badge_archived")
  elsif published
    accent_bg     = "rgba(255,255,255,0.03)"
    border        = "rgba(255,30,111,0.22)"
    border_hover  = "rgba(255,30,111,0.5)"
    top_bar       = "linear-gradient(90deg,#FF1E6F,#01EACB)"
    badge_bg      = "#FF1E6F"
    badge_color   = "#fff"
    badge_text    = t("dashboard_card.badge_live")
  elsif unpublished
    # Taken off /play. "Closed" once it has responses (results kept, deck frozen
    # for good); otherwise it really is a draft again, so it says so.
    accent_bg     = "rgba(255,255,255,0.03)"
    border        = "rgba(255,194,75,0.22)"
    border_hover  = "rgba(255,194,75,0.5)"
    top_bar       = "linear-gradient(90deg,#FFC24B,#615BF5)"
    badge_bg      = "rgba(255,194,75,0.18)"
    badge_color   = "#FFC24B"
    badge_text    = has_responses ? t("dashboard_card.badge_closed") : t("dashboard_card.badge_draft")
  else
    accent_bg     = "rgba(255,255,255,0.03)"
    border        = "rgba(255,255,255,0.07)"
    border_hover  = "rgba(12,167,255,0.45)"
    top_bar       = "linear-gradient(90deg,#0CA7FF,#615BF5)"
    badge_bg      = "rgba(12,167,255,0.18)"
    badge_color   = "#0CA7FF"
    badge_text    = t("dashboard_card.badge_draft")
  end

  # Title first, theme second. The wizard already promises the name the creator
  # types is what the Verto is called (surveys/new), and the editor can now
  # rename it — reading `theme` first meant a rename appeared to do nothing.
  # `theme` stays the AI brief's subject, and the fallback for older Vertos
  # created before the name field existed.
  verto_name   = survey.title.presence || survey.theme.presence || t("dashboard_card.fallback_name")
  publish_warning = t("dashboard_card.publish_warning", title: verto_name)
  delete_warning = t("dashboard_card.delete_warning", title: verto_name)
  delete_forever_warning = t("dashboard_card.delete_forever_warning", title: verto_name)

  # Cover image — prefer the welcome card's left-panel art, else fall back to
  # the first card with any image. Gives each tile a distinct, recognisable
  # face matching what respondents see when they open the Verto.
  cover_cards  = Array(survey.cards)
  welcome_card = cover_cards.find { |c| c["type"].to_s == "welcome_card" }
  cover_image  = welcome_card&.dig("image").presence ||
                 cover_cards.map { |c| c["image"] }.find(&:present?)
%>

<div class="dashboard-card" style="position:relative;border-radius:18px;background:<%= accent_bg %>;border:1px solid <%= border %>;display:flex;flex-direction:column;overflow:hidden;transition:border-color 0.2s,transform 0.2s,box-shadow 0.2s;<%= 'opacity:0.78;' if archived %>"
     onmouseover="this.style.borderColor='<%= border_hover %>';this.style.transform='translateY(-2px)';this.style.boxShadow='0 10px 30px rgba(0,0,0,0.28)'"
     onmouseout="this.style.borderColor='<%= border %>';this.style.transform='';this.style.boxShadow=''">

  <% if current_membership&.admin? %>
    <label class="dashboard-card__select" style="position:absolute;top:10px;right:10px;z-index:2;display:none;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:rgba(12,15,30,0.7);border:1px solid rgba(255,255,255,0.18);cursor:pointer;backdrop-filter:blur(6px);">
      <input type="checkbox"
             data-bulk-select-target="checkbox"
             data-action="bulk-select#update"
             data-survey-id="<%= survey.id %>"
             style="margin:0;width:14px;height:14px;cursor:pointer;accent-color:#01EACB;">
    </label>
  <% end %>

  <div style="height:3px;background:<%= top_bar %>;flex-shrink:0;"></div>

  <% if cover_image.present? %>
    <div style="position:relative;height:120px;background-image:url('<%= cover_image %>');background-size:cover;background-position:center;flex-shrink:0;<%= 'filter:grayscale(0.4);' if archived %>">
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(28,32,52,0.35) 0%,rgba(28,32,52,0) 40%,rgba(28,32,52,0.55) 100%);"></div>
      <div style="position:absolute;top:10px;left:12px;right:12px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
        <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
          <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:3px 9px;border-radius:100px;background:<%= badge_bg %>;color:<%= badge_color %>;backdrop-filter:blur(4px);">
            <%= badge_text %>
          </span>
          <%= render "surveys/ask_verto_badge", survey: survey %>
          <%= render "surveys/sdg_chips", survey: survey %>
        </span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.85);text-shadow:0 1px 2px rgba(0,0,0,0.4);">
          <% if archived && survey.deleted_at %>
            <%= t("dashboard_card.deleted_on", date: survey.deleted_at.strftime("%-d %b %Y")) %>
          <% else %>
            <%= survey.updated_at.strftime("%-d %b %Y") %>
          <% end %>
        </span>
      </div>
    </div>
  <% else %>
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px 0;">
      <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:3px 9px;border-radius:100px;background:<%= badge_bg %>;color:<%= badge_color %>;">
          <%= badge_text %>
        </span>
        <%= render "surveys/ask_verto_badge", survey: survey %>
        <%= render "surveys/sdg_chips", survey: survey %>
      </span>
      <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.4);">
        <% if archived && survey.deleted_at %>
          <%= t("dashboard_card.deleted_on", date: survey.deleted_at.strftime("%-d %b %Y")) %>
        <% else %>
          <%= survey.updated_at.strftime("%-d %b %Y") %>
        <% end %>
      </span>
    </div>
  <% end %>

  <div style="padding:12px 16px 14px;flex:1;">
    <div style="font-family:'Alata',sans-serif;font-size: var(--text-2xl);color:#fff;line-height:1.25;margin-bottom:4px;">
      <%= survey.theme.presence&.truncate(48) || survey.title.presence&.truncate(48) || t("dashboard_card.untitled") %>
    </div>
    <% if survey.title.present? && survey.title != survey.theme %>
      <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-base);color:rgba(255,255,255,0.4);line-height:1.4;">
        <%= survey.title.truncate(60) %>
      </div>
    <% end %>
  </div>

  <% if published %>
    <div style="display:flex;align-items:center;border-top:1px solid rgba(255,255,255,0.05);margin:0 16px;padding:10px 0;">
      <div style="flex:1;display:flex;align-items:baseline;gap:5px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xl);color:<%= responders > 0 ? '#01EACB' : 'rgba(255,255,255,0.2)' %>;line-height:1;"><%= responders %></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.3);"><%= t("dashboard_card.responders", count: responders) %></span>
      </div>
      <div style="display:flex;align-items:baseline;gap:5px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xl);color:<%= completion.nil? ? 'rgba(255,255,255,0.2)' : '#01EACB' %>;line-height:1;"><%= completion.nil? ? "—" : "#{completion}%" %></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.3);"><%= t("dashboard_card.completion") %></span>
      </div>
      <div style="display:flex;align-items:baseline;gap:5px;margin-left:14px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xl);color:rgba(255,255,255,0.4);line-height:1;"><%= q_count %></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.25);"><%= t("dashboard_card.questions", count: q_count) %></span>
      </div>
    </div>
  <% else %>
    <div style="display:flex;align-items:center;gap:0;border-top:1px solid rgba(255,255,255,0.05);margin:0 16px;padding:10px 0;">
      <div style="flex:1;display:flex;align-items:baseline;gap:5px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xl);color:<%= resp_count > 0 ? '#01EACB' : 'rgba(255,255,255,0.2)' %>;line-height:1;"><%= resp_count %></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.3);"><%= t("dashboard_card.responses", count: resp_count) %></span>
      </div>
      <div style="display:flex;align-items:baseline;gap:5px;">
        <span style="font-family:'Alata',sans-serif;font-size: var(--text-xl);color:rgba(255,255,255,0.4);line-height:1;"><%= q_count %></span>
        <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);color:rgba(255,255,255,0.25);"><%= t("dashboard_card.questions", count: q_count) %></span>
      </div>
    </div>
  <% end %>

  <% if archived %>
    <div class="dash-card-actions" style="display:flex;align-items:center;gap:8px;padding:10px 16px 12px;">
      <%= link_to t("dashboard_card.view_results"), survey_results_path(survey),
            style: "flex:1;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);text-decoration:none;" %>
      <%# Archiving was always reversible — deleted_at is a soft flag and the
          kept/archived scopes have been there all along. There was simply no way
          back from the UI, so a mis-click was effectively permanent. %>
      <% if current_membership&.admin? %>
        <%= button_to t("dashboard_card.restore"), restore_survey_path(survey), method: :post,
              form: { style: "flex:1;display:flex;margin:0;" },
              style: "flex:1;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(1,234,203,0.14);border:1px solid rgba(1,234,203,0.32);color:#01EACB;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;white-space:nowrap;" %>
      <% end %>
    </div>
    <% if current_membership&.admin? %>
      <div style="padding:0 16px 12px;display:flex;justify-content:flex-end;">
        <%= button_to t("dashboard_card.delete_forever"), destroy_forever_survey_path(survey), method: :delete,
              data: { turbo_confirm: delete_forever_warning },
              form: { style: "margin:0;" },
              style: "background:none;border:none;padding:4px 8px;color:rgba(255,107,131,0.7);font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);cursor:pointer;text-decoration:underline;text-underline-offset:3px;" %>
      </div>
    <% end %>
  <% else %>
    <%# Sharing is what a creator came to a live Verto to do — collecting
        responses is the point of publishing one, and nothing happens until the
        link is in front of somebody. So it leads, at full width, and Edit and
        Results step down to the row below it. Only for a live Verto: a draft's
        link doesn't resolve yet, so Publish stays its primary action.

        data-panel-url, not data-share-url: inside the panel that attribute
        already means the /play link being handed to the OS share sheet. %>
    <%# dash-card-actions is a phone hook only (M-STUDIO block): on ≤767px it
        raises these rows' links/buttons to 44px touch targets. No desktop CSS. %>
    <%# Every role gets the Share button: the panel behind it is read-only for
        anyone who isn't an admin (SurveyLinksController#show), and handing
        the link on is the one thing every seat — a viewer above all — is
        here to do. %>
    <% if published %>
      <div class="dash-card-actions" style="padding:10px 16px 0;">
        <button type="button"
                data-action="click->share-modal#open"
                data-panel-url="<%= share_survey_path(survey) %>"
                style="display:block;width:100%;box-sizing:border-box;text-align:center;padding:11px 12px;border-radius:12px;background:#FF1E6F;border:none;color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.03em;cursor:pointer;box-shadow:0 8px 20px rgba(255,30,111,0.28);transition:filter 0.15s,transform 0.15s;"
                onmouseover="this.style.filter='brightness(1.08)';this.style.transform='translateY(-1px)'"
                onmouseout="this.style.filter='';this.style.transform=''"><%= t("dashboard_card.share") %></button>
      </div>
    <% end %>

    <%# Edit and Publish are the editing doors, so a viewer isn't shown them
        (SurveysController refuses both on the same can_edit_vertos? answer).
        Results is for everyone. The row is skipped entirely when a viewer
        would have nothing in it — a plain draft — rather than drawn empty. %>
    <% has_results = published || (unpublished && has_responses) %>
    <% if can_edit_vertos? || has_results %>
    <div class="dash-card-actions" style="display:flex;align-items:center;gap:8px;padding:10px 16px 0;">
      <% if can_edit_vertos? %>
        <%= link_to t("dashboard_card.edit"), survey_path(survey),
              style: "flex:1;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.75);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);text-decoration:none;transition:all 0.15s;white-space:nowrap;",
              onmouseover: "this.style.color='white';this.style.background='rgba(255,255,255,0.1)'",
              onmouseout:  "this.style.color='rgba(255,255,255,0.75)';this.style.background='rgba(255,255,255,0.05)'" %>
      <% end %>

      <%# A closed Verto keeps its results, so it offers Results rather than
          Publish — re-publishing lives in the editor's Status panel, behind a
          confirm that explains the link comes back. %>
      <% if has_results %>
        <%= link_to t("dashboard_card.results"), survey_results_path(survey),
              style: "flex:1;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(255,30,111,0.14);border:1px solid rgba(255,30,111,0.32);color:#FF1E6F;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);text-decoration:none;transition:all 0.15s;white-space:nowrap;",
              onmouseover: "this.style.background='rgba(255,30,111,0.22)'",
              onmouseout:  "this.style.background='rgba(255,30,111,0.14)'" %>
      <% else %>
        <%= button_to t("dashboard_card.publish"), publish_survey_path(survey),
              method: :post,
              style: "flex:1;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(1,234,203,0.14);border:1px solid rgba(1,234,203,0.32);color:#01EACB;font-family:'ABeeZee',sans-serif;font-size: var(--text-base);cursor:pointer;transition:all 0.15s;white-space:nowrap;",
              form: { style: "flex:1;display:flex;", data: { turbo_confirm: publish_warning } },
              onmouseover: "this.style.background='rgba(1,234,203,0.22)'",
              onmouseout:  "this.style.background='rgba(1,234,203,0.14)'" %>
      <% end %>
    </div>
    <% end %>

    <div class="dash-card-actions" style="padding:8px 16px 12px;">
      <%= link_to "▶ #{t("dashboard_card.preview")}", preview_survey_path(survey),
            style: "display:block;width:100%;box-sizing:border-box;text-align:center;padding:9px 12px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.75);font-family:'ABeeZee',sans-serif;font-size: var(--text-base);text-decoration:none;transition:all 0.15s;",
            onmouseover: "this.style.color='white';this.style.background='rgba(255,255,255,0.1)'",
            onmouseout:  "this.style.color='rgba(255,255,255,0.75)';this.style.background='rgba(255,255,255,0.05)'" %>
    </div>

    <%# Duplicate is a creation door, so it goes for a managed account. Without
        it the row has one child, and space-between would strand Delete on the
        left — so the justification follows what's actually rendered. %>
    <div style="padding:0 16px 12px;display:flex;align-items:center;justify-content:<%= can_create_vertos? ? 'space-between' : 'flex-end' %>;">
      <% if can_create_vertos? %>
        <%= button_to t("dashboard_card.duplicate"), duplicate_survey_path(survey), method: :post,
              form: { style: "margin:0;" },
              style: "background:none;border:none;padding:4px 8px;color:rgba(255,255,255,0.35);font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);cursor:pointer;text-decoration:underline;text-underline-offset:3px;" %>
      <% end %>
      <% if current_membership&.admin? %>
        <%= button_to t("dashboard_card.delete"), survey_path(survey), method: :delete,
              data: { turbo_confirm: delete_warning },
              form: { style: "margin:0;" },
              style: "background:none;border:none;padding:4px 8px;color:rgba(255,255,255,0.35);font-family:'ABeeZee',sans-serif;font-size: var(--text-xs);cursor:pointer;text-decoration:underline;text-underline-offset:3px;" %>
      <% end %>
    </div>
  <% end %>
</div>
