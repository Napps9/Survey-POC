<% content_for :head do %>
  <style>
    body { overflow: auto !important; height: auto !important; }
    .is-selecting .dashboard-card__select { display: flex !important; }
    .is-selecting .dashboard-card:has(input[data-bulk-select-target="checkbox"]:checked) {
      border-color: #01EACB !important;
      box-shadow: 0 0 0 1px #01EACB inset;
    }
  </style>
<% end %>
<%
  published = @surveys.select { |s| s.publish_token.present? }
  drafts    = @surveys.reject { |s| s.publish_token.present? }
  archived  = @archived_surveys || []

  # Responder-based dashboard: count people who answered at least one question
  # (not everyone who merely opened a Verto), and read completion as the share
  # of those responders who finished — the same basis the Verto cards use, so
  # the summary strip and the cards below always tell one consistent story.
  total_responders     = @surveys.sum { |s| (@responder_counts || {})[s.id].to_i }
  completed_responders = @surveys.sum { |s| (@responder_completed_counts || {})[s.id].to_i }
  completion_rate      = total_responders.positive? ? ((completed_responders.to_f / total_responders) * 100).round : nil
%>

<%
  google_form_error       = flash[:reopen_google_form_modal] && flash[:alert].present? ? flash[:alert] : nil
  open_google_form_modal  = google_form_error.present? || params[:open_import].present?
%>

<div style="display:flex;min-height:100vh;background:#1C2034;">
  <div style="flex:1;display:flex;flex-direction:column;min-width:0;"
       data-controller="create-menu"
       data-create-menu-reopen-value="<%= open_google_form_modal %>"
       data-action="keydown.esc@window->create-menu#closeOnEsc">

    <%# ── Hero ── %>
    <div style="position:relative;overflow:hidden;padding:32px 36px 40px;border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;">
      <div class="gen-orbs" style="opacity:0.28;">
        <div class="gen-orb gen-orb-2"></div>
        <div class="gen-orb gen-orb-3"></div>
        <div class="gen-orb gen-orb-4"></div>
      </div>

      <div style="position:relative;z-index:1;">
        <div style="display:flex;justify-content:center;margin-bottom:28px;">
          <%= render "shared/dashboard_tabs", active: :vertos %>
        </div>
        <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px;">
          <div style="min-width:0;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
              <span style="width:8px;height:8px;border-radius:50%;background:#01EACB;box-shadow:0 0 12px rgba(1,234,203,0.7);"></span>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.45);letter-spacing:0.12em;text-transform:uppercase;"><%= t("dashboard.welcome_back") %></span>
            </div>
            <h1 style="font-family:'Alata',sans-serif;font-size:38px;color:#fff;line-height:1.1;margin:0 0 8px;">
              <%= t("dashboard.heading_html") %>
            </h1>
            <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-lg);color:rgba(255,255,255,0.45);margin:0;max-width:480px;line-height:1.55;">
              <%= t("dashboard.subtitle") %>
            </p>
          </div>

          <% if @surveys.any? %>
            <div style="flex-shrink:0;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <button type="button" data-action="click->create-menu#open"
                    style="display:inline-flex;align-items:center;gap:8px;background:#01EACB;border:none;border-radius:100px;padding:12px 22px;color:#1C2034;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.04em;white-space:nowrap;box-shadow:0 8px 24px rgba(1,234,203,0.28);cursor:pointer;">
                <span style="font-size:18px;line-height:1;">+</span> <%= t("dashboard.create_button") %>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── "+ Create" popup — the one place every creation flow starts. Level 1
        is a chooser (Impact Measurement / Quiz / Form / Template); the Form
        tile slides to level 2, the existing Google-Form import +
        start-from-scratch flow. source=dashboard on the import form tells the
        controller to send errors (and a Connect-Google round trip) back here,
        where the reopen value lands straight in the Form panel. ── %>
    <div data-create-menu-target="modal" class="app-modal hidden">
      <div class="app-modal__backdrop" data-action="click->create-menu#close"></div>
      <div class="app-modal__panel" style="max-width:480px;background:#1C2034;border:1px solid rgba(255,255,255,0.1);">
        <div class="create-menu-bar"></div>

        <%# Level 1 — what do you want to create? %>
        <div data-create-menu-target="chooser" style="padding:24px 26px 24px;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px;">
            <div style="font-family:'Alata',sans-serif;font-size: var(--text-2xs);letter-spacing:0.16em;text-transform:uppercase;font-weight:700;color:#01EACB;"><%= t("dashboard.create_menu_eyebrow") %></div>
            <button type="button" data-action="click->create-menu#close" aria-label="Close"
                    style="background:none;border:none;cursor:pointer;font-size:18px;color:rgba(255,255,255,0.4);line-height:1;padding:2px;flex-shrink:0;">✕</button>
          </div>
          <div style="font-family:'Alata',sans-serif;font-size:20px;color:#fff;line-height:1.25;margin-bottom:16px;"><%= t("dashboard.create_menu_title") %></div>
          <div style="display:flex;flex-direction:column;gap:10px;">
            <%= link_to new_survey_path, class: "create-menu-tile", style: "--tile-accent:#01EACB;" do %>
              <span class="create-menu-tile-icon">📊</span>
              <span style="flex:1;min-width:0;">
                <span class="create-menu-tile-name" style="display:block;"><%= t("dashboard.create_menu_impact") %></span>
                <span class="create-menu-tile-desc" style="display:block;"><%= t("dashboard.create_menu_impact_desc") %></span>
              </span>
              <span class="create-menu-tile-chev" aria-hidden="true">→</span>
            <% end %>
            <%= link_to new_survey_path(quiz: 1), class: "create-menu-tile", style: "--tile-accent:#615BF5;" do %>
              <span class="create-menu-tile-icon">🎯</span>
              <span style="flex:1;min-width:0;">
                <span class="create-menu-tile-name" style="display:block;"><%= t("dashboard.create_menu_quiz") %></span>
                <span class="create-menu-tile-desc" style="display:block;"><%= t("dashboard.create_menu_quiz_desc") %></span>
              </span>
              <span class="create-menu-tile-chev" aria-hidden="true">→</span>
            <% end %>
            <button type="button" data-action="click->create-menu#openForm" class="create-menu-tile" style="--tile-accent:#0CA7FF;">
              <span class="create-menu-tile-icon">▤</span>
              <span style="flex:1;min-width:0;">
                <span class="create-menu-tile-name" style="display:block;"><%= t("dashboard.create_menu_form") %></span>
                <span class="create-menu-tile-desc" style="display:block;"><%= t("dashboard.create_menu_form_desc") %></span>
              </span>
              <span class="create-menu-tile-chev" aria-hidden="true">→</span>
            </button>
            <%= link_to survey_templates_path, class: "create-menu-tile", style: "--tile-accent:#FFFA77;" do %>
              <span class="create-menu-tile-icon">▚</span>
              <span style="flex:1;min-width:0;">
                <span class="create-menu-tile-name" style="display:block;"><%= t("dashboard.create_menu_template") %></span>
                <span class="create-menu-tile-desc" style="display:block;"><%= t("dashboard.create_menu_template_desc") %></span>
              </span>
              <span class="create-menu-tile-chev" aria-hidden="true">→</span>
            <% end %>
          </div>
        </div>

        <%# Level 2 — the Form flow (Google import / create new). %>
        <div data-create-menu-target="formPanel" class="hidden" style="padding:24px 26px 24px;">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px;">
            <div style="display:flex;align-items:center;gap:10px;min-width:0;">
              <button type="button" data-action="click->create-menu#back" aria-label="Back"
                      style="background:none;border:none;cursor:pointer;font-size:16px;color:rgba(255,255,255,0.45);line-height:1;padding:2px;flex-shrink:0;">←</button>
              <div style="font-family:'Alata',sans-serif;font-size:19px;color:#fff;line-height:1.25;"><%= t("dashboard.create_menu_form") %></div>
            </div>
            <button type="button" data-action="click->create-menu#close" aria-label="Close"
                    style="background:none;border:none;cursor:pointer;font-size:18px;color:rgba(255,255,255,0.4);line-height:1;padding:2px;flex-shrink:0;">✕</button>
          </div>
          <p style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);line-height:1.5;margin:0 0 18px;"><%= t("dashboard.import_google_form_modal_subtitle") %></p>

          <% if google_form_error %>
            <div style="background:rgba(255,30,111,0.1);border:1px solid rgba(255,30,111,0.3);border-radius:10px;padding:10px 14px;margin-bottom:14px;color:#FF1E6F;font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);"><%= google_form_error %></div>
          <% end %>

          <% if Current.user&.google_connected? %>
            <%= form_with url: import_google_form_survey_path, method: :post do %>
              <input type="hidden" name="source" value="dashboard" />
              <input type="url" name="google_form_url" required
                     placeholder="<%= t('wizard.import_gform_url_placeholder') %>"
                     data-create-menu-target="urlInput"
                     class="create-menu-input"
                     style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);padding:12px 14px;border-radius:10px;width:100%;box-sizing:border-box;margin-bottom:12px;" />
              <%= submit_tag t("wizard.import_gform_submit"),
                    data: { turbo_submits_with: t("wizard.importing_gform") },
                    style: "width:100%;background:#01EACB;color:#1C2034;border:none;border-radius:100px;padding:12px 20px;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.02em;cursor:pointer;" %>
            <% end %>
          <% else %>
            <%= link_to t("wizard.import_gform_connect"), google_connect_path(return_to: "dashboard_import"),
                  style: "display:flex;justify-content:center;text-decoration:none;background:#01EACB;color:#1C2034;border:none;border-radius:100px;padding:12px 20px;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.02em;" %>
          <% end %>

          <div style="display:flex;align-items:center;gap:10px;margin:18px 0 14px;">
            <div style="flex:1;height:1px;background:rgba(255,255,255,0.12);"></div>
            <span style="font-family:'Alata',sans-serif;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.4);"><%= t("dashboard.or_divider") %></span>
            <div style="flex:1;height:1px;background:rgba(255,255,255,0.12);"></div>
          </div>

          <%= button_to t("dashboard.create_new_form_button"), create_blank_survey_path,
                method: :post,
                data: { turbo_submits_with: t("dashboard.creating_blank") },
                style: "width:100%;background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.18);border-radius:100px;padding:12px 20px;font-family:'Alata',sans-serif;font-size: var(--text-md);letter-spacing:0.02em;cursor:pointer;" %>
        </div>

      </div>
    </div>

    <%# ── Metrics strip ── %>
    <div style="position:relative;padding:24px 36px 28px;border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;max-width:1320px;margin:0 auto;">
        <%
          stats = [
            { value: @surveys.size.to_s,         label: "Vertos",                       accent: "#01EACB", grad: "linear-gradient(135deg,rgba(1,234,203,0.18),rgba(1,234,203,0.04))" },
            { value: published.size.to_s,        label: t("dashboard.stat_live"),        accent: "#FF1E6F", grad: "linear-gradient(135deg,rgba(255,30,111,0.18),rgba(255,30,111,0.04))" },
            { value: drafts.size.to_s,           label: t("dashboard.stat_drafts"),      accent: "#0CA7FF", grad: "linear-gradient(135deg,rgba(12,167,255,0.18),rgba(12,167,255,0.04))" },
            { value: total_responders.to_s,      label: t("dashboard.stat_responders"),  accent: "#615BF5", grad: "linear-gradient(135deg,rgba(97,91,245,0.18),rgba(97,91,245,0.04))" },
            { value: completion_rate ? "#{completion_rate}%" : "—", label: t("dashboard.stat_completion"), accent: "#FFFA77", grad: "linear-gradient(135deg,rgba(255,250,119,0.18),rgba(255,250,119,0.04))" },
          ]
        %>
        <% stats.each do |s| %>
          <div style="background:<%= s[:grad] %>;border:1px solid rgba(255,255,255,0.08);border-radius:18px;padding:18px 16px;text-align:center;backdrop-filter:blur(8px);">
            <div style="font-family:'Alata',sans-serif;font-size:36px;color:<%= s[:accent] %>;line-height:1;letter-spacing:-0.01em;"><%= s[:value] %></div>
            <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-2xs);color:rgba(255,255,255,0.5);margin-top:8px;letter-spacing:0.12em;text-transform:uppercase;"><%= s[:label] %></div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Body ── %>
    <div style="flex:1;padding:32px 36px 60px;max-width:1320px;width:100%;margin:0 auto;box-sizing:border-box;">

      <% if flash[:notice] %>
        <div style="background:rgba(1,234,203,0.1);border:1px solid rgba(1,234,203,0.3);border-radius:10px;padding:11px 16px;margin-bottom:20px;color:#01EACB;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] && !flash[:reopen_google_form_modal] %>
        <div style="background:rgba(216,0,39,0.1);border:1px solid rgba(216,0,39,0.3);border-radius:10px;padding:11px 16px;margin-bottom:20px;color:#FF6B83;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);"><%= flash[:alert] %></div>
      <% end %>

      <% if @surveys.empty? && archived.empty? %>
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 32px;text-align:center;gap:20px;">
          <div>
            <div style="font-family:'Alata',sans-serif;font-size: var(--text-3xl);color:#fff;margin-bottom:8px;"><%= t("dashboard.empty_title") %></div>
            <div style="font-family:'ABeeZee',sans-serif;font-size: var(--text-md);color:rgba(255,255,255,0.4);max-width:320px;line-height:1.6;">
              <%= t("dashboard.empty_body") %>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;">
            <button type="button" data-action="click->create-menu#open"
                  style="padding:12px 26px;border-radius:100px;background:#01EACB;color:#1C2034;border:none;font-family:'ABeeZee',sans-serif;font-size: var(--text-md);cursor:pointer;"><%= t("dashboard.empty_cta") %></button>
          </div>
        </div>

      <% else %>

        <%
          is_admin    = current_membership&.admin?
          select_lbl  = t("dashboard_card.select")
          cancel_lbl  = t("dashboard_card.cancel")
          selected_t  = t("dashboard_card.bulk_selected", count: 0).sub("0", "{count}")
        %>

        <%# ── Live section ── %>
        <% if published.any? %>
          <% archive_confirm_live = t("dashboard_card.bulk_archive_confirm", count: 0).sub("0", "{count}") %>
          <div data-controller="bulk-select"
               data-bulk-select-action-url-value="<%= bulk_archive_surveys_path %>"
               data-bulk-select-confirm-template-value="<%= archive_confirm_live %>"
               data-bulk-select-selected-template-value="<%= selected_t %>"
               data-bulk-select-select-label-value="<%= select_lbl %>"
               data-bulk-select-done-label-value="<%= cancel_lbl %>"
               style="margin-bottom:32px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
              <span style="width:6px;height:6px;border-radius:50%;background:#FF1E6F;box-shadow:0 0 10px rgba(255,30,111,0.7);"></span>
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.5);letter-spacing:0.12em;text-transform:uppercase;"><%= t("dashboard.section_live") %></span>
              <div style="flex:1;height:1px;background:rgba(255,255,255,0.06);"></div>
              <% if is_admin %>
                <button type="button"
                        data-bulk-select-target="toggle"
                        data-action="bulk-select#toggle"
                        style="background:none;border:none;padding:0;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;"><%= select_lbl %></button>
                <span style="color:rgba(255,255,255,0.15);">|</span>
              <% end %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);"><%= published.size %></span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
              <% published.each do |survey| %>
                <%= render "surveys/dashboard_card", survey: survey %>
              <% end %>
            </div>
            <% if is_admin %>
              <div data-bulk-select-target="bar" hidden
                   style="margin-top:14px;display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:14px;background:rgba(255,30,111,0.08);border:1px solid rgba(255,30,111,0.28);">
                <span data-bulk-select-target="count" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);"></span>
                <div style="flex:1;"></div>
                <button type="button" data-action="bulk-select#cancel"
                        style="background:none;border:none;padding:6px 10px;color:rgba(255,255,255,0.55);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);cursor:pointer;"><%= cancel_lbl %></button>
                <button type="button" data-action="bulk-select#submit"
                        style="background:#FF1E6F;border:none;border-radius:100px;padding:8px 18px;color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.04em;cursor:pointer;"><%= t("dashboard_card.delete") %></button>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── Drafts section ── %>
        <% if drafts.any? %>
          <% archive_confirm_draft = t("dashboard_card.bulk_archive_confirm", count: 0).sub("0", "{count}") %>
          <div data-controller="bulk-select"
               data-bulk-select-action-url-value="<%= bulk_archive_surveys_path %>"
               data-bulk-select-confirm-template-value="<%= archive_confirm_draft %>"
               data-bulk-select-selected-template-value="<%= selected_t %>"
               data-bulk-select-select-label-value="<%= select_lbl %>"
               data-bulk-select-done-label-value="<%= cancel_lbl %>"
               style="margin-bottom:32px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
              <span style="width:6px;height:6px;border-radius:50%;background:#0CA7FF;box-shadow:0 0 10px rgba(12,167,255,0.6);"></span>
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.5);letter-spacing:0.12em;text-transform:uppercase;"><%= t("dashboard.section_drafts") %></span>
              <div style="flex:1;height:1px;background:rgba(255,255,255,0.06);"></div>
              <% if is_admin %>
                <button type="button"
                        data-bulk-select-target="toggle"
                        data-action="bulk-select#toggle"
                        style="background:none;border:none;padding:0;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;"><%= select_lbl %></button>
                <span style="color:rgba(255,255,255,0.15);">|</span>
              <% end %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);"><%= drafts.size %></span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
              <% drafts.each do |survey| %>
                <%= render "surveys/dashboard_card", survey: survey %>
              <% end %>
            </div>
            <% if is_admin %>
              <div data-bulk-select-target="bar" hidden
                   style="margin-top:14px;display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:14px;background:rgba(12,167,255,0.08);border:1px solid rgba(12,167,255,0.28);">
                <span data-bulk-select-target="count" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);"></span>
                <div style="flex:1;"></div>
                <button type="button" data-action="bulk-select#cancel"
                        style="background:none;border:none;padding:6px 10px;color:rgba(255,255,255,0.55);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);cursor:pointer;"><%= cancel_lbl %></button>
                <button type="button" data-action="bulk-select#submit"
                        style="background:#0CA7FF;border:none;border-radius:100px;padding:8px 18px;color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.04em;cursor:pointer;"><%= t("dashboard_card.delete") %></button>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── Archived section ── %>
        <% if archived.any? %>
          <% destroy_confirm = t("dashboard_card.bulk_destroy_confirm", count: 0).sub("0", "{count}") %>
          <div data-controller="bulk-select"
               data-bulk-select-action-url-value="<%= bulk_destroy_surveys_path %>"
               data-bulk-select-confirm-template-value="<%= destroy_confirm %>"
               data-bulk-select-selected-template-value="<%= selected_t %>"
               data-bulk-select-select-label-value="<%= select_lbl %>"
               data-bulk-select-done-label-value="<%= cancel_lbl %>">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
              <span style="width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.3);"></span>
              <span style="font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.35);letter-spacing:0.12em;text-transform:uppercase;"><%= t("dashboard.section_archived") %></span>
              <div style="flex:1;height:1px;background:rgba(255,255,255,0.06);"></div>
              <% if is_admin %>
                <button type="button"
                        data-bulk-select-target="toggle"
                        data-action="bulk-select#toggle"
                        style="background:none;border:none;padding:0;font-family:'Alata',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.55);letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;"><%= select_lbl %></button>
                <span style="color:rgba(255,255,255,0.15);">|</span>
              <% end %>
              <span style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.25);"><%= archived.size %></span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
              <% archived.each do |survey| %>
                <%= render "surveys/dashboard_card", survey: survey, archived: true %>
              <% end %>
            </div>
            <% if is_admin %>
              <div data-bulk-select-target="bar" hidden
                   style="margin-top:14px;display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:14px;background:rgba(216,0,39,0.10);border:1px solid rgba(216,0,39,0.32);">
                <span data-bulk-select-target="count" style="font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);color:rgba(255,255,255,0.7);"></span>
                <div style="flex:1;"></div>
                <button type="button" data-action="bulk-select#cancel"
                        style="background:none;border:none;padding:6px 10px;color:rgba(255,255,255,0.55);font-family:'ABeeZee',sans-serif;font-size: var(--text-sm);cursor:pointer;"><%= cancel_lbl %></button>
                <button type="button" data-action="bulk-select#submit"
                        style="background:#D80027;border:none;border-radius:100px;padding:8px 18px;color:#fff;font-family:'Alata',sans-serif;font-size: var(--text-sm);letter-spacing:0.04em;cursor:pointer;"><%= t("dashboard_card.delete_forever") %></button>
              </div>
            <% end %>
          </div>
        <% end %>

      <% end %>
    </div>

  </div>
</div>
