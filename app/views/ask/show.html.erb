<%# Ask Verto.

    Three columns — scope rail, conversation, folder — laid out with the editor's
    own geometry (see .ask-grid in application.css, which mirrors .editor-grid).
    The folder is closed until it's asked for: clicking a citation chip or the
    Sources CTA slides it in over 0.28s and collapses the rail to circles, the
    same trade the editor makes when you select a card.

    Colour carries meaning twice over. A citation takes the accent of the QUESTION
    TYPE it points at (CardTypes.accent — the families results.html.erb already
    paints its card rails with), and a source card additionally carries the
    VERTO's own brand primary on its edge. So you can see both what kind of
    evidence an answer rests on and which studies it came from, without opening
    anything. %>

<%
  # Rail stat tiles and hero tiles share these three accents.
  stats = [
    { key: "vertos",    value: @coverage[:vertos],    accent: "#01EACB" },
    { key: "responses", value: @coverage[:responses], accent: "#615BF5" },
    { key: "countries", value: @coverage[:countries], accent: "#0CA7FF" }
  ]
  # Threads cycle the categorical set the flows editor already uses, so two
  # conversations are never the same colour side by side.
  thread_colours = Survey::FLOW_COLORS
%>

<div class="ask-grid"
     data-controller="ask-verto"
     data-ask-verto-thread-url-value="<%= @thread ? ask_thread_messages_path(@thread) : "" %>"
     data-ask-verto-new-thread-url-value="<%= ask_threads_path %>"
     <%# The last answer's sources, so a reloaded page can open its folder with
         everything the live stream had — icon, brand, counts and all. Scraping
         the chips instead would only recover what a chip carries, which is the
         accent and nothing else. %>
     data-ask-verto-sources-value="<%= (@messages.reverse.find(&:assistant?)&.citation_list || []).to_json %>"
     data-ask-verto-target="grid">

  <%# The backdrop the floating panel floats on — the app's own orbs, pitched
      between the results screen's restraint and the generating screen's full
      brightness. %>
  <div class="gen-orbs ask-orbs" aria-hidden="true">
    <div class="gen-orb gen-orb-1"></div>
    <div class="gen-orb gen-orb-2"></div>
    <div class="gen-orb gen-orb-3"></div>
    <div class="gen-orb gen-orb-4"></div>
  </div>

  <%# ── Scope rail ── %>
  <div class="ask-rail">
    <div class="ask-rail-head">
      <div class="ask-rail-brand">
        <span class="ask-rail-mark">✦</span>
        <span><%= t("ask.page.title") %></span>
      </div>
    </div>

    <%# Shown only while the panel is open, in place of everything below. %>
    <div class="ask-rail-mini" aria-hidden="true">
      <% stats.first(2).each do |stat| %>
        <span class="ask-rail-mini-btn" style="--stat-accent:<%= stat[:accent] %>;"><%= number_to_human(stat[:value], format: "%n%u", units: { thousand: "k", million: "M" }) %></span>
      <% end %>
      <button type="button" class="ask-rail-mini-btn" style="--stat-accent:#8B85FF;"
              data-action="click->ask-verto#closePanel"
              title="<%= t("js.ask.close") %>">≡</button>
    </div>

    <div class="ask-rail-sec"><%= t("ask.page.scope") %></div>
    <% stats.each do |stat| %>
      <div class="ask-stat" style="--stat-accent:<%= stat[:accent] %>;">
        <span class="ask-stat-dot"></span>
        <span class="ask-stat-num"><%= number_with_delimiter(stat[:value]) %></span>
        <span class="ask-stat-label"><%= t("js.ask.stat_#{stat[:key]}") %></span>
      </div>
    <% end %>

    <div class="ask-rail-sec"><%= t("ask.page.threads") %></div>
    <%= form_with url: ask_threads_path, method: :post, local: true, style: "margin:0;" do %>
      <button type="submit" class="ask-thread ask-thread-new">
        <span class="ask-thread-dot" style="background:#01EACB;"></span>
        <span class="ask-thread-label">+ <%= t("ask.page.new_thread") %></span>
      </button>
    <% end %>
    <% @threads.each_with_index do |thread, i| %>
      <%= link_to ask_path(thread_id: thread.id),
            class: "ask-thread #{"is-current" if @thread && thread.id == @thread.id}",
            style: "--thread-accent:#{thread_colours[i % thread_colours.size]};" do %>
        <span class="ask-thread-dot"></span>
        <span class="ask-thread-label"><%= thread.display_title %></span>
      <% end %>
    <% end %>

    <div class="ask-rail-foot"><%= t("ask.page.eligible") %></div>
  </div>

  <%# ── Conversation ── %>
  <div class="ask-main">
    <div class="ask-top">
      <span class="lab"><%= t("ask.page.title") %></span>
      <span style="color:rgba(255,255,255,0.2);">·</span>
      <span class="nm"><%= @thread ? @thread.display_title : t("ask.page.subtitle") %></span>
    </div>

    <div class="ask-feed" data-ask-verto-target="feed">

      <%# Floating scope pills. Only rendered when a filter is actually set —
          an empty pill row would advertise a control that does nothing. %>
      <% if @thread&.scope.present? %>
        <div class="ask-scope-pills">
          <% @thread.scope.each_with_index do |(_key, value), i| %>
            <span class="ask-scope-pill" style="--pill-accent:<%= thread_colours[i % thread_colours.size] %>;">
              <span class="ask-scope-pill-dot"></span><%= value %>
            </span>
          <% end %>
        </div>
      <% end %>

      <div class="ask-conv" data-ask-verto-target="messages">
        <% if @messages.empty? %>
          <%# ── The cold start ──
              The screen's one designed moment. Suggestions are built from what
              the corpus actually holds (CorpusTools#suggestions), so a chip
              never opens onto "I don't have data on that". %>
          <div class="ask-hero" data-ask-verto-target="hero">
            <div class="ask-hero-eyebrow gen-shimmer--brand"><%= t("js.ask.hero_eyebrow") %></div>
            <h1 class="ask-hero-title"><%= @coverage[:vertos].zero? ? t("ask.page.title") : t("js.ask.hero_title") %></h1>
            <p class="ask-hero-body">
              <%= @coverage[:vertos].zero? ? t("js.ask.empty_corpus") : t("js.ask.hero_body") %>
            </p>

            <% if @coverage[:vertos].positive? %>
              <div class="ask-hero-stats">
                <% stats.each do |stat| %>
                  <div class="ask-hero-stat" style="--stat-accent:<%= stat[:accent] %>;">
                    <span class="ask-hero-stat-num"><%= number_with_delimiter(stat[:value]) %></span>
                    <span class="ask-hero-stat-label"><%= t("js.ask.stat_#{stat[:key]}") %></span>
                  </div>
                <% end %>
              </div>

              <div class="ask-suggests">
                <% @suggestions.each_with_index do |suggestion, i| %>
                  <button type="button" class="ask-suggest"
                          style="--tile-accent:<%= suggestion[:accent] %>;--i:<%= i %>;"
                          data-question="<%= suggestion[:question] %>"
                          data-action="click->ask-verto#askSuggestion">
                    <span class="ask-suggest-icon"><%= suggestion[:icon] %></span>
                    <span class="ask-suggest-body">
                      <span class="ask-suggest-q"><%= suggestion[:question] %></span>
                      <span class="ask-suggest-meta"><%= suggestion[:meta] %></span>
                    </span>
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <%# Replayed from the database, markers resolved server-side so a
              reloaded conversation reads exactly as it did when it was written. %>
          <% @messages.each do |message| %>
            <% if message.user? %>
              <div class="ask-msg-user"><div class="b"><%= message.text %></div></div>
            <% else %>
              <div class="ask-msg-ai">
                <span class="ask-ai-mark">✦</span>
                <div class="ask-ai-body"><%= render_ask_answer(message) %></div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%# Floating CTAs — no docked chrome on this column at all. %>
      <div class="ask-fab-row">
        <div class="ask-composer">
          <textarea data-ask-verto-target="input"
                    data-action="keydown->ask-verto#keydown input->ask-verto#autogrow"
                    rows="1"
                    placeholder="<%= t("js.ask.placeholder") %>"
                    aria-label="<%= t("js.ask.placeholder") %>"></textarea>
          <button type="button" class="ask-send"
                  data-ask-verto-target="send"
                  data-action="click->ask-verto#send"
                  aria-label="<%= t("js.ask.send") %>">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7h12M7 1l6 6-6 6" stroke="#04221E" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <button type="button" class="ask-fab ask-fab-sources"
                data-ask-verto-target="sourcesFab"
                data-action="click->ask-verto#openSources">
          <span class="ask-fab-dots" data-ask-verto-target="fabDots"></span>
          <%= t("js.ask.sources") %> <span class="n" data-ask-verto-target="sourceCount">0</span>
        </button>
      </div>
    </div>
  </div>

  <%# ── The folder ── %>
  <div class="ask-panel">
    <div class="ask-tabs" role="tablist">
      <button type="button" class="ask-tab ask-tab--sources is-active" role="tab" aria-selected="true"
              data-ask-verto-target="tab" data-pane="sources"
              data-action="click->ask-verto#showPane">
        <%= t("js.ask.sources") %> <span class="n" data-ask-verto-target="tabCount">0</span>
      </button>
      <button type="button" class="ask-tab ask-tab--detail" role="tab" aria-selected="false"
              data-ask-verto-target="tab" data-pane="detail"
              data-action="click->ask-verto#showPane"><%= t("js.ask.detail") %></button>
      <button type="button" class="ask-tab ask-tab--consent" role="tab" aria-selected="false"
              data-ask-verto-target="tab" data-pane="consent"
              data-action="click->ask-verto#showPane"><%= t("js.ask.why_citable") %></button>
      <button type="button" class="ask-tab-close"
              data-action="click->ask-verto#closePanel"
              aria-label="<%= t("js.ask.close") %>">✕</button>
    </div>

    <div class="ask-paper ask-paper--sources is-active" role="tabpanel"
         data-ask-verto-target="pane" data-pane="sources">
      <div class="ask-paper-head">
        <div class="t"><%= t("js.ask.sources") %></div>
        <p><%= t("ask.page.eligible") %></p>
      </div>
      <div class="ask-paper-body" data-ask-verto-target="sourceList">
        <p class="ask-empty"><%= t("js.ask.no_sources") %></p>
      </div>
    </div>

    <div class="ask-paper ask-paper--detail" role="tabpanel"
         data-ask-verto-target="pane" data-pane="detail">
      <div class="ask-paper-head">
        <div class="t" data-ask-verto-target="detailTitle"><%= t("js.ask.detail") %></div>
      </div>
      <div class="ask-paper-body" data-ask-verto-target="detailBody">
        <p class="ask-empty"><%= t("js.ask.no_sources") %></p>
      </div>
    </div>

    <div class="ask-paper ask-paper--consent" role="tabpanel"
         data-ask-verto-target="pane" data-pane="consent">
      <div class="ask-paper-head">
        <div class="t"><%= t("js.ask.why_citable") %></div>
      </div>
      <div class="ask-paper-body" data-ask-verto-target="consentBody">
        <p class="ask-empty"><%= t("js.ask.no_sources") %></p>
      </div>
    </div>
  </div>
</div>
