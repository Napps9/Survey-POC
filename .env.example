ANTHROPIC_API_KEY=

# ── Error tracking (optional in dev, recommended in prod) ────
# Sentry. Data residency (EU/Frankfurt) is chosen once when the Sentry
# ORGANISATION is created, not here — see docs/DEPLOYMENT_RUNBOOK.md before
# generating a DSN. Leave unset to skip Sentry entirely; errors still reach
# the normal logs either way (config/initializers/sentry.rb).
SENTRY_DSN=

# ── Pexels stock photos (optional) ───────────────────────
# Enables Pexels as the primary image source for the AssetPopulator (Verto
# auto-populate + Shuffle) and the editor media picker's live search. When
# unset the app falls back to the curated app/assets/images/verto-library/
# assets, so dev/test/CI need no key. Either name works (PEXELS is what Render
# is configured with). Get a key at https://www.pexels.com/api/.
PEXELS=

# ── Location search geocoding (optional in dev, needed in prod) ──
# The "Where do you live?" demographic searches place names via OpenStreetMap.
# The public Nominatim server returns HTTP 403 for server-side calls from
# datacenter IPs (e.g. Render), so location search silently returns nothing in
# production. Set a LocationIQ key — a hosted Nominatim with an identical API
# that permits server-side use — to fix it. Free tier at https://locationiq.com.
# Region is us1 (default) or eu1. Unset → falls back to public Nominatim, which
# is fine for local dev.
# LOCATIONIQ_API_KEY=
# LOCATIONIQ_REGION=us1

# ── Claude model selection (optional) ────────────────────
# Override which model each tier uses without a code change. DEFAULT is used for
# high-stakes generation (full survey design, PDF import); FAST (cheaper Haiku)
# for well-constrained / conversational tasks (single question, translation,
# results summary + chat). Leave unset to use the built-in defaults.
# CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ── Social sign-in with Google ───────────────────────────
# The "Continue with Google" buttons appear only when GOOGLE_CLIENT_ID/SECRET
# (below) are set — one OAuth client serves sign-in and the Sheets export.
#
# FOUR redirect URIs, because there are TWO strategies. Creators sign in as a
# User; respondents sign in as a Player at the end of a Verto, and those are
# different tables behind different cookies. The same Google client is mounted
# twice under different names so each population comes back to its own path —
# which is what makes "may this callback create a creator account?" a question
# the redirect_uri answers rather than a flag in a session. Miss the
# google_player pair and respondent sign-in fails with redirect_uri_mismatch
# while creator sign-in keeps working, so add all four:
#   http://localhost:3000/auth/google_oauth2/callback   (dev, creators)
#   https://<APP_HOST>/auth/google_oauth2/callback      (prod, creators)
#   http://localhost:3000/auth/google_player/callback   (dev, respondents)
#   https://<APP_HOST>/auth/google_player/callback      (prod, respondents)

# ── Google Sheets export (per-user OAuth) ────────────────
# Lets users export a Verto's results into a spreadsheet in their own Drive.
# In Google Cloud Console: create a project → enable the "Google Sheets API" →
# create an OAuth 2.0 Client ID (type "Web application") → under "Authorized
# redirect URIs" add the callback for each environment:
#   http://localhost:3000/google/callback   (dev)
#   https://<APP_HOST>/google/callback       (prod)
# On the OAuth consent screen (External / Testing) add yourself as a test user;
# the drive.file scope needs no Google verification while in Testing.
# When these are unset, the "Connect to Google Sheets" button is hidden.
#
# The SAME OAuth client also powers "Import from Google Form" — no extra
# credential. For that path additionally: enable the "Google Forms API" in the
# project and add the scope https://www.googleapis.com/auth/forms.body.readonly
# on the consent screen. Anyone connected before this was added re-consents once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Active Record Encryption keys — encrypt the stored Google tokens at rest.
# Generate with: bin/rails db:encryption:init  (then paste the values here).
# Required in production; dev/test fall back to built-in disposable keys.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Email (password reset, invites) ──────────────────────
# Set these to enable outbound email. Any free SMTP provider works.
#
# Brevo  (300/day free)  — smtp-relay.brevo.com : 587  | user = login email | pass = SMTP key
# SendGrid (100/day)     — smtp.sendgrid.net    : 587  | user = "apikey"    | pass = API key
# Resend  (3,000/month)  — smtp.resend.com      : 465  | user = "resend"    | pass = API key   (SMTP_TLS=true)
# Mailtrap (sandbox)     — sandbox.smtp.mailtrap.io : 2525
# Gmail SMTP (low cap)   — smtp.gmail.com       : 587  | user = address     | pass = app password
#
# Without these, mail falls back to Rails defaults (dev logs to stdout).
#
# 🛡️  Deliverability tip: to keep reset emails out of spam, use SendGrid's
# *Domain Authentication* (Settings → Sender Authentication → Authenticate
# Your Domain) instead of *Single Sender Verification*. Domain Auth adds
# SPF + DKIM DNS records on your sending domain, which is what spam filters
# look for. Single Sender works for testing but lands in junk most of the time.
MAIL_FROM="Playverto <no-reply@example.com>"
MAIL_REPLY_TO=hello@example.com
APP_HOST=
APP_PROTOCOL=https
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
SMTP_TLS=false

# ── Internal BI (Blazer) + Ask Verto review ──────────────
# Read-only SQL dashboards for VertoNow staff at /blazer (usage + collected
# data across all orgs), and the Ask Verto review queue at /ask/review — the
# staff half of the corpus consent gate. DENY-BY-DEFAULT: only the comma/
# space-separated emails below can reach either; when unset, nobody can —
# which for Ask Verto means no offered Verto can ever be approved through the
# app. Use the same email a staff member signs into the app with.
BLAZER_STAFF_EMAILS=
# Optional: point Blazer at a read replica instead of the primary database.
# Defaults to the app's DATABASE_URL (prod) / app connection (dev) when unset.
BLAZER_DATABASE_URL=

# ── AI spend guards ──────────────────────────────────────
# Claude calls one organisation may make per UTC day, across every AI endpoint
# (deck generation, imports, per-card generate/optimise, image moderation).
# Rate limits are per user and set in the controllers; this is the ceiling that
# shows up on the invoice. 0 disables the cap. See ThrottlesAiSpend.
AI_DAILY_GENERATION_CAP=300

# Maximum outbound geocoder requests per second, app-wide (SharedRateLimiter,
# P1-11). Nominatim's public policy is an absolute 1/second; LocationIQ's free
# tier is 2/second. Defaults to 1 — the stricter of the two — because the
# consequence of breaching it is an IP ban that takes location search down for
# everyone. Raise it to match the plan you're actually on. Over budget, a
# search returns no suggestions rather than blocking a request thread.
GEOCODE_MAX_RPS=1

# ── Traffic alerting ─────────────────────────────────────
# Who hears when respondent traffic climbs (TrafficAlertJob, every 15 minutes).
# Comma/space-separated; EMPTY DISABLES THE JOB ENTIRELY. This is the only
# signal that says "something is happening" — Sentry and an uptime monitor
# both only say "something is broken" — and it matters because the persistent
# disk pins the web service to one instance, so a wave of social traffic needs
# a person to scale it up by hand.
TRAFFIC_ALERT_EMAILS=
# Responses per minute, app-wide, that triggers the email. Default 10, which
# is far above an ordinary day and a small fraction of the measured ceiling —
# it fires early on purpose, to buy reaction time.
TRAFFIC_ALERT_PER_MINUTE=10

# ── Respondent rate limiting ─────────────────────────────
# Three multipliers on the per-IP caps in PlayerController, all defaulting to 1
# (i.e. off). They are separate on purpose — see the comments above the
# declarations — because they say different things, and folding them together
# would mean every load run quietly raising the account cap too.
#
# Multiplies the answering path: submit, progress/grade, consent, and the
# aggregate reads. Recall and eligibility are deliberately NOT scaled — they
# are code-guessing oracles bounded for privacy, and a bigger room is never a
# reason to allow more guesses. Set it when a real crowd is behind one NAT address
# — a venue event — or for a load test whose whole burst arrives from a
# handful of runner IPs. Read once AT BOOT, so changing it costs a restart:
# set it before the doors open, not during.
PLAYER_RATE_LIMIT_SCALE=1
# Multiplies the account-creation path, per IP only: join_ip, join_google_ip
# and MAX_JOIN_ADDRESSES_PER_IP. The address-keyed limits stay flat whatever
# this is, because a bigger crowd is not a reason to let one account be ground
# at harder. At 1, one IP may create 10 accounts per 5 minutes and 30 distinct
# addresses per hour — which is thirty people, so a room of 250 needs this set
# or ~220 of them silently fail to get an account (the per-IP refusal renders
# as a success). Also read at boot.
#
# Covers BOTH halves of the join journey. PlayerController#join only mints a
# sign-in link and hands back its path; the account actually begins at
# PlayerSignInsController#create, one navigation later, which carries its own
# per-IP cap of 20 per 5 minutes. Scaling the first half alone left a crowd
# clearing a 250-per-5-minutes gate and hitting a 20-per-5-minutes one seconds
# afterwards, so both read this variable and a test pins them together.
PLAYER_JOIN_RATE_LIMIT_SCALE=1
# Multiplies the "Where do you live?" type-ahead, per IP. Separate from the
# answering scale because it counts REQUESTS while the thing worth protecting
# is outbound API CALLS, and those stopped being the same number once
# NominatimClient started reading its day-long cache BEFORE checking the
# outbound budget — a repeated search term costs the provider nothing. A
# rate_limit is a before_action, so without this those free lookups are refused
# anyway once the minute is spent. At 1, one IP gets 30 searches a minute; a
# room of 250 each typing a city makes roughly 250. GEOCODE_MAX_RPS above is
# untouched and still bounds what actually reaches the provider.
#
# A refusal is invisible, which is why this matters: the 429 body carries no
# `results` key, so the type-ahead clears its list and the respondent sees a
# search box that simply never suggests anything. Picking a suggestion is the
# only thing that records an answer, so they record no location at all.
PLAYER_LOCATION_RATE_LIMIT_SCALE=1
